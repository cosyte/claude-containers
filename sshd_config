# Hardened sshd for the Claude Code container.
# Host keys live on a persisted named volume so the fingerprint is stable
# across image rebuilds (the entrypoint generates them there on first boot).
HostKey /etc/ssh/host-keys/ssh_host_ed25519_key
HostKey /etc/ssh/host-keys/ssh_host_rsa_key

Port 22
AddressFamily any

# Key-based auth only. Authorized keys are mounted read-only from the host
# and installed by the entrypoint.
PubkeyAuthentication yes
# The git key is never a login key: the entrypoint (§4) writes its public half here on every
# boot (an empty file without one), and sshd refuses every key listed whatever any
# authorized_keys file says. Root-owned: the agent cannot edit it. sshd refuses ALL public-key
# logins when it cannot read this file, so the image also bakes an empty one.
RevokedKeys /etc/ssh/revoked_keys
PasswordAuthentication no
PermitEmptyPasswords no
# Required: the `claude` user inherits a locked password from the base image
# (normal for a key-only service account). With `UsePAM no`, sshd rejects
# locked-password accounts as "invalid user" even for pubkey auth. PAM account
# management permits key login for a passwordless account; password auth stays
# disabled above.
UsePAM yes
ChallengeResponseAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
AllowUsers claude

X11Forwarding no
AllowTcpForwarding yes
PrintMotd no
AcceptEnv LANG LC_*
ClientAliveInterval 30
ClientAliveCountMax 1000000
LoginGraceTime 30
MaxAuthTries 4

Subsystem sftp internal-sftp
