#!/usr/bin/env bash
# claude-fleet-view — read-only fleet observability dashboard (CC-7).
#
# Aggregates three things so the umbrella's K-ramp decision is data-backed, without ever
# touching anything but read-only docker/proc/df queries:
#   1. the active claude.worker=1 containers (item/repo/name/status)
#   2. each active item's spend, read from the secret-free sidecar meta files
#      bin/claude-worker-run writes (run-<item>-<ts>.meta.json)
#   3. host cpu/mem/disk headroom against the K-derived controller envelope
#      (bin/_common.sh's resolve_parallel_k + controller_envelope — reused, not reinvented)
#
# Usage:
#   claude-fleet-view          human table: workers, then a host-headroom summary line
#   claude-fleet-view --json   the same data as one JSON object — feeds the umbrella's
#                              scripts/run-log-report.sh --concurrent
#
# Fail-safe: a missing/unparseable reading (no docker, no meta file, an unreadable
# /proc/meminfo, ...) degrades that ONE field to "unknown" (JSON: null) — it never blocks
# or errors the command. Only a bad flag exits non-zero (usage).
#
# Secret-free: only ever prints item/repo/container-name/status/cost/resource numbers —
# never env, tokens, keys, or raw file contents.
#
# Test seams (unit tests only):
#   CLAUDE_FLEET_DOCKER          the docker binary to invoke (default: docker) — point at
#                                 a fake script to test without a real daemon
#   CLAUDE_WORKER_RUN_LOG_DIR    where the per-run meta sidecars live (shared with
#                                 bin/claude-worker-run; same default $HOME/.claude/worker-run-logs)
#   CLAUDE_FLEET_HOST_CPUS       override host CPU count (default: nproc)
#   CLAUDE_FLEET_HOST_MEM_MIB    override host mem MiB   (default: /proc/meminfo MemTotal)
#   CLAUDE_DISK_FREE_MIB_OVERRIDE / CLAUDE_PARALLEL_CONFIG   — same seams as bin/_common.sh
#
# Sourcing this file defines the fleet_* functions and returns (the unit-test seam);
# executing it renders the dashboard.
set -euo pipefail

# Fail-safe (CC-7): this is a READ-ONLY view and must never exit non-zero on a misconfigured
# environment. bin/_common.sh derives memory reservations AT SOURCE TIME and `die`s (exit 1) on a
# size string it can't parse (e.g. a "4gb" typo — size_to_mib only accepts single-letter b/k/m/g
# units). For the launcher/broker that hard refusal is correct; for this observability tool it is
# not. Neutralize a malformed size-shaped var to its safe default (with a stderr note) BEFORE
# sourcing, leaving _common.sh's fail-closed posture intact for every other caller (each of these
# has a `${VAR:-<default>}` fallback in _common.sh, so unsetting is safe).
for _v in CLAUDE_MEM_LIMIT CLAUDE_MEM_RESERVATION CLAUDE_WORKER_MEM CLAUDE_WORKER_MEM_RESERVATION; do
    _val="${!_v:-}"
    if [[ -n "$_val" && ! "$_val" =~ ^[0-9]+[bkmgBKMG]?$ ]]; then
        echo "claude-fleet-view: ignoring malformed $_v='$_val' (read-only view stays fail-safe)" >&2
        unset "$_v"
    fi
done
unset _v _val
# The malformed size can ALSO arrive via the repo-root .env that _common.sh sources INTERNALLY,
# one step after this process-env scrub — which the loop above can't reach. But _common.sh only
# parses the *limit* vars at source time to DERIVE the *reservation* vars, and it SKIPS that
# derivation (the sole source-time die) when the reservation is already set. So pre-seed the two
# reservations: the derivation is then skipped no matter what limit value .env carries, closing the
# .env vector too. .env sets limits, not reservations, so this seed survives .env being re-sourced;
# and the launcher/broker source _common.sh in their OWN process WITHOUT this seed, so they keep
# deriving reservations correctly — this read-only view never launches a container, so a seeded
# reservation is inert here (fleet_host_headroom shows CTRL_CPUS/CTRL_MEM_MIB, not the reservation).
CLAUDE_MEM_RESERVATION="${CLAUDE_MEM_RESERVATION:-3072m}"
CLAUDE_WORKER_MEM_RESERVATION="${CLAUDE_WORKER_MEM_RESERVATION:-3072m}"
export CLAUDE_MEM_RESERVATION CLAUDE_WORKER_MEM_RESERVATION

source "$(dirname "${BASH_SOURCE[0]}")/_common.sh"

# --- 1. active workers: the ONLY docker-touching function -----------------------------------
# Prints one TSV row per active claude.worker=1 container: name, item, repo, status. Empty
# (no rows) when none are running or docker itself is unavailable — never dies here, the
# caller renders an explicit "no active workers" line instead.
fleet_list_workers() {
    local docker_bin="${CLAUDE_FLEET_DOCKER:-docker}"
    command -v "$docker_bin" >/dev/null 2>&1 || return 0
    "$docker_bin" ps --filter 'label=claude.worker=1' \
        --format '{{.Names}}	{{.Label "claude.item"}}	{{.Label "claude.repo"}}	{{.Status}}' 2>/dev/null || true
}

# --- 2. per-item spend: newest meta sidecar, fail-safe to "unknown" -------------------------
# fleet_worker_spend <item> — print the total_cost_usd of the NEWEST (by filename, which
# embeds the run timestamp) run-<item>-*.meta.json for <item>, or the literal string
# "unknown" if no file exists, the file is unreadable, or the field is missing/unparseable.
# Never errors — a missing telemetry file must degrade, not block, the view.
fleet_worker_spend() {
    local item="$1"
    local log_dir="${CLAUDE_WORKER_RUN_LOG_DIR:-$HOME/.claude/worker-run-logs}"
    local newest="" f rest name ts
    local ts_re='[0-9]{8}T[0-9]{6}Z'   # the %Y%m%dT%H%M%SZ stamp claude-worker-run writes
    # Sort lexically: the ts format sorts newest-last, same trick bin/claude-worker-run relies on.
    # EXACT-ITEM guard: the glob run-<item>-*.meta.json ALSO matches a dash-suffixed SIBLING id
    # (querying `CC-4` would otherwise match `run-CC-4-RESIDUAL-<ts>.meta.json` — real ids in this
    # backlog — and mis-attribute that sibling's spend). Accept ONLY a name that decomposes to
    # exactly run-<item>-<ts>.meta.json: strip the run-/.meta.json wrapper, split off the last
    # dash-segment as the ts, and require the remainder to equal <item> AND the ts to be a real stamp.
    while IFS= read -r f; do
        [[ -n "$f" ]] || continue
        rest="${f#run-}"; rest="${rest%.meta.json}"   # "<item>-<ts>"
        name="${rest%-*}"; ts="${rest##*-}"           # split on the LAST dash
        [[ "$name" == "$item" && "$ts" =~ ^${ts_re}$ ]] || continue
        newest="$f"
    done < <(cd "$log_dir" 2>/dev/null && ls -1 -- "run-$item-"*.meta.json 2>/dev/null | sort || true)
    if [[ -z "$newest" ]]; then
        echo unknown
        return 0
    fi
    local path="$log_dir/$newest" spend=""
    if command -v jq >/dev/null 2>&1; then
        spend="$(jq -r '.total_cost_usd // empty' "$path" 2>/dev/null || true)"
    else
        # No jq: grep/sed fallback (same idiom as resolve_parallel_k in bin/_common.sh) —
        # capture the whole value token so a malformed number refuses cleanly to "unknown"
        # rather than being silently truncated.
        spend="$(grep -oE '"total_cost_usd"[[:space:]]*:[[:space:]]*[^,}[:space:]]+' "$path" 2>/dev/null \
            | head -1 | sed 's/^"total_cost_usd"[[:space:]]*:[[:space:]]*//' || true)"
    fi
    if [[ "$spend" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        echo "$spend"
    else
        echo unknown
    fi
}

# --- 3. host headroom: cpu/mem/disk vs the K-derived controller envelope --------------------
# Prints one line: "<cpus> <mem_mib> <disk_free_mib> <k> <budget_cpus> <budget_mem_mib>".
# Any single reading that fails is reported as the literal "unknown" for that field —
# fail-safe, never aborts the rest.
fleet_host_headroom() {
    local cpus mem_mib disk_mib k budget_cpus budget_mem_mib

    cpus="${CLAUDE_FLEET_HOST_CPUS:-}"
    if [[ -z "$cpus" ]]; then
        cpus="$(nproc 2>/dev/null || true)"
    fi
    [[ "$cpus" =~ ^[0-9]+$ ]] || cpus=unknown

    mem_mib="${CLAUDE_FLEET_HOST_MEM_MIB:-}"
    if [[ -z "$mem_mib" ]]; then
        mem_mib="$(awk '/^MemTotal:/{print int($2/1024)}' /proc/meminfo 2>/dev/null || true)"
    fi
    [[ "$mem_mib" =~ ^[0-9]+$ ]] || mem_mib=unknown

    disk_mib="$(disk_free_mib "${CLAUDE_DISK_DATA_ROOT:-/var/lib/docker}" 2>/dev/null || true)"
    [[ "$disk_mib" =~ ^[0-9]+$ ]] || disk_mib=unknown

    # resolve_parallel_k / controller_envelope (bin/_common.sh) DIE (hard `exit`, not
    # `return`) on a garbage config/profile — a bash `-e` gotcha: `exit` inside
    # `$(cmd || true)` still tears down the outer shell, because `exit` bypasses the
    # `||`/`if` machinery entirely (those only catch a nonzero RETURN). The fix is to
    # keep both die-capable calls inside their OWN command substitution, with the
    # `|| true`/`|| k=""` sitting OUTSIDE it, so a malformed
    # operations/parallel.config.json or worker-mem profile degrades this ONE field to
    # "unknown" rather than killing the whole fleet view.
    k="$(resolve_parallel_k 2>/dev/null)" || k=""
    budget_cpus=unknown budget_mem_mib=unknown
    if [[ "$k" =~ ^[0-9]+$ ]]; then
        local envelope
        envelope="$(controller_envelope "$k" 2>/dev/null && printf '%s %s' "$CTRL_CPUS" "$CTRL_MEM_MIB")" || envelope=""
        if [[ -n "$envelope" ]]; then
            read -r budget_cpus budget_mem_mib <<<"$envelope"
        else
            k=unknown
        fi
    else
        k=unknown
    fi

    echo "$cpus $mem_mib $disk_mib $k $budget_cpus $budget_mem_mib"
}

# --- rendering: human table --------------------------------------------------------------------
fleet_render_table() {
    local rows="$1" header="ITEM	REPO	WORKER	STATUS	SPEND" body="" line name item repo status spend cell

    if [[ -z "$rows" ]]; then
        info "no active workers"
    else
        while IFS=$'\t' read -r name item repo status; do
            [[ -n "$name" ]] || continue
            spend="$(fleet_worker_spend "${item:-unknown}")"
            # Branch on the value so an unknown spend renders "unknown" and a real cost renders
            # "$<n>" — collision-proof, unlike a global string substitution over the whole body.
            if [[ "$spend" == unknown ]]; then cell="unknown"; else cell="\$${spend}"; fi
            body+="${item:-unknown}	${repo:-unknown}	$name	${status:-unknown}	${cell}"$'\n'
        done <<<"$rows"
        local table
        table="$(printf '%s\n%s' "$header" "$body")"
        if command -v column >/dev/null 2>&1; then
            echo "$table" | column -t -s $'\t'
        else
            echo "$table" | awk -F'\t' '
                { line[NR]=$0
                  for (i=1;i<=NF;i++) if (length($i)>w[i]) w[i]=length($i)
                  if (NF>nf) nf=NF }
                END {
                  for (r=1;r<=NR;r++) {
                    split(line[r], c, "\t"); out=""
                    for (i=1;i<=nf;i++) out=out sprintf("%-*s", (i<nf?w[i]+2:0), c[i])
                    print out
                  }
                }'
        fi
    fi

    echo
    line="$(fleet_host_headroom)"
    read -r hc hm hd hk hbc hbm <<<"$line"
    info "host headroom: cpus $hc · mem ${hm} MiB · disk free ${hd} MiB   (K=$hk budget: cpus $hbc · mem ${hbm} MiB)"
}

# --- rendering: --json ---------------------------------------------------------------------
# num_or_null <token> — a bare number, or JSON null for "unknown"/anything unparseable.
fleet_json_num() {
    [[ "$1" =~ ^[0-9]+(\.[0-9]+)?$ ]] && printf '%s' "$1" || printf 'null'
}

fleet_render_json() {
    local rows="$1" line name item repo status spend first=1 workers_json=""

    if [[ -n "$rows" ]]; then
        while IFS=$'\t' read -r name item repo status; do
            [[ -n "$name" ]] || continue
            spend="$(fleet_worker_spend "${item:-unknown}")"
            (( first )) || workers_json+=","
            first=0
            workers_json+="$(printf '{"item":%s,"repo":%s,"name":%s,"status":%s,"total_cost_usd":%s}' \
                "$(fleet_json_str "${item:-unknown}")" \
                "$(fleet_json_str "${repo:-unknown}")" \
                "$(fleet_json_str "$name")" \
                "$(fleet_json_str "${status:-unknown}")" \
                "$(fleet_json_num "$spend")")"
        done <<<"$rows"
    fi

    line="$(fleet_host_headroom)"
    read -r hc hm hd hk hbc hbm <<<"$line"

    printf '{"workers":[%s],"host":{"cpus":%s,"mem_mib":%s,"disk_free_mib":%s,"k":%s,"budget_cpus":%s,"budget_mem_mib":%s}}\n' \
        "$workers_json" \
        "$(fleet_json_num "$hc")" "$(fleet_json_num "$hm")" "$(fleet_json_num "$hd")" \
        "$(fleet_json_num "$hk")" "$(fleet_json_num "$hbc")" "$(fleet_json_num "$hbm")"
}

# fleet_json_str <s> — minimal JSON string quoting. Item/repo/container-name values are
# already constrained to the strict charset ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ elsewhere in
# this fleet (broker/worker-run validation) and docker Status strings never carry quotes in
# practice, but escape backslash/quote/control chars anyway — never trust an external field
# (docker label, a status string) to already be JSON-safe.
fleet_json_str() {
    local s="$1" out="" i c
    s="${s//\\/\\\\}"     # backslash first
    s="${s//\"/\\\"}"     # then the quote
    # C0 control chars (< 0x20) are NOT JSON-safe raw (RFC 8259) — a literal tab/newline folded
    # into an unvalidated docker Status/Names field would make --json unparseable. Escape the
    # common ones to short forms and any remaining control char to \uXXXX.
    for (( i=0; i<${#s}; i++ )); do
        c="${s:i:1}"
        case "$c" in
            $'\t') out+='\t' ;;
            $'\n') out+='\n' ;;
            $'\r') out+='\r' ;;
            [$'\x01'-$'\x1f']) printf -v c '\\u%04x' "'$c"; out+="$c" ;;
            *) out+="$c" ;;
        esac
    done
    printf '"%s"' "$out"
}

# --- main -------------------------------------------------------------------------------------
fleet_usage() {
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

fleet_main() {
    local mode=table
    local a
    for a in "$@"; do
        case "$a" in
            --json)     mode=json ;;
            -h|--help)  fleet_usage 0 ;;
            *)          fleet_usage 1 ;;
        esac
    done

    local rows
    rows="$(fleet_list_workers)"

    case "$mode" in
        json)  fleet_render_json "$rows" ;;
        table) fleet_render_table "$rows" ;;
    esac
    return 0
}

# Executed → render the dashboard; sourced → expose the functions for unit tests.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    fleet_main "$@"
fi
