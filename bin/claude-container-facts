#!/bin/bash
# claude-container-facts: print the "This container" section a session reads at start.
#
#   claude-container-facts
#
# The entrypoint (§7c) runs it at every start and writes its output into the session's
# managed memory (/etc/claude-code/CLAUDE.md), so a session knows what THIS container has
# without guessing. Every line comes from a probe run now, never from a hand-written list:
#   - the browser: chromium on PATH (its path and version), or "none"
#   - the chrome-devtools MCP: on or off, as the entrypoint decided it this boot
#     (CLAUDE_FACTS_BROWSER_MCP=on|off; anything else reads as off)
#   - the GPU: the boot probe's line (CLAUDE_FACTS_GPU_STATE, the file §2b wrote), else
#     `claude-gpu status --oneline` on a --gpu session, else "none"
#   - the CPUs: the cgroup quota (bin/nproc, the shim; CLAUDE_FACTS_NPROC names it) and the
#     per-process thread-pool cap §12 sets (OMP_NUM_THREADS, else CLAUDE_THREADS_PER_PROCESS)
#   - Gradle: the worker cap and daemon idle timeout §12 puts in GRADLE_OPTS (it runs after
#     this, so they are worked out here from CLAUDE_GRADLE_WORKERS and CLAUDE_GRADLE_IDLE_MS)
#   - toolchains with versions: git gh python3 uv node pnpm mise ("none" when absent)
#   - /cache and /scratch with free space (CLAUDE_FACTS_DIRS overrides the list), and TMPDIR
#   - how to install more
# Each probe is bounded (CLAUDE_FACTS_PROBE_TIMEOUT, 5s), so a wedged tool never hangs boot.
set -uo pipefail
# As root, system directories only: never a command from a directory the agent can write.
if (( EUID == 0 )); then export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; fi

PROBE_TIMEOUT="${CLAUDE_FACTS_PROBE_TIMEOUT:-5}"
GPU_STATE="${CLAUDE_FACTS_GPU_STATE:-/run/claude-gpu/state}"
DIRS="${CLAUDE_FACTS_DIRS:-/cache /scratch}"
MARK="claude-containers: container facts"

# The first version-shaped token of `<tool> --version`, or "" when the tool cannot say.
version_of() {
    timeout "$PROBE_TIMEOUT" "$1" --version 2>/dev/null | head -n 3 \
        | grep -oE '[0-9]+(\.[0-9]+)+' | head -n 1
}

browser() {
    local exe ver
    exe="$(command -v chromium 2>/dev/null)" || { echo "none"; return; }
    ver="$(version_of "$exe")"
    echo "chromium ${ver:-(version unknown)} at \`$exe\`"
}

containers() {
    if [[ "${CLAUDE_CONTAINERS:-0}" =~ ^(1|true|yes|on)$ ]]; then
        echo "rootless podman; \`docker\` and \`docker compose\` use it (DOCKER_HOST); see the containers note"
    else
        echo "none: podman and docker are installed but cannot run here (not a --containers session; relaunching with --containers is the operator's call)"
    fi
}
gpu() {
    local line=""
    if [[ -s "$GPU_STATE" ]]; then
        line="$(head -n 1 "$GPU_STATE")"
    elif [[ "${CLAUDE_GPU:-0}" =~ ^(1|true|yes|on)$ ]] && command -v claude-gpu >/dev/null 2>&1; then
        line="$(timeout 20 claude-gpu status --oneline 2>/dev/null | head -n 1)"
    fi
    line="${line#gpu: }"
    if [[ -z "$line" || "$line" == off ]]; then
        echo "none (not a --gpu session)"
    else
        echo "$line at start; \`claude-gpu status\` for now"
    fi
}

cpus() {
    local n q tpp
    n="$(timeout "$PROBE_TIMEOUT" "${CLAUDE_FACTS_NPROC:-nproc}" 2>/dev/null)"
    read -r q _ 2>/dev/null < "${CLAUDE_NPROC_CPU_MAX:-/sys/fs/cgroup/cpu.max}"
    if [[ "${q:-}" =~ ^[0-9]+$ ]]; then q="cgroup cpu.max"; else q="no cgroup quota"; fi
    tpp="${OMP_NUM_THREADS:-${CLAUDE_THREADS_PER_PROCESS:-4}}"
    if [[ "$tpp" =~ ^[1-9][0-9]*$ ]]; then
        echo "${n:-?} ($q); thread pools capped at $tpp per process (OMP_NUM_THREADS etc.; plain \`/usr/bin/nproc\` would show the cap)"
    else
        echo "${n:-?} ($q); thread pools not capped (CLAUDE_THREADS_PER_PROCESS=$tpp)"
    fi
}

gradle() {
    local n w i
    n="$(timeout "$PROBE_TIMEOUT" "${CLAUDE_FACTS_NPROC:-nproc}" 2>/dev/null)"
    [[ "$n" =~ ^[0-9]+$ ]] || n=0
    w="${CLAUDE_GRADLE_WORKERS-$(( n / 3 > 2 ? n / 3 : 2 ))}"   # §12's default
    i="${CLAUDE_GRADLE_IDLE_MS-1800000}"
    # An operator's own -D in GRADLE_OPTS is the one §12 keeps.
    [[ " ${GRADLE_OPTS:-} " == *" -Dorg.gradle.workers.max="* ]] && { w="${GRADLE_OPTS##*-Dorg.gradle.workers.max=}"; w="${w%% *}"; }
    [[ " ${GRADLE_OPTS:-} " == *" -Dorg.gradle.daemon.idletimeout="* ]] && { i="${GRADLE_OPTS##*-Dorg.gradle.daemon.idletimeout=}"; i="${i%% *}"; }
    if [[ "$w" =~ ^[1-9][0-9]*$ ]]; then w="builds capped at $w workers"; else w="workers not capped"; fi
    if [[ "$i" =~ ^[1-9][0-9]*$ ]]; then
        if (( i % 60000 )); then i="daemons stop after $(( i / 1000 )) s idle"; else i="daemons stop after $(( i / 60000 )) min idle"; fi
    else
        i="daemons keep Gradle's 3 h idle timeout"
    fi
    echo "$w, $i (GRADLE_OPTS: beats a repo's gradle.properties; \`--max-workers=N\` on the command line beats it)"
}

toolchains() {
    local t v out=()
    for t in git gh python3 uv node pnpm mise; do
        if command -v "$t" >/dev/null 2>&1; then
            v="$(version_of "$t")"
            out+=("$t ${v:-(version unknown)}")
        else
            out+=("$t none")
        fi
    done
    local IFS=','
    echo "${out[*]}" | sed 's/,/, /g'
}

space() {
    local d free out=()
    for d in $DIRS; do
        if [[ -d "$d" ]]; then
            free="$(df -hP "$d" 2>/dev/null | awk 'NR==2{print $4}')"
            [[ "$(stat -f -c %T "$d" 2>/dev/null)" == tmpfs ]] && free="$free RAM"
            out+=("\`$d\` ${free:-?} free")
        else
            out+=("\`$d\` absent")
        fi
    done
    local IFS=','
    echo "${out[*]}" | sed 's/,/; /g'
}

mcp="off"
[[ "${CLAUDE_FACTS_BROWSER_MCP:-off}" == on ]] && mcp="on"

cat <<EOF
<!-- $MARK. Written by claude-container-facts at each start; do not edit, it is rewritten. -->
## This container (probed at start, $(date -u +%Y-%m-%dT%H:%MZ))

- Browser: $(browser)
- chrome-devtools MCP: $mcp
- GPU: $(gpu)
- Containers: $(containers)
- CPUs: $(cpus)
- Gradle: $(gradle)
- Toolchains: $(toolchains)
- Space: $(space); TMPDIR is \`${TMPDIR:-/tmp}\`
- Install more: \`mise use <tool>@<version>\` first, then that language's own manager:
  \`uv\` for Python (\`uv run --with <pkg>\`, or \`pip\` on a mise Python), \`pnpm\` for Node,
  \`cargo\` for Rust, \`go install\` for Go. No apt, no sudo: a system library needs an
  image rebuild.
EOF
