#!/usr/bin/env bash
# claude-controller — the CLAUDE_CONTROLLER=1 tmux main-pane entrypoint.
#
# SC-5 removed the broker-dispatch tier this script used to run: a K>1 loop that leased
# backlog items (scripts/lease.sh) and dispatched them as nested Sysbox workers via
# claude-worker-request/claude-worker-broker/claude-worker-run — all deleted in the same
# strip (see docs/legacy-sysbox-broker.md for the frozen implementation and rationale).
#
# What's left is exactly the K==1 collapse that path always had as its safe default: a
# pass-through to claude-autopilot, unmodified, in-process (exec) — no flag translation,
# no wrapper argv, byte-identical to running claude-autopilot directly
# (test/controller-unit.sh proves this).
#
# A follow-up item, SC-6, will decide whether the controller tier survives at all now
# that its one built purpose (broker dispatch) is gone.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_common.sh"

controller_run_autopilot() {
    local bin
    bin="$(dirname "${BASH_SOURCE[0]}")/claude-autopilot"
    info "controller: pass-through to claude-autopilot (byte-identical launch)"
    # `exec bash "$bin"` rather than `exec "$bin"`: bin/claude-autopilot is tracked
    # non-executable in this repo (its Dockerfile COPY is chmod +x'd at image build time,
    # same as every other bin/claude-* the image installs to /usr/local/bin) — invoking it
    # via `bash` works identically whether or not the exec bit happens to be set on this
    # checkout, and is exactly how a raw `bash bin/claude-autopilot` invocation runs it, so
    # the launch this collapses to is unchanged either way.
    exec bash "$bin"
}

controller_main() {
    controller_run_autopilot
}

# Executed → run the controller; sourced → expose the functions for unit tests.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    controller_main
fi
