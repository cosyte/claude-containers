#!/usr/bin/env bash
# claude-launch <project-name> [options]
#   --repo <url>               git URL to clone into a fresh workspace volume
#   --branch <branch>          branch to check out
#   --depth <n>                shallow-clone depth
#   --workspace <path>         bind-mount a local checkout instead of cloning
#   --image <ref>              container image to run (overrides CLAUDE_IMAGE/.env;
#                              default claude-code-box:latest). Must exist locally.
#                              Only the default image auto-builds. e.g. …:browser
#   --port <ssh-port>          explicit host SSH port (default: auto 2200-2299)
#   --model <name>             model the session uses (default: opus = best
#                              available). Any Claude Code alias (opus, sonnet,
#                              haiku, opusplan, default) or a full id like
#                              claude-opus-4-8. 'default' = Claude Code's own pick.
#   --mcp <name>               enable only these baked-in MCP servers (repeatable)
#   --browser                  force-enable the chrome-devtools MCP for frontend
#                              debugging (requires a browser image built with
#                              WITH_BROWSER=1, i.e. `make build-browser`; a browser
#                              image auto-enables it even without this flag)
#   --no-browser               opt out of the chrome-devtools MCP on a browser image
#   --docker                   give the session its own Docker engine, so it can build
#                              images and run containers/compose stacks. Requires an
#                              image built with WITH_DOCKER=1 (`make build-docker`) and
#                              the Sysbox runtime on the host: the container then runs
#                              under --runtime=sysbox-runc, which contains the inner
#                              daemon in a user namespace (no --privileged, no host
#                              socket mount). The inner image store persists in the
#                              claude-docker-<project> volume.
#   --no-docker                opt out when CLAUDE_DOCKER=1 is set in .env
#   --extra-args "<args>"      extra args passed to claude via CLAUDE_EXTRA_ARGS
#   --expose <h:c>             publish an extra host:container port (repeatable)
#   --dev-cmd <command>        auto-start a dev server on boot in a tmux 'dev' window
#   --marketplace <name=url>   add a git plugin marketplace at runtime (repeatable)
#                              e.g. --marketplace claude-skills=git@github.com:org/repo.git
#   --plugin <name@mkt>        enable a plugin at runtime (repeatable)
#                              e.g. --plugin software-engineering@claude-skills
#   --cache <volume>           shared tool cache volume mounted at /cache
#                              (default: claude-cache). Reused across restarts
#                              for mise/cargo/go/npm/uv installs.
#   --no-cache                 disable the shared cache (per-container installs)
#   --accounts <name[,...]>    named OAuth accounts (from claude-account-login) this
#                              container can rotate between on a usage-limit hit
#                              (bin/claude-usage-watchdog). Repeatable/comma-list, works
#                              with any count >= 1 (a single account just gets auto-resume
#                              once its usage window resets, no rotation needed for that).
#                              Mutually exclusive with the default single AUTH_VOLUME mount.
#
# --broker / --sysbox / --worker-tarball were REMOVED with the nested-Sysbox
# worker-broker substrate was retired in favor of Claude Code subagents in git
# worktrees: see docs/legacy-sysbox-broker.md). Passing any of them is a hard error.
# The Sysbox RUNTIME is back, but as an implementation detail of --docker, not a flag.
set -euo pipefail
LAUNCH_BIN_DIR="$(dirname "${BASH_SOURCE[0]}")"
source "$LAUNCH_BIN_DIR/_common.sh"

usage() { sed -n '2,45p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

PROJECT="" REPO="" BRANCH="" DEPTH="" WS_PATH="" PORT=""
# EXTRA/MCP_LIST/DEVCMD/MKTS/PLUGINS default from .env (sourced by _common.sh);
# flags below override. Without seeding them here, the explicit `-e` flags on
# `docker run` would shadow any value set in .env with an empty string.
EXTRA="${CLAUDE_EXTRA_ARGS:-}" MCP_LIST="${CLAUDE_MCP_ENABLED:-}" DEVCMD="${CLAUDE_DEV_CMD:-}"
MKTS="${CLAUDE_EXTRA_MARKETPLACES:-}" PLUGINS="${CLAUDE_EXTRA_PLUGINS:-}"
ACCOUNTS="${CLAUDE_ACCOUNTS:-}"
# Empty here means "unset": the container's entrypoint then defaults it to opus
# (best available). A value from .env/env seeds the default; --model overrides.
MODEL="${CLAUDE_MODEL:-}"
# Git-key brokering is the DEFAULT posture (entrypoint.sh §5): a mounted deploy
# key is held in a root-owned ssh-agent that the agent user cannot read, and only
# a RECOGNISED disabling value (0/false/no/off) opts out to a readable
# ~/.ssh/id_ed25519. Normalise the unset case to 1 HERE, once, before anything
# below reads it: this script passes the variable through with `-e ...:-0` and
# also warns on the --docker combination, and seeding "0" at either site would
# hand every operator who never heard of this flag the readable key the default
# exists to avoid. An operator's own value (including a typo, which the
# entrypoint brokers) is passed through untouched.
CLAUDE_BROKER_GIT_KEY="${CLAUDE_BROKER_GIT_KEY:-1}"
# BROWSER is TRI-STATE: "" = auto (a browser image auto-enables the MCP; a lean
# image stays off), 1 = force on, 0 = explicit opt-out. Left empty here, the `-e
# CLAUDE_BROWSER` flag is omitted below so a browser image can self-detect.
# BROWSER_EXPLICIT tracks a per-launch --browser/--no-browser CLI flag (vs an
# ambient .env default) so only an explicit --browser hard-fails on a lean image.
# CACHE_ARG: the shared tool cache. Empty = the CACHE_VOLUME default
# (claude-cache) is mounted at /cache; --cache <vol> overrides the name;
# --cache off / --no-cache disables it (per-container installs).
# DOCKER mirrors BROWSER's tri-state ("" = off unless CLAUDE_DOCKER says otherwise,
# 1 = on, 0 = explicit opt-out), with DOCKER_EXPLICIT tracking a CLI flag so only an
# explicit --docker hard-fails on an engine-less image.
EXPOSE_RAW=() OPTS_GIVEN=0 BROWSER="" BROWSER_EXPLICIT=0 IMAGE_EXPLICIT=0 CACHE_ARG=""
DOCKER="" DOCKER_EXPLICIT=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo)        REPO="$2"; OPTS_GIVEN=1; shift 2 ;;
        --branch)      BRANCH="$2"; OPTS_GIVEN=1; shift 2 ;;
        --depth)       DEPTH="$2"; OPTS_GIVEN=1; shift 2 ;;
        --workspace)   WS_PATH="$2"; OPTS_GIVEN=1; shift 2 ;;
        --image)       CLAUDE_IMAGE="$2"; IMAGE_EXPLICIT=1; OPTS_GIVEN=1; shift 2 ;;
        --port)        PORT="$2"; OPTS_GIVEN=1; shift 2 ;;
        --model)       MODEL="$2"; OPTS_GIVEN=1; shift 2 ;;
        --mcp)         MCP_LIST="${MCP_LIST:+$MCP_LIST,}$2"; OPTS_GIVEN=1; shift 2 ;;
        --browser)     BROWSER=1; BROWSER_EXPLICIT=1; OPTS_GIVEN=1; shift ;;
        --no-browser)  BROWSER=0; BROWSER_EXPLICIT=1; OPTS_GIVEN=1; shift ;;
        --docker)      DOCKER=1; DOCKER_EXPLICIT=1; OPTS_GIVEN=1; shift ;;
        --no-docker)   DOCKER=0; DOCKER_EXPLICIT=1; OPTS_GIVEN=1; shift ;;
        --extra-args)  EXTRA="$2"; OPTS_GIVEN=1; shift 2 ;;
        --expose)      EXPOSE_RAW+=("$2"); OPTS_GIVEN=1; shift 2 ;;
        --dev-cmd)     DEVCMD="$2"; OPTS_GIVEN=1; shift 2 ;;
        --marketplace) MKTS="${MKTS:+$MKTS,}$2"; OPTS_GIVEN=1; shift 2 ;;
        --plugin)      PLUGINS="${PLUGINS:+$PLUGINS,}$2"; OPTS_GIVEN=1; shift 2 ;;
        --cache)       CACHE_ARG="$2"; OPTS_GIVEN=1; shift 2 ;;
        --no-cache)    CACHE_ARG="off"; OPTS_GIVEN=1; shift ;;
        --accounts)    ACCOUNTS="${ACCOUNTS:+$ACCOUNTS,}$2"; OPTS_GIVEN=1; shift 2 ;;
        # --sysbox named the retired broker's runtime toggle. The runtime is back (it is
        # what makes an inner daemon safe), but it is no longer a flag of its own: --docker
        # selects it. Point there rather than dying with a dead-end "removed" message.
        --sysbox)
            die "claude-launch: --sysbox was removed (the nested worker-broker substrate). To run containers inside a
       session, use --docker: it selects --runtime=sysbox-runc for you.
       (The worker broker it used to serve is gone: docs/legacy-sysbox-broker.md.)" ;;
        --broker|--worker-tarball)
            die "claude-launch: $1 was removed (the legacy Sysbox worker-broker substrate is retired; see docs/legacy-sysbox-broker.md)" ;;
        -h|--help)     usage 0 ;;
        -*)            die "unknown option: $1 (try --help)" ;;
        *)             [[ -z "$PROJECT" ]] && PROJECT="$1" || die "unexpected arg: $1"; shift ;;
    esac
done

# --browser / --no-browser can also be set via CLAUDE_BROWSER in .env / the host
# env: a CLI flag wins; env is the fallback; unset leaves auto-detect to the
# image's entrypoint (a browser image self-enables the MCP). Normalize the env
# value (strip whitespace / a CRLF `\r`, lowercase) so a Windows-authored .env
# still matches.
if [[ -z "$BROWSER" ]]; then
    case "$(printf '%s' "${CLAUDE_BROWSER:-}" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')" in
        1|true|yes|on)  BROWSER=1 ;;
        0|false|no|off) BROWSER=0 ;;
    esac
fi
# Same for --docker / CLAUDE_DOCKER. Unlike BROWSER there is no "auto": the runtime is a
# create-time choice the image cannot make for itself, so an unset value means off.
if [[ -z "$DOCKER" ]]; then
    case "$(printf '%s' "${CLAUDE_DOCKER:-}" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')" in
        1|true|yes|on)  DOCKER=1 ;;
        *)              DOCKER=0 ;;
    esac
fi
[[ -n "$PROJECT" ]] || usage 1
[[ -n "$REPO" && -n "$WS_PATH" ]] && die "--repo and --workspace are mutually exclusive"

# Validate --expose maps (HOSTPORT:CONTAINERPORT) and build the docker -p args.
EXPOSE_ARGS=()
for e in "${EXPOSE_RAW[@]:-}"; do
    [[ -n "$e" ]] || continue
    IFS=: read -r eh ec <<<"$e"
    [[ "$eh" =~ ^[0-9]+$ && "$ec" =~ ^[0-9]+$ ]] \
        || die "--expose must be HOSTPORT:CONTAINERPORT (got '$e')"
    EXPOSE_ARGS+=(-p "$eh:$ec")
done

need_docker
[[ -z "${ANTHROPIC_API_KEY:-}" ]] || die "ANTHROPIC_API_KEY is set (env or .env).
       This stack is OAuth-subscription only: unset it. It would otherwise be
       passed in and the container would refuse to start anyway."
PROJECT="$(sanitize "$PROJECT")"
CN="$(cname "$PROJECT")"
state="$(container_state "$CN")"

# Already running -> just print how to connect.
if [[ "$state" == "running" ]]; then
    info "Container '$CN' is already running."
    [[ "$OPTS_GIVEN" == "1" ]] && warn "launch options are ignored for an existing container: \`claude-rm $PROJECT\` then relaunch to apply them"
    print_connect "$PROJECT" "$(container_ssh_port "$CN")"
    exit 0
fi

# Stopped -> start it back up (workspace + history preserved). `docker start`
# reuses the container's creation-time env, ports, and mounts, so launch
# options passed now do NOT take effect: recreate the container to apply them.
if [[ "$state" == "stopped" ]]; then
    info "Starting existing container '$CN'…"
    [[ "$OPTS_GIVEN" == "1" ]] && warn "launch options are ignored on resume: \`claude-rm $PROJECT\` then relaunch to apply them"
    docker start "$CN" >/dev/null
    print_connect "$PROJECT" "$(container_ssh_port "$CN")"
    exit 0
fi

# Absent -> create it. An explicit --image must already exist locally: only the
# default image is auto-built from the local Dockerfile: auto-building an
# arbitrary ref (a registry image, or a :browser variant) would silently tag the
# lean build with the wrong name.
if [[ "$IMAGE_EXPLICIT" == "1" ]]; then
    info "Image: $CLAUDE_IMAGE (from --image)"
    docker image inspect "$CLAUDE_IMAGE" >/dev/null 2>&1 || \
        die "--image '$CLAUDE_IMAGE' not found locally. Build it (e.g. \`make build-browser\`)
       or \`docker pull\` it first: claude-launch only auto-builds the default image."
else
    ensure_image
fi
# Pre-flight: force-on (BROWSER=1) needs an image baked with WITH_BROWSER=1 (the
# Dockerfile's `claude.browser` label). An EXPLICIT per-launch --browser against a
# lean image fails LOUD and early: a requested-but-impossible browser session is
# an error, not a silent no-op that surfaces 30s later as a buried log line. An
# AMBIENT default (CLAUDE_BROWSER=1 in .env) must NOT brick ordinary lean launches:
# warn and fall back to auto so browser images still self-force while lean ones
# come up clean. (Auto, BROWSER="", never trips this: the lean image is normal.)
if [[ "$BROWSER" == "1" ]]; then
    img_browser="$(docker image inspect -f '{{ index .Config.Labels "claude.browser" }}' "$CLAUDE_IMAGE" 2>/dev/null || true)"
    if [[ "$img_browser" != "1" ]]; then
        if [[ "$BROWSER_EXPLICIT" == "1" ]]; then
            die "--browser was requested, but image '$CLAUDE_IMAGE' was not built with
       WITH_BROWSER=1: the chrome-devtools MCP cannot be enabled.
       Rebuild the browser variant:  make build-browser
         (or:  make build WITH_BROWSER=1 CLAUDE_IMAGE=<tag>, then set CLAUDE_IMAGE)
       Or drop --browser to launch the lean image."
        else
            warn "CLAUDE_BROWSER=1 is set but image '$CLAUDE_IMAGE' is lean (no WITH_BROWSER=1)."
            warn "  Launching without the chrome-devtools MCP. Build the browser variant"
            warn "  (make build-browser) for frontend debugging, or pass --no-browser to silence this."
            BROWSER=""   # fall back to auto: don't force the entrypoint to error
        fi
    fi
fi
# Pre-flight --docker, same shape as --browser: an explicit flag against an engine-less
# image is an error; an ambient CLAUDE_DOCKER=1 must not brick ordinary lean launches, so
# it warns and falls back to off. Then check the HOST can actually run it: the image
# having dockerd is only half of it, the runtime is the other half.
DOCKER_RUNTIME_ARGS=() DOCKER_VOL_ARGS=() DOCKER_ENV=()
if [[ "$DOCKER" == "1" ]]; then
    img_docker="$(docker image inspect -f '{{ index .Config.Labels "claude.docker" }}' "$CLAUDE_IMAGE" 2>/dev/null || true)"
    if [[ "$img_docker" != "1" ]]; then
        if [[ "$DOCKER_EXPLICIT" == "1" ]]; then
            die "--docker was requested, but image '$CLAUDE_IMAGE' was not built with
       WITH_DOCKER=1: it has no Docker engine, so the session cannot build or run
       containers.
       Rebuild the docker variant:  make build-docker
         (both engine + Chromium:   make build-docker-browser)
       Or drop --docker to launch the lean image."
        else
            warn "CLAUDE_DOCKER=1 is set but image '$CLAUDE_IMAGE' is lean (no WITH_DOCKER=1)."
            warn "  Launching without an inner Docker engine. Build the docker variant"
            warn "  (make build-docker), or pass --no-docker to silence this."
            DOCKER=0
        fi
    fi
fi
if [[ "$DOCKER" == "1" ]]; then
    preflight_sysbox
    DOCKER_RUNTIME_ARGS=(--runtime=sysbox-runc)
    DOCKER_ENV=(-e CLAUDE_DOCKER=1)
    DOCKER_VOL_ARGS=(-v "$(docker_volume "$PROJECT"):/var/lib/docker")

    # Inner containers live in THIS container's cgroup: every process, byte of RAM and CPU
    # second they use is charged to the session's limits. A compose stack in a 4g box OOM-
    # kills a nested container with a confusing inner-daemon error, not an obvious limit
    # error, so say it here while the operator can still act on it.
    if mem_mib="$(size_to_mib "$CLAUDE_MEM_LIMIT" 2>/dev/null)" && (( mem_mib < 8192 )); then
        warn "--docker with CLAUDE_MEM_LIMIT=$CLAUDE_MEM_LIMIT: inner containers share this"
        warn "  container's cgroup, so a compose stack has to fit inside it too. 8g+ is a"
        warn "  saner floor for building images / bringing up stacks."
    fi

    # Docker socket access is a path to root INSIDE the container (docker run -v /:/rootfs).
    # Sysbox keeps that root off the host, so the host boundary holds, but these two
    # controls exist to separate the agent from CONTAINER-root, and they no longer do.
    # Git-key brokering IS on by default (normalised above), egress lockdown is not; warn
    # rather than refuse, because the operator may genuinely want docker on a container
    # whose git key is already low-value.
    if [[ "${CLAUDE_BROKER_GIT_KEY:-0}" =~ ^(1|true|yes|on)$ ]]; then
        warn "CLAUDE_BROKER_GIT_KEY=1 with --docker: the git-key broker no longer protects the key."
        warn "  It hides the deploy key in a root-owned ssh-agent, but an agent with Docker can"
        warn "  read it straight off the filesystem (docker run -v /:/rootfs). Treat the key as"
        warn "  readable by the agent, or drop --docker on this container."
    fi
    if [[ "${CLAUDE_EGRESS_LOCKDOWN:-0}" =~ ^(1|true|yes|on)$ ]]; then
        warn "CLAUDE_EGRESS_LOCKDOWN=1 with --docker: the egress allowlist no longer binds."
        warn "  Inner containers' traffic is FORWARDed (the allowlist filters OUTPUT), and an"
        warn "  agent that can reach container-root can flush the rules outright. Do not rely"
        warn "  on it to contain a --docker session."
    fi
fi

[[ -n "$PORT" ]] || PORT="$(alloc_port)"
host_port_free "$PORT" || warn "host port $PORT looks busy; Docker may refuse it"

# Optionally bind the published SSH port to one host interface (CLAUDE_SSH_BIND,
# e.g. 127.0.0.1). Empty = published on all interfaces (LAN-reachable).
SSH_PUBLISH="${CLAUDE_SSH_BIND:+${CLAUDE_SSH_BIND}:}$PORT:22"

WS_VOL="$(ws_volume "$PROJECT")"
CFG_VOL="$(cfg_volume "$PROJECT")"

# Workspace source: bind mount, or named volume (cloned or resumed).
WS_MOUNT=()
if [[ -n "$WS_PATH" ]]; then
    WS_PATH="$(cd "$WS_PATH" 2>/dev/null && pwd)" || die "--workspace path not found"
    WS_MOUNT=(-v "$WS_PATH:/workspace")
    REPO_LABEL="bind:$WS_PATH"
else
    WS_MOUNT=(-v "$WS_VOL:/workspace")
    REPO_LABEL="${REPO:-$WS_VOL}"
    if [[ -z "$REPO" ]] && ! docker volume inspect "$WS_VOL" >/dev/null 2>&1; then
        die "no --repo, no --workspace, and no existing workspace volume '$WS_VOL'.
       First launch of a project needs --repo <url> or --workspace <path>."
    fi
fi

# Auth: either the single default volume (AUTH_VOLUME, from 'make login'), or a
# set of named accounts (--accounts, from claude-account-login) mounted
# read-write at /auth-accounts/<name> so bin/claude-usage-watchdog can rotate
# between them on a usage-limit hit. Mutually exclusive per container:
# entrypoint.sh picks its auth source based on whether CLAUDE_ACCOUNTS is set.
# Read-write (not :ro): the credential reconcile loop writes refreshed tokens
# back into whichever account volume is active.
AUTH_MOUNT_ARGS=() AUTH_ENV_ARGS=()
if [[ -n "$ACCOUNTS" ]]; then
    IFS=',' read -ra _account_names <<< "$ACCOUNTS"
    for _acct in "${_account_names[@]}"; do
        [[ -n "$_acct" ]] || die "--accounts has an empty account name in '$ACCOUNTS'"
        _vol="$(account_auth_volume "$_acct")"
        docker volume inspect "$_vol" >/dev/null 2>&1 \
            || die "account '$_acct' has no volume '$_vol'. Run 'claude-account-login $_acct' once first."
        AUTH_MOUNT_ARGS+=(-v "$_vol:/auth-accounts/$_acct")
    done
    AUTH_ENV_ARGS=(-e CLAUDE_ACCOUNTS="$ACCOUNTS")
    info "Accounts: $ACCOUNTS (rotates on a usage-limit hit; single-account still auto-resumes after reset)"
else
    docker volume inspect "$AUTH_VOLUME" >/dev/null 2>&1 \
        || die "auth volume '$AUTH_VOLUME' missing. Run 'make login' once first."
    AUTH_MOUNT_ARGS=(-v "$AUTH_VOLUME:/auth")
fi

# Shared tool cache: mount the shared cache volume at /cache unless disabled.
# Docker auto-creates the named volume (seeded from the image's /cache) on first use,
# so this never blocks a launch; --no-cache / --cache off drops the mount entirely.
CACHE_MOUNT_ARGS=()
mapfile -t CACHE_MOUNT_ARGS < <(cache_mount_args "${CACHE_ARG:-$CACHE_VOLUME}")
if (( ${#CACHE_MOUNT_ARGS[@]} )); then
    info "Shared tool cache: ${CACHE_MOUNT_ARGS[1]} (mise/cargo/go/npm/uv reused across restarts + workers)"
else
    info "Shared tool cache: disabled (per-container installs)"
fi

# Read-only host mounts (skip with a warning if absent).
RO_MOUNTS=()
if [[ -f "$SSH_AUTHORIZED_KEYS" ]]; then
    RO_MOUNTS+=(-v "$SSH_AUTHORIZED_KEYS:/etc/claude/authorized_keys:ro")
else
    warn "no authorized_keys at $SSH_AUTHORIZED_KEYS: SSH will be disabled"
fi
if [[ -f "$GIT_SSH_KEY" ]]; then
    RO_MOUNTS+=(-v "$GIT_SSH_KEY:/etc/claude/git-key:ro")
else
    warn "no git SSH key at $GIT_SSH_KEY: only public/https repos will clone"
fi

# Git identity defaults from the host's git config.
GH_NAME="$(git config --global user.name  2>/dev/null || true)"
GH_MAIL="$(git config --global user.email 2>/dev/null || true)"

ENV_FILE_ARG=()
[[ -f "$CLAUDE_DOCKER_ROOT/.env" ]] && ENV_FILE_ARG=(--env-file "$CLAUDE_DOCKER_ROOT/.env")

# Per-container resource profile + escape hardening. Two runtimes now: plain runc for an
# ordinary session, and sysbox-runc for --docker (the user namespace is what lets an inner
# dockerd run with no --privileged and no host socket). harden_run_args takes the mode
# because docker mode must NOT cap-drop: an inner daemon cannot run under the minimal set,
# and under Sysbox the full set is namespaced to a container-root that maps to an
# unprivileged host uid anyway. preflight_runc's escape warning still applies to both.
FLAT_PROFILE=(--cpus "$CLAUDE_CPU_LIMIT" --memory "$CLAUDE_MEM_LIMIT" \
              --memory-reservation "$CLAUDE_MEM_RESERVATION" --pids-limit "$CLAUDE_PIDS_LIMIT")
preflight_runc
HARDEN_ARGS=()
read -r -a HARDEN_ARGS <<<"$(harden_run_args "$DOCKER")"
SIZING_ARGS=("${FLAT_PROFILE[@]}")

# Only pin CLAUDE_BROWSER when the user forced it on/off; in auto mode leave it
# unset so a browser image self-enables the MCP (and any .env value flows through
# --env-file rather than being clobbered with an empty -e).
BROWSER_ENV=()
[[ -n "$BROWSER" ]] && BROWSER_ENV=(-e CLAUDE_BROWSER="$BROWSER")

info "Creating container '$CN' (SSH host port $PORT)…"
[[ "$DOCKER" == "1" ]] && info "  docker mode: sysbox-runc, inner image store on $(docker_volume "$PROJECT")"
docker run -d \
    --name "$CN" \
    --hostname "$PROJECT" \
    --restart unless-stopped \
    --init \
    "${DOCKER_RUNTIME_ARGS[@]}" \
    "${HARDEN_ARGS[@]}" \
    --shm-size "$CLAUDE_SHM_SIZE" \
    "${SIZING_ARGS[@]}" \
    --tmpfs /tmp:rw,nosuid,nodev,exec,size=1g \
    -p "$SSH_PUBLISH" \
    "${EXPOSE_ARGS[@]}" \
    "${ENV_FILE_ARG[@]}" \
    "${DOCKER_ENV[@]}" \
    "${DOCKER_VOL_ARGS[@]}" \
    -v "$(scratch_volume "$PROJECT"):/scratch" \
    -e TMPDIR=/scratch \
    -e CLAUDE_PROJECT_NAME="$PROJECT" \
    -e CLAUDE_MODEL="$MODEL" \
    -e CLAUDE_EXTRA_ARGS="$EXTRA" \
    -e CLAUDE_MCP_ENABLED="$MCP_LIST" \
    -e CLAUDE_DEV_CMD="$DEVCMD" \
    "${BROWSER_ENV[@]}" \
    -e CLAUDE_EXTRA_MARKETPLACES="$MKTS" \
    -e CLAUDE_EXTRA_PLUGINS="$PLUGINS" \
    "${AUTH_ENV_ARGS[@]}" \
    -e CLAUDE_PERMISSION_MODE="${CLAUDE_PERMISSION_MODE:-bypassPermissions}" \
    -e CLAUDE_SECRET_GUARD="${CLAUDE_SECRET_GUARD:-1}" \
    -e CLAUDE_BROKER_GIT_KEY="${CLAUDE_BROKER_GIT_KEY:-0}" \
    -e CLAUDE_EGRESS_LOCKDOWN="${CLAUDE_EGRESS_LOCKDOWN:-0}" \
    -e CLAUDE_EGRESS_EXTRA_HOSTS="${CLAUDE_EGRESS_EXTRA_HOSTS:-}" \
    -e GIT_REPO_URL="$REPO" \
    -e GIT_REPO_BRANCH="$BRANCH" \
    -e GIT_REPO_DEPTH="$DEPTH" \
    -e GIT_AUTHOR_NAME="${GIT_AUTHOR_NAME:-$GH_NAME}" \
    -e GIT_AUTHOR_EMAIL="${GIT_AUTHOR_EMAIL:-$GH_MAIL}" \
    -e GIT_COMMITTER_NAME="${GIT_COMMITTER_NAME:-$GH_NAME}" \
    -e GIT_COMMITTER_EMAIL="${GIT_COMMITTER_EMAIL:-$GH_MAIL}" \
    "${AUTH_MOUNT_ARGS[@]}" \
    -v "$SSHKEYS_VOLUME:/etc/ssh/host-keys" \
    -v "$CFG_VOL:/home/claude/.claude" \
    "${WS_MOUNT[@]}" \
    "${CACHE_MOUNT_ARGS[@]}" \
    "${RO_MOUNTS[@]}" \
    --label claude.managed=1 \
    --label claude.project="$PROJECT" \
    --label claude.ssh_port="$PORT" \
    --label claude.repo="$REPO_LABEL" \
    --label claude.docker="$DOCKER" \
    "$CLAUDE_IMAGE" >/dev/null

# Surface a fast-failing entrypoint (bad repo, missing auth) instead of a
# silent restart loop.
sleep 2
if [[ "$(container_state "$CN")" != "running" ]]; then
    err "container exited during startup. Last log lines:"
    docker logs --tail 30 "$CN" 2>&1 | sed 's/^/    /'
    exit 1
fi

print_connect "$PROJECT" "$PORT"

if (( ${#EXPOSE_RAW[@]} )); then
    echo "  Extra published ports:"
    for e in "${EXPOSE_RAW[@]}"; do
        echo "      host ${e%%:*}  ->  container ${e##*:}"
    done
    echo
fi
info "Model: ${MODEL:-opus (best available, container default)}"
[[ -n "$DEVCMD" ]] && \
    info "Dev server auto-starts on boot in tmux window 'dev' (claude-attach, then: tmux select-window -t claude:dev)"
# Only announce an explicit choice; in auto mode the entrypoint decides by image
# (a browser image auto-registers, a lean image stays silent): no noise here.
case "$BROWSER" in
    1) info "Frontend debug: chrome-devtools MCP force-enabled (headless Chromium in-container)" ;;
    0) info "Frontend debug: chrome-devtools MCP opted out (--no-browser)" ;;
esac
