#!/usr/bin/env bash
# tmux 'main' window command for UNATTENDED operation.
#
# Instead of an interactive Remote Control session (claude-session), drive a
# headless Claude loop on an interval, running whatever CLAUDE_AUTOPILOT_CMD says.
# Mirrors claude-dev's "run, then drop to a shell so the SSH/tmux window stays
# usable" contract.
#
# CLAUDE_AUTOPILOT_CMD IS REQUIRED: it has NO DEFAULT. It used to default to a slash
# command that only existed in the maintainer's own repo. That default was wrong twice
# over. This image is a GENERIC container: it bakes no such command (see
# claude-config/skills: only example-skill and frontend-debugging ship), and the
# workspace it is pointed at is arbitrary. So on almost every container the default
# resolved to NOTHING, and, as the run loop below documents in detail, `claude -p`
# reports an unknown slash command as a zero-turn SUCCESS (exit 0, is_error:false),
# which this loop used to count as a healthy run forever: a container that looks alive
# and does nothing. And in the one workspace where it *did* resolve, it was an
# explicitly human-driven command whose own contract said it must not be looped, so the
# default either quietly did nothing or violated the contract of the one thing it named.
# Now: no command, no run. Fail loudly, never silently.
#
# Selected by CLAUDE_AUTOPILOT=1 (the entrypoint runs this as the main pane
# instead of claude-session, and skips the Remote Control watchdog).
#
# Tunables (env):
#   CLAUDE_AUTOPILOT_CMD          prompt/command to run each cycle   (REQUIRED, no default,
#                                 unless CLAUDE_AUTOPILOT_QUEUE=1, which makes this a pure
#                                 queue consumer that idles on an empty queue)
#   CLAUDE_AUTOPILOT_INTERVAL     seconds between successful runs    (default: 3600)
#   CLAUDE_AUTOPILOT_MAX_RUNS     stop after N runs, 0 = unlimited   (default: 0)
#   CLAUDE_AUTOPILOT_BACKOFF_MAX  cap on failure backoff, seconds    (default: 21600)
#   CLAUDE_AUTOPILOT_LOG_DIR      where per-run JSON logs go         (default: ~/.claude/autopilot-logs)
#   CLAUDE_AUTOPILOT_RESUME       1 = resume the prior session each  (default: 0, each run is a
#                                 run via --resume <id> instead of   fresh session, which is right
#                                 a fresh session                    for a command that recovers its
#                                                                    own state from disk)
#   CLAUDE_PERMISSION_MODE        acceptEdits/auto/bypassPermissions/manual/dontAsk/plan
#                                 (default: bypassPermissions; `default` was renamed
#                                  `manual` upstream in CLI 2.1.200 but still parses)
#   CLAUDE_EXTRA_ARGS             extra args appended to `claude`
set -uo pipefail

cd /workspace 2>/dev/null || cd "$HOME"

PROMPT="${CLAUDE_AUTOPILOT_CMD:-}"
INTERVAL="${CLAUDE_AUTOPILOT_INTERVAL:-3600}"
MAX_RUNS="${CLAUDE_AUTOPILOT_MAX_RUNS:-0}"
BACKOFF_MAX="${CLAUDE_AUTOPILOT_BACKOFF_MAX:-21600}"
EXTRA="${CLAUDE_EXTRA_ARGS:-}"
LOG_DIR="${CLAUDE_AUTOPILOT_LOG_DIR:-$HOME/.claude/autopilot-logs}"
RESUME="${CLAUDE_AUTOPILOT_RESUME:-0}"
PERM_MODE="${CLAUDE_PERMISSION_MODE:-bypassPermissions}"
# Model: the entrypoint normally exports this (default `opus`). Default it HERE TOO,
# not cosmetic since CLI 2.1.197, where "no --model" means Claude Code's own default,
# which is now **Sonnet 5**, not Opus. This script is reachable with CLAUDE_MODEL unset
# or empty (a `docker exec <ctr> claude-autopilot`, or any sshd-originated shell, the
# entrypoint only bridges SSH_AUTH_SOCK into /etc/profile.d, not CLAUDE_MODEL; and
# claude-launch passes a literal empty `-e CLAUDE_MODEL=` when it is unset). Without this
# default those runs would silently execute on Sonnet 5: the exact downgrade
# CC-CLAUDE-CODE-UPGRADE exists to prevent. CLAUDE_MODEL is passed through to `--model`
# VERBATIM: use an alias the pinned CLI actually ships (`opus`, `sonnet`, `haiku`, `opusplan`,
# `fable`, `best`) or a full model id. NOTE: `default` is NOT in the pinned CLI's alias table and is
# not verified: do not rely on it.
MODEL="${CLAUDE_MODEL:-opus}"
QUEUE="${CLAUDE_AUTOPILOT_QUEUE:-0}"
QUEUE_DIR="${CLAUDE_AUTOPILOT_QUEUE_DIR:-$HOME/.claude/autopilot-queue}"
QUEUE_DELAY="${CLAUDE_AUTOPILOT_QUEUE_DELAY:-10}"
mkdir -p "$LOG_DIR"
SESSION_FILE="$LOG_DIR/.session-id"   # persists on the per-container config volume

# Durable task queue (opt-in). Queue beats a blind timer for fleet work: drop a
# prompt file into pending/ (over SSH, a bind mount, or `claude-enqueue`) and the
# loop claims the oldest one, runs it, and files it under done/ or failed/. When
# pending/ is empty it falls back to CLAUDE_AUTOPILOT_CMD on the interval, or, if
# no CLAUDE_AUTOPILOT_CMD is set, simply IDLES (a pure queue consumer). Atomic
# mv-based claiming keeps it safe and the dirs live on the per-container config
# volume so the queue survives restarts. Each task is a fresh session
# (self-contained); --resume applies only to the CLAUDE_AUTOPILOT_CMD fallback.
case "$QUEUE" in
    1|true|yes|on) QUEUE=1; mkdir -p "$QUEUE_DIR"/{pending,running,done,failed} ;;
    *)             QUEUE=0 ;;
esac

# No command and no queue = nothing to do. Refuse, loudly, and drop to a shell rather
# than exiting: this is the tmux 'main' pane, and a pane whose command exits is a window
# the operator finds DEAD when they SSH in, with the reason scrolled away. Staying in a
# shell keeps the error on screen and the container usable.
if [[ -z "$PROMPT" && "$QUEUE" != 1 ]]; then
    echo "[autopilot] ERROR: CLAUDE_AUTOPILOT_CMD is not set, and there is nothing else to run."
    echo "[autopilot]"
    echo "[autopilot] It has NO DEFAULT (it used to default to a command this generic image"
    echo "[autopilot] does not ship: see this script's header)."
    echo "[autopilot] Whatever you set it to must be a command YOUR workspace defines: an unknown"
    echo "[autopilot] slash command does not error, it just quietly runs nothing."
    echo "[autopilot]"
    echo "[autopilot] Either:"
    echo "[autopilot]   - set CLAUDE_AUTOPILOT_CMD=<prompt or slash-command your workspace defines>, or"
    echo "[autopilot]   - set CLAUDE_AUTOPILOT_QUEUE=1 and feed it tasks with claude-enqueue."
    echo "[autopilot]"
    echo "[autopilot] Dropping to a shell."
    exec bash -l
fi

# Atomically claim the oldest pending task → echo its running/ path, or nothing.
claim_task() {
    local f base dest
    for f in $(ls -1 "$QUEUE_DIR/pending" 2>/dev/null | sort); do
        base="$f"; dest="$QUEUE_DIR/running/$base"
        # mv on one filesystem is atomic: the winner gets the file, losers fail.
        if mv -n "$QUEUE_DIR/pending/$base" "$dest" 2>/dev/null && [[ -e "$dest" ]]; then
            echo "$dest"; return 0
        fi
    done
    return 1
}
pending_count() { ls -1 "$QUEUE_DIR/pending" 2>/dev/null | wc -l | tr -d ' '; }

# Map CLAUDE_PERMISSION_MODE to the right claude(1) flag. bypassPermissions keeps
# the historical --dangerously-skip-permissions (full autonomy, accepted for a
# headless container-isolated run). Any other mode goes through --permission-mode
# so the fleet can run hardened (acceptEdits gates shell/network; auto uses the
# classifier) without editing this script.
perm_flags() {
    case "$PERM_MODE" in
        bypassPermissions|bypass|"") printf '%s' '--dangerously-skip-permissions' ;;
        *)                           printf '%s %s' '--permission-mode' "$PERM_MODE" ;;
    esac
}

# `--model <m>` when CLAUDE_MODEL is set (the entrypoint defaults it to opus), else
# nothing so Claude Code uses its own default. Aliases carry no spaces, so the
# word-split at the call site is safe.
model_flags() { [[ -n "$MODEL" ]] && printf '%s %s' '--model' "$MODEL"; }

# Best-effort: turn a rate-limit reset hint in the run output into seconds-to-sleep.
# Handles a unix-epoch reset field in the JSON and a human "reset at 3pm"/"resets
# at 23:00" string. Echoes seconds (>0) or nothing.
#
#   seconds_until_reset <json-log> [<stderr-log>]
#
# Takes BOTH streams. The run used to be captured with `2>&1`, so one file held everything;
# splitting them (so a stderr warning can't corrupt the JSON, see the run loop) would have
# quietly cut this function off from stderr, where a human-readable reset hint is just as
# likely to appear. Losing it is not a safety bug: the capped exponential backoff still
# protects the shared quota, but it would silently trade "sleep exactly until reset" for
# "sleep blindly", which is worse throughput on a shared Max plan. So: scan both.
seconds_until_reset() {
    local file="$1" errfile="${2:-}" now epoch target secs
    now="$(date -u +%s)"
    # 1) Structured: any *reset*/retry epoch the CLI may emit in JSON. Recursive walk, so it
    #    works on either the plain result object or a --verbose stream array.
    if command -v jq >/dev/null 2>&1; then
        epoch="$(jq -r '
            [.. | objects | (.resetsAt? // .reset_at? // .retryAt? // .retry_at? // empty)]
            | map(select(type=="number")) | (.[0] // empty)' "$file" 2>/dev/null)"
        if [[ "$epoch" =~ ^[0-9]+$ ]]; then
            [[ "$epoch" -gt 9999999999 ]] && epoch=$((epoch / 1000))   # ms → s
            secs=$((epoch - now))
            (( secs > 0 )) && { echo "$secs"; return; }
        fi
    fi
    # 2) Human string: "reset(s) at 3pm" / "reset at 23:00" (local tz), in stdout OR stderr.
    local hint scan=("$file")
    [[ -n "$errfile" && -f "$errfile" ]] && scan+=("$errfile")
    hint="$(grep -hoiE 'reset[s]?[^0-9]{0,12}([0-9]{1,2}(:[0-9]{2})?\s*(am|pm)?)' "${scan[@]}" 2>/dev/null | head -n1)"
    if [[ -n "$hint" ]]; then
        local clock; clock="$(grep -oiE '[0-9]{1,2}(:[0-9]{2})?\s*(am|pm)?' <<<"$hint" | head -n1)"
        if [[ -n "$clock" ]] && target="$(date -d "$clock" +%s 2>/dev/null)"; then
            secs=$((target - $(date +%s)))
            (( secs <= 0 )) && secs=$((secs + 86400))   # already past today → tomorrow
            (( secs > 0 )) && { echo "$secs"; return; }
        fi
    fi
}

echo "[autopilot] prompt   : ${PROMPT:-(none, pure queue consumer)}"
echo "[autopilot] interval : ${INTERVAL}s   max_runs: $([ "$MAX_RUNS" = 0 ] && echo ∞ || echo "$MAX_RUNS")"
echo "[autopilot] workspace: $(pwd)"
echo "[autopilot] logs     : $LOG_DIR"
echo "[autopilot] perm     : $PERM_MODE   resume: $([ "$RESUME" = 1 ] && echo on || echo off)"
echo "[autopilot] model    : $MODEL"
[ "$QUEUE" = 1 ] && echo "[autopilot] queue    : $QUEUE_DIR ($(pending_count) pending; when empty: $([ -n "$PROMPT" ] && echo "falls back to '$PROMPT'" || echo "idles"))"
echo "[autopilot] auth     : Max subscription OAuth (entrypoint refuses ANTHROPIC_API_KEY)"
echo

run=0
fails=0
total_cost=0
while :; do
    # Pick this cycle's work: a queued task if one is waiting, else the timer command.
    # Queued tasks run as one-shot fresh sessions.
    task_path=""; RUN_PROMPT="$PROMPT"; run_kind="cmd"
    if [ "$QUEUE" = 1 ] && task_path="$(claim_task)" && [[ -n "$task_path" ]]; then
        RUN_PROMPT="$(cat "$task_path")"
        run_kind="task"
    else
        task_path=""
        # Pure queue consumer: queue on, nothing pending, and no fallback command. IDLE.
        # Never synthesize a prompt to fill the gap: firing an invented command headless
        # under --dangerously-skip-permissions is precisely what the old default command did.
        # This burns no quota and is not a "run", so it does not advance the run counter or
        # touch the failure backoff.
        if [[ -z "$RUN_PROMPT" ]]; then
            echo "[autopilot] queue empty, no CLAUDE_AUTOPILOT_CMD fallback: idling ${INTERVAL}s"
            sleep "$INTERVAL"
            continue
        fi
    fi

    run=$((run + 1))
    ts="$(date -u +%Y%m%dT%H%M%SZ)"
    out="$LOG_DIR/run-$ts.json"
    echo "[autopilot] === run #$run ($ts) ==="
    [[ "$run_kind" = "task" ]] && echo "[autopilot] task     : $(basename "$task_path")"

    # Headless and container-isolated. Permission posture comes from
    # CLAUDE_PERMISSION_MODE (see perm_flags). NOT --remote-control: unattended.
    # The CLAUDE_AUTOPILOT_CMD fallback is a fresh session by default (the right
    # shape for a command that recovers its state from disk);
    # CLAUDE_AUTOPILOT_RESUME=1 carries the conversation forward instead.
    # --resume never applies to a queued task (each is self-contained).
    resume_flags=""
    if [[ "$run_kind" = "cmd" && "$RESUME" = 1 && -s "$SESSION_FILE" ]]; then
        resume_flags="--resume $(cat "$SESSION_FILE")"
        echo "[autopilot] resuming session $(cat "$SESSION_FILE")"
    fi

    # stdin from /dev/null, and stderr to its OWN file, NEVER merged into $out. Both are
    # load-bearing, and this used to be `>"$out" 2>&1`:
    #
    #   1. `claude -p` writes a warning to STDERR when stdin is an open pipe with no data:
    #      "Warning: no stdin data received in 3s, proceeding without it..." (157 bytes,
    #      verified on the then-pinned 2.1.207). Any non-tty invocation gets it: `ssh <ctr>
    #      claude-autopilot`, `docker exec`, a cron. `</dev/null` is what that warning itself
    #      tells you to do, and it stops the warning at the source.
    #   2. Under `2>&1` that line lands in $out AHEAD of the JSON, so $out is no longer valid
    #      JSON, and then EVERY jq read below returns empty. `.is_error` reads empty (not
    #      "true"), the zero-turn check reads empty, and the run scores as a SUCCESS. That is
    #      a fail-OPEN: ANY stderr output at all (a deprecation notice, an update nag, a token
    #      refresh) would silently turn this loop back into the healthy-looking no-op it exists
    #      to prevent. Keeping stderr out of the JSON is what makes the checks below trustworthy.
    err="$out.err"
    ok=1
    # shellcheck disable=SC2086  # flag vars are intentionally word-split
    claude -p "$RUN_PROMPT" $(perm_flags) $(model_flags) --output-format json $resume_flags $EXTRA \
        </dev/null >"$out" 2>"$err" || ok=0

    # FAIL CLOSED on a log we cannot read, and validate its SHAPE, not merely its syntax.
    # "Don't know what happened" must NEVER score as "success"; that inversion is the whole bug
    # class here, and every silent no-op this loop has had came from a check that could not read
    # its input and shrugged.
    #
    # Syntax alone is not enough, because CLAUDE_EXTRA_ARGS is a first-class documented tunable
    # (.env.example, README, `claude-launch --extra-args`) and adding `--verbose` to it makes the
    # CLI emit a top-level ARRAY of stream messages instead of one object, whose LAST element is
    # that same result object. An array IS valid JSON, so a bare `jq -e .` check passes it; then
    # every field read against an array returns empty, `.is_error` reads "" (not "true") and
    # `.num_turns` reads "" (not "0"), and BOTH guards below silently disengage. Same fail-open,
    # one layer up, and `--verbose` is precisely the flag an operator reaches for to debug "why
    # is my autopilot doing nothing?", so the debugging flag would re-create the silence they
    # were chasing. (`jq -e .` also exits 0 on an EMPTY file, hence the `-s` test.)
    #
    # So: accept either shape, reduce it to the one result object every check below reads, and
    # fail closed on anything else.
    # Per-PROCESS path, not a single shared one: two autopilots sharing a LOG_DIR (a
    # `docker exec <ctr> claude-autopilot` alongside the tmux pane, or containers pointed at one
    # CLAUDE_AUTOPILOT_LOG_DIR) would otherwise race on it and score each other's results.
    # Overwritten each cycle, so it never accumulates.
    res="$LOG_DIR/.result.$$.json"
    parsed=0
    if ! command -v jq >/dev/null 2>&1; then
        ok=0
        echo "[autopilot] ERROR: jq is not on PATH, a run's outcome cannot be verified. Treating as FAILED."
    elif [[ -s "$out" ]] && jq -e '
            (if type == "array" then (map(select(.type? == "result")) | last) else . end)
            | select(type == "object" and has("num_turns") and has("is_error"))
         ' "$out" > "$res" 2>/dev/null; then
        parsed=1
    else
        ok=0
        rm -f "$res" 2>/dev/null || true
        echo "[autopilot] ERROR: the run log carries no readable result object, cannot verify this"
        echo "[autopilot] ERROR: run, so treating it as FAILED (an unverifiable run is not a good one)."
        echo "[autopilot] ERROR: log head : $(head -c 200 "$out" 2>/dev/null)"
        [[ -s "$err" ]] && echo "[autopilot] ERROR: stderr   : $(head -c 200 "$err" 2>/dev/null)"
    fi

    if (( parsed )) && [ "$(jq -r '.is_error // false' "$res" 2>/dev/null)" = "true" ]; then
        ok=0
    fi

    # THE NO-OP GUARD. `num_turns == 0` means THE MODEL WAS NEVER INVOKED: nothing ran, $0
    # spent, and `claude -p` reports that as a plain SUCCESS: exit 0, is_error:false, subtype
    # "success". Probed by hand against the then-PINNED CLI (2.1.207, Dockerfile ARG
    # CLAUDE_CODE_VERSION); every one of these exits 0 with is_error:false:
    #
    #   /typo     → num_turns:0  result:"Unknown command: /typo"
    #   /help     → num_turns:0  result:"/help isn't available in this environment."
    #   /status   → num_turns:0  result:"/status isn't available in this environment."
    #   /cost     → num_turns:0  result:"You are currently using your subscription…"
    #   /compact  → num_turns:0  result:""          ← not even a message on the pane
    #   /clear    → num_turns:0  result:""
    #
    # So it is not just typos: EVERY slash command that exists but is unavailable headless lands
    # here. Left alone the loop counts them as healthy runs FOREVER: `fails` stays 0 so backoff
    # never engages, every cycle prints "run #N" and "cost: $0", and a queued task gets filed to
    # done/, silently marking work that never ran as done on the very claude-scm-observer →
    # queue path built to run a fleet unattended. A container that looks perfectly alive and
    # does literally nothing is the worst failure this script can have.
    #
    # The predicate is `num_turns == 0` ALONE, deliberately. It is tempting to also require the
    # result text to start with "Unknown command:", DON'T:
    #   - it buys no false-positive protection. A legitimate run that merely *discusses* an
    #     unknown command still invoked the model, so it has num_turns >= 1 and cannot trip this.
    #   - it misses every row above except the typo (/compact and /clear carry no text at all).
    #   - it would couple this guard to an English string from a CLI whose pin this repo bumps
    #     routinely: a reworded message would silently reopen the hole with no test failing.
    # Zero turns is zero work. That is the whole rule.
    unknown=0
    unknown_msg=""
    if [ "$ok" = 1 ] && (( parsed )) \
       && [[ "$(jq -r '.num_turns // empty' "$res" 2>/dev/null)" == "0" ]]; then
        ok=0
        unknown=1
        unknown_msg="$(jq -r '.result // empty' "$res" 2>/dev/null)"
        [[ -n "$unknown_msg" ]] || unknown_msg="(the CLI returned no message at all)"
    fi

    if (( parsed )); then
        jq -r '.result // "(no result field)"' "$res" 2>/dev/null | head -n 40

        # Per-run cost/token accounting (total_cost_usd + modelUsage), so the
        # shared subscription's spend is attributable per container without the
        # usage dashboard. Carry session_id forward for --resume.
        sid="$(jq -r '.session_id // empty' "$res" 2>/dev/null)"
        [[ -n "$sid" ]] && printf '%s' "$sid" > "$SESSION_FILE"
        read -r cost turns dur <<<"$(jq -r '[(.total_cost_usd // 0), (.num_turns // 0), (.duration_ms // 0)] | @tsv' "$res" 2>/dev/null)"
        if [[ -n "${cost:-}" ]]; then
            total_cost="$(awk -v a="$total_cost" -v b="$cost" 'BEGIN{printf "%.4f", a+b}')"
            printf '[autopilot] cost: $%s this run · $%s cumulative · turns=%s · %ss\n' \
                "$cost" "$total_cost" "${turns:-?}" "$(( ${dur:-0} / 1000 ))"
        fi
    else
        # Unparseable (already reported + scored as a failure above): show the raw tail so the
        # operator sees what actually came back.
        tail -n 5 "$out" 2>/dev/null
    fi
    # Surface stderr whenever there is any: it never reaches $out now, so an unreported warning
    # would otherwise vanish. Drop the file when empty so LOG_DIR doesn't fill with noise.
    if [[ -s "$err" ]]; then
        echo "[autopilot] stderr: $(head -c 300 "$err")"
    else
        rm -f "$err" 2>/dev/null || true
    fi

    # File a queued task by outcome; the run timestamp keeps the history greppable.
    if [[ -n "$task_path" ]]; then
        if [ "$ok" = 1 ]; then dest="$QUEUE_DIR/done/$ts-$(basename "$task_path")"
        else                   dest="$QUEUE_DIR/failed/$ts-$(basename "$task_path")"; fi
        mv -f "$task_path" "$dest" 2>/dev/null || true
        echo "[autopilot] task     : $([ "$ok" = 1 ] && echo done || echo FAILED) → $(basename "$dest")"
    fi

    if (( unknown )); then
        # Handled BEFORE the generic backoff below, which exists for transient failures
        # (rate limits, flaky network). This is not transient: an unknown command will never
        # resolve on its own, so sleeping 2^n on it is just a slower way to do nothing.
        #
        # `fails` is deliberately left ALONE in every branch here: neither reset nor bumped.
        # It is the transient-failure streak that drives the quota backoff, and an unresolvable
        # command is orthogonal to it. Resetting it would let poison queued tasks interleaved
        # with real rate-limit failures hold the backoff near its floor during a rate-limit
        # storm: clawing at the shared Max quota the backoff exists to protect. Bumping it
        # would back off over a condition backoff cannot fix. This branch sets its own
        # sleep_for, so the streak simply isn't its business.
        echo "[autopilot] ERROR: nothing ran, 0 turns, \$0, the model was never invoked."
        echo "[autopilot] ERROR: claude reported: $unknown_msg"
        echo "[autopilot] ERROR: '$RUN_PROMPT' is either not a command this workspace defines, or"
        echo "[autopilot] ERROR: not one that does anything headless (e.g. /help, /clear, /compact)."
        if [[ "$run_kind" = "task" ]]; then
            # One bad task must not take the loop down: it is already filed under failed/
            # above, and the next task may be perfectly good.
            echo "[autopilot] ERROR: that queued task is filed under failed/, draining the rest of the queue."
            sleep_for="$QUEUE_DELAY"
        elif [ "$QUEUE" = 1 ]; then
            # The CLAUDE_AUTOPILOT_CMD *fallback* is broken, but the queue half of this
            # container still works. Disable the bogus fallback and carry on as a pure queue
            # consumer rather than spinning on it every interval: killing the loop here would
            # throw away a working queue consumer over a bad fallback.
            echo "[autopilot] ERROR: disabling the CLAUDE_AUTOPILOT_CMD fallback; continuing as a pure"
            echo "[autopilot] ERROR: queue consumer. Fix CLAUDE_AUTOPILOT_CMD and restart to re-enable it."
            PROMPT=""
            sleep_for="$QUEUE_DELAY"
        else
            # No queue, and the one command we have resolves to nothing. There is nothing left
            # for this loop to do. Same contract as the no-command-at-all refusal at startup:
            # say so, and drop to a shell so the operator finds the reason on the pane instead
            # of a dead window.
            echo "[autopilot] ERROR: there is nothing else to run (no task queue enabled)."
            echo "[autopilot] ERROR: Set CLAUDE_AUTOPILOT_CMD to a command this workspace actually"
            echo "[autopilot] ERROR: defines, then rerun:  claude-autopilot"
            echo "[autopilot] ERROR: Dropping to a shell."
            exec bash -l
        fi
    elif [ "$ok" = 1 ]; then
        fails=0
        # Drain the queue fast: if this was a task and more wait, take a short
        # breather instead of the full interval.
        if [[ "$run_kind" = "task" ]] && [ "$(pending_count)" -gt 0 ]; then
            sleep_for="$QUEUE_DELAY"
        else
            sleep_for="$INTERVAL"
        fi
    else
        fails=$((fails + 1))
        # Prefer the actual reset time when the failure is a rate/usage limit:
        # sleeping exactly until reset beats blind backoff for shared-quota
        # throughput. Otherwise exponential backoff, capped, to protect the
        # shared Max quota from a hot failure loop.
        reset_secs="$(seconds_until_reset "$out" "$err")"
        if [[ -n "$reset_secs" ]]; then
            sleep_for=$((reset_secs + 30))   # small buffer past the reset
            echo "[autopilot] run FAILED (consecutive=$fails): rate/usage limit; sleeping until reset (~${reset_secs}s). Log: $out"
        else
            shift_by=$((fails > 4 ? 4 : fails))
            sleep_for=$((INTERVAL * (1 << shift_by)))
            echo "[autopilot] run FAILED (consecutive=$fails): backing off. Log: $out"
        fi
        [ "$sleep_for" -gt "$BACKOFF_MAX" ] && sleep_for="$BACKOFF_MAX"
    fi

    if [ "$MAX_RUNS" != 0 ] && [ "$run" -ge "$MAX_RUNS" ]; then
        echo "[autopilot] reached max_runs=$MAX_RUNS: stopping. Cumulative cost: \$$total_cost"
        break
    fi

    echo "[autopilot] next run in ${sleep_for}s"
    sleep "$sleep_for"
done

echo
echo "[autopilot] loop ended. Dropping to a shell."
echo "Rerun with:  claude-autopilot"
exec bash -l
