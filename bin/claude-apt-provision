#!/usr/bin/env bash
# claude-apt-provision — brokered, curated `apt` for the Sysbox worker tier (PKG-4).
#
# The syslib gap `mise` can't fill: some worker workloads need a Debian *system*
# library (a `.so`) that rootless `mise` toolchains cannot provide. This applies a
# DECLARATIVE, curated, pinned apt manifest as root in a Sysbox *worker*, at worker
# start BEFORE the agent runs, and only ever installs what the committed manifest
# lists. It is the counterpart to PKG-2 (`mise`, rootless) for the root-needing case.
#
# THREE hard properties (see docs/package-provisioning-security.md §4):
#   1. WORKER-ONLY. Installs only when we are root mapped to a NON-root host uid —
#      i.e. inside the Sysbox userns worker (root inside → unprivileged on host⁴).
#      A plain LEAF container (agent runs unprivileged; or a runc-root container
#      whose root maps to host root) gets a DOCUMENTED REFUSAL, never a silent
#      partial: "no root — use mise/static binaries or rebuild the base image".
#   2. CURATED-NOT-OPEN. Only packages in the manifest install. An out-of-manifest
#      request is REFUSED; arbitrary agent-driven `apt` of untrusted repos never
#      runs. A requested package resolves to the manifest's OWN (pinned) spec, so a
#      request can't smuggle a different version than the one curated.
#   3. INSTALL-THEN-RELOCK. `deb.debian.org` / `security.debian.org` egress is
#      opened for the install window (CLAUDE_EGRESS_APT profile) then RE-LOCKED to
#      the default-deny base. All-or-refuse: any failure re-locks and refuses, so a
#      failed/oversized/untrusted request never leaves a half-provisioned OR
#      egress-open worker. (The entrypoint additionally re-runs the general egress
#      lockdown AFTER this, so the final seal does not depend on this relock alone.)
#
# USAGE:
#   claude-apt-provision                 apply the whole curated manifest
#   claude-apt-provision <pkg>...         apply only these (each MUST be in the manifest)
#   claude-apt-provision --check          dry-run: print tier + resolved plan, no side effects
#
# Sourcing this file (BASH_SOURCE test seam) defines the aptp_* functions and
# RETURNS without dispatching — the unit test drives the functions directly with
# no root, no iptables, no apt (APTP_FIREWALL / APTP_APT / CLAUDE_APT_MANIFEST_FILE
# seams). Default off end to end: nothing provisions unless a worker is told to.
set -uo pipefail

APTP_MANIFEST_DEFAULT="/opt/claude-config/apt-manifest.txt"

aptp_log() { echo "[apt-provision] $(date -u +%Y-%m-%dT%H:%M:%SZ) $*" >&2; }

# --- tier gate: root mapped to a non-root host uid = the Sysbox worker -----------------------------
# Root INSIDE is necessary but not sufficient: a plain runc-root container maps
# container-root 0 → host uid 0 (NOT host-safe). The worker tier is userns-mapped
# (0 → non-root host uid), exactly what claude-sysbox-verify §3a proves. Only that
# passes — so both the leaf-agent case (uid != 0) and the runc-root case (host
# base 0) are refused by the same check.
aptp_is_userns_root() {
    [[ "$(id -u)" == 0 ]] || return 1
    local base
    base="$(awk 'NR==1{print $2}' /proc/self/uid_map 2>/dev/null)" || return 1
    [[ -n "$base" && "$base" != 0 ]]
}

aptp_refuse_leaf() {
    aptp_log "REFUSED: not a Sysbox worker (no host-safe root) — apt provisioning is worker-tier only."
    aptp_log "         Use \`mise\` (rootless toolchains/CLIs) or static binaries, or rebuild the base image."
}

# --- manifest: validate strictly, load, resolve --------------------------------------------------
# Debian package name (lowercase alnum + `+ . -`, ≥1 char, alnum start) with an
# optional exact-version pin. Deny by default: no spaces, no `/`, no `..`, no shell
# metacharacters — a malformed entry can neither traverse a path nor inject an arg.
aptp_valid_spec() {
    [[ "$1" =~ ^[a-z0-9][a-z0-9+.-]*(=[A-Za-z0-9][A-Za-z0-9+.~:_-]*)?$ ]]
}

aptp_manifest_file() { echo "${CLAUDE_APT_MANIFEST_FILE:-$APTP_MANIFEST_DEFAULT}"; }

# aptp_load_manifest — emit the validated specs (one per line). An absent file is a
# legitimate empty manifest (nothing to do). A malformed entry fails the WHOLE load
# closed (return 2) — all-or-refuse, never a partial apply from a half-bad manifest.
aptp_load_manifest() {
    local file; file="$(aptp_manifest_file)"
    if [[ ! -f "$file" ]]; then
        # An EXPLICIT override that doesn't resolve is a misconfiguration (e.g. a
        # broker-host path that isn't present in the worker) — fail closed rather
        # than silently install nothing while a syslib was expected. The baked
        # DEFAULT path being absent is a legitimate empty manifest (a no-op).
        if [[ -n "${CLAUDE_APT_MANIFEST_FILE:-}" ]]; then
            aptp_log "REFUSED: CLAUDE_APT_MANIFEST_FILE='$file' does not exist in this container — misconfigured override, fail closed (a manifest path must resolve INSIDE the worker)"
            return 2
        fi
        aptp_log "manifest '$file' not found — empty (nothing to provision)"
        return 0
    fi
    local raw stripped lineno=0
    while IFS= read -r raw || [[ -n "$raw" ]]; do
        lineno=$((lineno+1))
        stripped="${raw%%#*}"                              # strip comment
        stripped="${stripped#"${stripped%%[![:space:]]*}"}" # ltrim
        stripped="${stripped%"${stripped##*[![:space:]]}"}" # rtrim
        [[ -z "$stripped" ]] && continue
        if ! aptp_valid_spec "$stripped"; then
            aptp_log "REFUSED: malformed manifest entry '$stripped' ($file line $lineno) — fail closed"
            return 2
        fi
        printf '%s\n' "$stripped"
    done < "$file"
}

# aptp_resolve_specs [pkg...] — the specs to install. No args ⇒ the whole manifest.
# With args ⇒ each requested NAME must appear in the manifest; the emitted spec is
# the MANIFEST's own (pinned) entry, so a request can't smuggle an alternate version.
aptp_resolve_specs() {
    local -a manifest
    mapfile -t manifest < <(aptp_load_manifest) || return $?
    # aptp_load_manifest ran in a subshell (process substitution); its non-zero
    # return is lost to `mapfile`. Re-check explicitly so a malformed manifest refuses.
    aptp_load_manifest >/dev/null || return $?
    if (($# == 0)); then
        # Emit nothing for a zero-element manifest — `printf '%s\n' "${arr[@]}"`
        # with NO args still runs the format once and prints a lone blank line,
        # which a caller's `mapfile` would read back as one empty-string element
        # (→ a bogus `apt-get install ''`). Guard on the count so empty stays empty.
        ((${#manifest[@]})) && printf '%s\n' "${manifest[@]}"
        return 0
    fi
    local req name m found
    for req in "$@"; do
        name="${req%%=*}"
        found=""
        for m in "${manifest[@]}"; do
            [[ "${m%%=*}" == "$name" ]] && { found="$m"; break; }
        done
        if [[ -z "$found" ]]; then
            aptp_log "REFUSED: '$name' is not in the curated apt manifest ($(aptp_manifest_file)) — only curated packages install"
            return 2
        fi
        printf '%s\n' "$found"
    done
}

# --- egress window: open the debian mirrors, then re-lock ----------------------------------------
aptp_lockdown_on() { [[ "${CLAUDE_EGRESS_LOCKDOWN:-0}" =~ ^(1|true|yes|on)$ ]]; }
aptp_firewall() { "${APTP_FIREWALL:-/usr/local/bin/claude-egress-firewall}"; }

# Open: re-apply the firewall WITH the apt profile (default-deny + debian mirrors).
# If egress lockdown is off there is no firewall to change — egress is already open,
# so the window is a no-op (and the relock below is likewise a no-op).
aptp_open_egress() {
    if ! aptp_lockdown_on; then
        aptp_log "egress lockdown off — apt window needs no firewall change (egress already open)"
        return 0
    fi
    aptp_log "opening apt egress window (deb.debian.org / security.debian.org)"
    CLAUDE_EGRESS_APT=1 aptp_firewall
}

# Relock: re-apply the firewall WITHOUT the apt profile (debian mirrors dropped).
aptp_relock_egress() {
    aptp_lockdown_on || return 0
    aptp_log "re-locking egress (dropping debian mirrors from the allowlist)"
    aptp_firewall
}

# --- install -------------------------------------------------------------------------------------
aptp_apt_install() {
    aptp_log "apt-get install: $*"
    local apt="${APTP_APT:-apt-get}"
    DEBIAN_FRONTEND=noninteractive "$apt" update -o Acquire::Retries=3 >/dev/null || return 1
    # `--` ends option parsing: even though the validator already refuses a
    # leading-dash spec, this guarantees no spec is ever read as an apt flag.
    DEBIAN_FRONTEND=noninteractive "$apt" install -y --no-install-recommends -- "$@" || return 1
}

# --- orchestrator ---------------------------------------------------------------------------------
# Refuse-if-leaf → resolve curated specs → (open window → install → relock). The
# relock ALWAYS runs after an opened window, whatever the install did, so no exit
# path leaves an egress-open worker.
aptp_provision() {
    if ! aptp_is_userns_root; then
        aptp_refuse_leaf
        return 3
    fi
    local -a specs raw
    mapfile -t raw < <(aptp_resolve_specs "$@") || return $?
    aptp_resolve_specs "$@" >/dev/null || return $?   # propagate a refusal the subshell swallowed
    # Defensive: drop any empty element so an empty package name can never reach
    # `apt-get install` even if resolution regresses (belt-and-suspenders on the
    # empty-manifest guard above).
    local s; specs=(); for s in "${raw[@]}"; do [[ -n "$s" ]] && specs+=("$s"); done
    if ((${#specs[@]} == 0)); then
        aptp_log "curated manifest is empty — nothing to provision (ok)"
        return 0
    fi
    if ! aptp_open_egress; then
        aptp_log "FAILED to open the apt egress window — refusing (no install attempted)"
        aptp_relock_egress || true
        return 4
    fi
    local rc=0
    aptp_apt_install "${specs[@]}" || rc=5
    if ! aptp_relock_egress; then
        aptp_log "ERROR: egress relock FAILED — egress may be OPEN (claude-egress-firewall fails OPEN by design). When invoked via the entrypoint its general lockdown re-seals; a STANDALONE caller MUST re-lock egress itself."
        (( rc == 0 )) && rc=6
    fi
    if (( rc == 0 )); then
        aptp_log "provisioned ${#specs[@]} curated package(s); egress re-locked"
    else
        aptp_log "provisioning FAILED (rc=$rc) — worker left with egress re-locked, no partial trust"
    fi
    return $rc
}

# --- dry-run seam: print the plan, touch nothing --------------------------------------------------
aptp_check() {
    local tier="leaf/non-worker (would REFUSE)"
    aptp_is_userns_root 2>/dev/null && tier="sysbox-worker (root → non-root host uid)"
    echo "tier: $tier"
    echo "manifest: $(aptp_manifest_file)"
    echo "egress-lockdown: $(aptp_lockdown_on && echo on || echo off)"
    local -a specs
    if mapfile -t specs < <(aptp_resolve_specs "$@") && aptp_resolve_specs "$@" >/dev/null 2>&1; then
        if ((${#specs[@]} == 0)); then
            echo "plan: (empty manifest — nothing would install)"
        else
            echo "plan: ${specs[*]}"
        fi
    else
        echo "plan: REFUSED (see [apt-provision] lines)"
    fi
}

aptp_main() {
    case "${1:-}" in
        --check|--print-plan) shift; aptp_check "$@" ;;
        -h|--help) sed -n '2,40p' "$0" ;;
        --) shift; aptp_provision "$@" ;;
        -*) aptp_log "unknown flag '$1'"; return 64 ;;
        *) aptp_provision "$@" ;;
    esac
}

# Test seam: when sourced, define the functions and return without dispatching.
(return 0 2>/dev/null) && return 0
aptp_main "$@"
