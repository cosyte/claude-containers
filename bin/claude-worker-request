#!/usr/bin/env bash
# claude-worker-request — the agent-side client for the worker broker (CC-2).
#
#   claude-worker-request <repo> <item-id> [--timeout SECS]
#
# Asks the ROOT-owned claude-worker-broker to launch one nested worker for
# (repo, item). This is the narrow channel by design: the unprivileged (prompt-
# injectable) agent never touches the inner Docker socket and cannot influence
# the launch template — a request carries exactly two sanitized values, nothing
# else. The broker validates deny-by-default and answers `ok <container>` or
# `error <reason>`.
#
# Deliberately dependency-free (no _common.sh, no docker): it must run as the
# unprivileged user in a minimal controller. Protocol: write KEY=VALUE lines to
# a dot-tmpfile in the spool (dotfiles are invisible to the broker), atomically
# mv it live, then poll for the response file.
set -euo pipefail

die() { echo "claude-worker-request: error: $*" >&2; exit 1; }

BROKER_DIR="${CLAUDE_BROKER_DIR:-/run/claude/broker}"
TIMEOUT=60
REPO="" ITEM=""

while (( $# )); do
    case "$1" in
        --timeout) shift; TIMEOUT="${1:-}" ;;
        --help|-h) echo "usage: claude-worker-request <repo> <item-id> [--timeout SECS]"; exit 0 ;;
        -*) die "unknown flag '$1'" ;;
        *)  if   [[ -z "$REPO" ]]; then REPO="$1"
            elif [[ -z "$ITEM" ]]; then ITEM="$1"
            else die "unexpected argument '$1'"; fi ;;
    esac
    shift
done

[[ -n "$REPO" && -n "$ITEM" ]] || die "usage: claude-worker-request <repo> <item-id> [--timeout SECS]"
[[ "$TIMEOUT" =~ ^[0-9]+$ ]] || die "--timeout must be an integer (got '$TIMEOUT')"

# Same value rule the broker enforces — fail fast client-side with a better message.
VALUE_RE='^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$'
[[ "$REPO" =~ $VALUE_RE ]] || die "repo '$REPO' is not a plain name (letters/digits/._- only, 64 max, alnum first)"
[[ "$ITEM" =~ $VALUE_RE ]] || die "item '$ITEM' is not a plain id (letters/digits/._- only, 64 max, alnum first)"

REQ_DIR="$BROKER_DIR/requests"
RES_DIR="$BROKER_DIR/responses"
[[ -d "$REQ_DIR" ]] || die "broker spool $REQ_DIR not found — is claude-worker-broker running on this controller?"

REQID="req-$$-$(date +%s)-$RANDOM"
TMP="$REQ_DIR/.tmp-$REQID"
printf 'repo=%s\nitem=%s\n' "$REPO" "$ITEM" > "$TMP" || die "cannot write into the request spool"
mv "$TMP" "$REQ_DIR/$REQID"

deadline=$(( $(date +%s) + TIMEOUT ))
RES="$RES_DIR/$REQID"
while [[ ! -f "$RES" ]]; do
    (( $(date +%s) >= deadline )) && die "no broker response within ${TIMEOUT}s (request $REQID)"
    sleep 0.2
done

resp="$(cat "$RES")"
echo "$resp"
[[ "$resp" == ok\ * ]] || exit 1
