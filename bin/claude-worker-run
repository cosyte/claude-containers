#!/usr/bin/env bash
# claude-worker-run <repo> <item-id> — the one-shot entrypoint for an EPHEMERAL worker (CC-4).
#
# This replaces the CC-2 broker's placeholder `sleep infinity` (CLAUDE_BROKER_WORKER_CMD): the
# broker launches a worker container with `--rm` and this script AS its command, trailed by the
# validated <repo> <item-id> the broker put in fixed argv positions (never a flag — see
# bin/claude-worker-broker broker_launch / broker_template_args). It runs INSIDE that worker
# container, isolates the submodule, heartbeats the item's lease best-effort, drives EXACTLY ONE
# `/work-on <repo> <item>`, and exits with that run's status — the container is `--rm`, so a
# normal exit makes the worker vanish with no residue (bin/claude-reaper mops up anything an
# unclean exit leaves behind).
#
# Flow:
#   1. validate argv: exactly 2 args, each matching the broker's charset
#      ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ (the same values the broker already validated — this is
#      belt-and-suspenders, since a worker could in principle be driven directly in a test/debug
#      context, not just via the broker).
#   2. locate the umbrella (CLAUDE_WORKER_UMBRELLA env, else /workspace) and `cd` there —
#      fail-closed if neither looks like a real umbrella superproject.
#   3. confirm <repo> is a real submodule (a `path = <repo>` line in .gitmodules) — refuse
#      otherwise (never isolate/run an unknown or malicious repo name).
#   4. materialize the isolated worktree via scripts/isolate.sh <repo> <item>, export
#      COSYTE_WORKTREE — the isolation contract /work-on itself builds on (PAR-0.1).
#   5. start a best-effort background lease-heartbeat loop (scripts/lease.sh renew <item>
#      <worker-id> every CLAUDE_WORKER_HEARTBEAT_SECS) IF lease.sh exists — never fails the run
#      if it's absent or a renew fails; killed via a trap on EXIT.
#   6. run EXACTLY ONE `/work-on <repo> <item>` via `claude -p … --output-format json`, mirroring
#      bin/claude-autopilot's perm_flags/model_flags + total_cost_usd/is_error accounting.
#   7. exit with /work-on's exit status (a "your item is already shipped" run is a normal, clean
#      exit — not special-cased beyond honoring the code the CLI itself returns).
#
# Env:
#   CLAUDE_WORKER_UMBRELLA        umbrella root override (default: /workspace if it looks right)
#   CLAUDE_WORKER_ID              this worker's lease-holder id (default: `hostname`)
#   CLAUDE_WORKER_HEARTBEAT_SECS  seconds between lease renewals   (default 60)
#   CLAUDE_WORKER_CLAUDE_BIN      the `claude` binary to invoke    (default: claude)
#   CLAUDE_PERMISSION_MODE / CLAUDE_MODEL / CLAUDE_EXTRA_ARGS   — same meaning as claude-autopilot
#   CLAUDE_WORKER_RUN_LOG_DIR     where the one-shot run's JSON log goes
#                                 (default $HOME/.claude/worker-run-logs)
#
# Test seam — UNIT TESTS ONLY, loudly warned when active:
#   CLAUDE_WORKER_RUN_DRYRUN=1   prints the resolved isolate + claude invocation (argv) and the
#                                heartbeat plan instead of running them, then exits 0 — no docker,
#                                no umbrella, no claude, no network. Exercises argv validation and
#                                the run-exactly-once path.
#
# Sourcing this file defines the worker_run_* functions and returns (the unit-test seam);
# executing it runs the one-shot worker.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_common.sh"

WORKER_RUN_VALUE_RE='^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$'

# --- 1. argv validation --------------------------------------------------------------------------
worker_run_validate_args() {
    (( $# == 2 )) || die "usage: claude-worker-run <repo> <item-id> (got $# args)"
    local repo="$1" item="$2"
    [[ "$repo" =~ $WORKER_RUN_VALUE_RE ]] || die "invalid <repo> '$repo' — must match $WORKER_RUN_VALUE_RE"
    [[ "$item" =~ $WORKER_RUN_VALUE_RE ]] || die "invalid <item-id> '$item' — must match $WORKER_RUN_VALUE_RE"
    WR_REPO="$repo"; WR_ITEM="$item"
}

# --- 2. locate the umbrella, fail-closed ---------------------------------------------------------
# A directory "looks like the umbrella" iff it has BOTH .gitmodules and scripts/isolate.sh — the
# two things this script actually depends on. Never guess past that; an absent/wrong umbrella dies
# rather than silently isolating/running against the wrong tree.
worker_run_looks_like_umbrella() {
    local d="$1"
    [[ -f "$d/.gitmodules" && -f "$d/scripts/isolate.sh" ]]
}

worker_run_locate_umbrella() {
    local cand="${CLAUDE_WORKER_UMBRELLA:-}"
    if [[ -n "$cand" ]]; then
        worker_run_looks_like_umbrella "$cand" \
            || die "CLAUDE_WORKER_UMBRELLA='$cand' does not look like the umbrella (need .gitmodules + scripts/isolate.sh) — refusing (fail closed)"
        WR_UMBRELLA="$cand"
        return 0
    fi
    if worker_run_looks_like_umbrella /workspace; then
        WR_UMBRELLA=/workspace
        return 0
    fi
    die "no umbrella found — set CLAUDE_WORKER_UMBRELLA or run in a container with the umbrella checked out at /workspace (fail closed)"
}

# --- 3. confirm <repo> is a real submodule --------------------------------------------------------
worker_run_check_submodule() {
    local umbrella="$1" repo="$2"
    grep -qE "^[[:space:]]*path[[:space:]]*=[[:space:]]*${repo}[[:space:]]*\$" "$umbrella/.gitmodules" \
        || die "'$repo' is not a submodule listed in $umbrella/.gitmodules — refusing to isolate/run an unknown repo"
}

# --- 4. materialize the isolated worktree ---------------------------------------------------------
worker_run_isolate() {
    local umbrella="$1" repo="$2" item="$3"
    local wt
    wt="$("$umbrella/scripts/isolate.sh" "$repo" "$item")" \
        || die "scripts/isolate.sh $repo $item failed — cannot materialize an isolated worktree"
    [[ -n "$wt" ]] || die "scripts/isolate.sh $repo $item produced no path"
    WR_WORKTREE="$wt"
}

# --- 5. best-effort lease-heartbeat loop -----------------------------------------------------------
# Never fails the run: absent lease.sh, or any renew failure, is a single loud warn — the run
# proceeds. The loop's PID is tracked in WR_HEARTBEAT_PID so the caller can kill it on EXIT.
worker_run_heartbeat_loop() {
    local umbrella="$1" item="$2" worker_id="$3" interval="$4"
    while :; do
        sleep "$interval"
        if ! bash "$umbrella/scripts/lease.sh" renew "$item" "$worker_id" >/dev/null 2>&1; then
            warn "lease renew failed for item=$item worker=$worker_id (best-effort; continuing)"
        fi
    done
}

worker_run_start_heartbeat() {
    local umbrella="$1" item="$2"
    WR_HEARTBEAT_PID=""
    local lease_sh="$umbrella/scripts/lease.sh"
    if [[ ! -f "$lease_sh" ]]; then
        warn "scripts/lease.sh not found — lease heartbeat disabled (best-effort, continuing without it)"
        return 0
    fi
    local worker_id="${CLAUDE_WORKER_ID:-$(hostname 2>/dev/null || echo unknown-worker)}"
    local interval="${CLAUDE_WORKER_HEARTBEAT_SECS:-60}"
    [[ "$interval" =~ ^[0-9]+$ ]] && (( interval > 0 )) \
        || die "CLAUDE_WORKER_HEARTBEAT_SECS '$interval' is not a positive integer"
    worker_run_heartbeat_loop "$umbrella" "$item" "$worker_id" "$interval" &
    WR_HEARTBEAT_PID=$!
    info "lease heartbeat: renewing item=$item worker=$worker_id every ${interval}s (pid $WR_HEARTBEAT_PID)"
}

worker_run_stop_heartbeat() {
    [[ -n "${WR_HEARTBEAT_PID:-}" ]] || return 0
    kill "$WR_HEARTBEAT_PID" >/dev/null 2>&1 || true
    wait "$WR_HEARTBEAT_PID" 2>/dev/null || true
}

# --- 6. perm/model flags — same logic as bin/claude-autopilot ------------------------------------
worker_run_perm_flags() {
    local mode="${CLAUDE_PERMISSION_MODE:-bypassPermissions}"
    case "$mode" in
        bypassPermissions|bypass|"") printf '%s' '--dangerously-skip-permissions' ;;
        *)                           printf '%s %s' '--permission-mode' "$mode" ;;
    esac
}
worker_run_model_flags() {
    # Must ALWAYS return 0: this output is captured by a plain `model="$(…)"`
    # assignment, so a `[[ … ]] && printf` last-statement (false when CLAUDE_MODEL
    # is unset — the default) would trip the caller's `set -e` on the DRYRUN path
    # (which runs directly, not under `|| rc=$?`). Same hazard the reaper guards.
    local model="${CLAUDE_MODEL:-}"
    if [[ -n "$model" ]]; then printf '%s %s' '--model' "$model"; fi
    return 0
}

# --- 6. run exactly one /work-on -------------------------------------------------------------------
worker_run_exec_once() {
    local repo="$1" item="$2"
    local claude_bin="${CLAUDE_WORKER_CLAUDE_BIN:-claude}"
    local prompt="/work-on $repo $item"
    local log_dir="${CLAUDE_WORKER_RUN_LOG_DIR:-$HOME/.claude/worker-run-logs}"
    mkdir -p "$log_dir"
    local ts out
    ts="$(date -u +%Y%m%dT%H%M%SZ)"
    out="$log_dir/run-$item-$ts.json"

    local perm model
    perm="$(worker_run_perm_flags)"
    model="$(worker_run_model_flags)"
    local extra="${CLAUDE_EXTRA_ARGS:-}"

    info "worker-run: item=$item repo=$repo — running EXACTLY ONE /work-on"
    local rc=0
    # shellcheck disable=SC2086  # flag vars are intentionally word-split, mirrors claude-autopilot
    "$claude_bin" -p "$prompt" $perm $model --output-format json $extra >"$out" 2>&1 || rc=$?

    local is_error=false cost=0
    if command -v jq >/dev/null 2>&1; then
        is_error="$(jq -r '.is_error // false' "$out" 2>/dev/null || echo false)"
        cost="$(jq -r '.total_cost_usd // 0' "$out" 2>/dev/null || echo 0)"
    fi
    if (( rc == 0 )) && [[ "$is_error" != "true" ]]; then
        ok "worker-run: item=$item repo=$repo — /work-on succeeded (cost \$$cost). Log: $out"
    else
        err "worker-run: item=$item repo=$repo — /work-on FAILED (exit $rc, is_error=$is_error, cost \$$cost). Log: $out"
        [[ "$rc" == 0 ]] && rc=1
    fi
    return "$rc"
}

# --- test seam: DRYRUN — print the plan, run nothing, exit 0 ---------------------------------------
worker_run_dryrun() {
    local repo="$1" item="$2"
    warn "TEST SEAM ACTIVE: CLAUDE_WORKER_RUN_DRYRUN=1 — printing the resolved plan, NOT isolating/running anything"
    echo "umbrella: ${CLAUDE_WORKER_UMBRELLA:-/workspace}"
    echo "repo: $repo"
    echo "item: $item"
    echo "isolate: scripts/isolate.sh $repo $item"
    local worker_id="${CLAUDE_WORKER_ID:-$(hostname 2>/dev/null || echo unknown-worker)}"
    local interval="${CLAUDE_WORKER_HEARTBEAT_SECS:-60}"
    echo "heartbeat: scripts/lease.sh renew $item $worker_id every ${interval}s (if scripts/lease.sh exists)"
    local perm model
    perm="$(worker_run_perm_flags)"
    model="$(worker_run_model_flags)"
    echo "claude: ${CLAUDE_WORKER_CLAUDE_BIN:-claude} -p \"/work-on $repo $item\" $perm $model --output-format json ${CLAUDE_EXTRA_ARGS:-}"
    echo "run-count: 1 (exactly once, never a loop)"
}

# --- main -------------------------------------------------------------------------------------------
worker_run_main() {
    worker_run_validate_args "$@"

    if [[ "${CLAUDE_WORKER_RUN_DRYRUN:-0}" == 1 ]]; then
        worker_run_dryrun "$WR_REPO" "$WR_ITEM"
        exit 0
    fi

    worker_run_locate_umbrella
    cd "$WR_UMBRELLA" || die "could not cd into umbrella '$WR_UMBRELLA'"
    worker_run_check_submodule "$WR_UMBRELLA" "$WR_REPO"
    worker_run_isolate "$WR_UMBRELLA" "$WR_REPO" "$WR_ITEM"
    export COSYTE_WORKTREE="$WR_WORKTREE"
    info "worker-run: isolated worktree ready at $COSYTE_WORKTREE"

    worker_run_start_heartbeat "$WR_UMBRELLA" "$WR_ITEM"
    trap worker_run_stop_heartbeat EXIT

    local rc=0
    worker_run_exec_once "$WR_REPO" "$WR_ITEM" || rc=$?
    exit "$rc"
}

# Executed → run the one-shot worker; sourced → expose the functions for unit tests.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    worker_run_main "$@"
fi
