#!/usr/bin/env bash
# claude-reaper — prune aged spool litter from a request/response spool directory.
#
# SC-5 removed this reaper's other duty — reaping exited/dead/created `claude.worker=1`
# containers the (now-deleted) worker broker's `--rm` launches could still leave behind on
# an unclean exit. That duty is gone along with the broker/worker substrate it served (see
# docs/legacy-sysbox-broker.md). What's left is a standalone, generic spool-pruning utility:
# aged files under a spool directory's responses/requests/staging subdirectories are
# reclaimed, `.lock` is never touched. Idempotent and fail-safe (never `die` mid-reap; a
# prune error is a loud warn and the reap continues). No entrypoint path currently starts
# this — it previously ran only inside the retired broker/controller mode; run it by hand or
# on your own cron/timer against whatever spool-shaped directory you point it at.
#
# Usage:
#   bin/claude-reaper           one-shot: reap once, print counts, exit 0
#   bin/claude-reaper --loop    reap every CLAUDE_REAPER_INTERVAL seconds, forever
#
# Env:
#   CLAUDE_REAPER_SPOOL_DIR     spool root to prune       (default /run/claude/reaper-spool)
#   CLAUDE_REAPER_INTERVAL      seconds between --loop cycles (default 300)
#   CLAUDE_REAPER_SPOOL_TTL     seconds before a spool file is prunable (default 3600)
#
# Test seam — UNIT TESTS / OPERATOR DRY-RUNS ONLY, loudly warned when active:
#   CLAUDE_REAPER_DRYRUN=1   prints what WOULD be pruned, prunes nothing
#
# Sourcing this file defines the reaper_* functions and returns (the unit-test seam);
# executing it runs a one-shot or --loop reap.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_common.sh"

# --- stale spool files -------------------------------------------------------------------
# Prints one path per line — files reaper_once should prune. Guards missing dirs (no-op,
# not an error: a spool that was never populated has nothing to prune). Never touches
# .lock. Uses find -type f -mmin so it is robust to clock skew/relative age rather than
# parsing stat output by hand.
reaper_stale_spool_files() {
    local spool_dir="$1" ttl="$2" mmin d
    mmin=$(( ttl / 60 ))
    (( mmin < 1 )) && mmin=1
    for d in responses requests staging; do
        [[ -d "$spool_dir/$d" ]] || continue
        find "$spool_dir/$d" -type f -mmin "+$mmin" -print 2>/dev/null || true
    done
    return 0
}

# --- driver -------------------------------------------------------------------------------
# reaper_once — prune once, report counts. Never dies: a prune failure is warned and the
# rest of the sweep still runs. Returns 0 always (a bad cycle under --loop must log and
# continue, not abort the loop).
reaper_once() {
    local spool_dir="${CLAUDE_REAPER_SPOOL_DIR:-/run/claude/reaper-spool}"
    local ttl="${CLAUDE_REAPER_SPOOL_TTL:-3600}"
    [[ "$ttl" =~ ^[0-9]+$ ]] || { warn "reaper: CLAUDE_REAPER_SPOOL_TTL '$ttl' is not a positive integer — using the default 3600"; ttl=3600; }

    local dryrun=0
    if [[ "${CLAUDE_REAPER_DRYRUN:-0}" == 1 ]]; then
        warn "TEST SEAM ACTIVE: CLAUDE_REAPER_DRYRUN=1 — reporting what WOULD be pruned, changing nothing"
        dryrun=1
    fi

    local pruned=0 prune_failed=0 f
    while IFS= read -r f; do
        [[ -n "$f" ]] || continue
        # Never .lock, whatever TTL/find turns up — belt and suspenders on top of
        # reaper_stale_spool_files only walking responses/requests/staging.
        [[ "$(basename "$f")" == .lock ]] && continue
        if (( dryrun )); then
            echo "would prune spool file: $f"
            pruned=$((pruned + 1))
            continue
        fi
        if rm -f "$f" 2>/dev/null; then
            pruned=$((pruned + 1))
        else
            warn "reaper: could not prune spool file $f — leaving it, continuing"
            prune_failed=$((prune_failed + 1))
        fi
    done < <(reaper_stale_spool_files "$spool_dir" "$ttl" || true)

    if (( dryrun )); then
        ok "reaper (dry-run): would prune $pruned spool file(s)"
    else
        ok "reaper: pruned $pruned spool file(s) (failed: $prune_failed)"
    fi
    return 0
}

reaper_main() {
    local loop=0
    local a
    for a in "$@"; do
        case "$a" in
            --loop) loop=1 ;;
            *) die "unknown flag '$a' (usage: claude-reaper [--loop])" ;;
        esac
    done

    if (( ! loop )); then
        reaper_once
        return 0
    fi

    local interval="${CLAUDE_REAPER_INTERVAL:-300}"
    [[ "$interval" =~ ^[0-9]+$ ]] && (( interval > 0 )) \
        || die "CLAUDE_REAPER_INTERVAL '$interval' is not a positive integer"
    info "reaper: looping every ${interval}s (Ctrl-C / SIGTERM to stop)"
    while :; do
        # A bad cycle must log and continue — never take the loop down.
        reaper_once || warn "reaper: a reap cycle failed unexpectedly — continuing the loop"
        sleep "$interval"
    done
}

# Executed → run the reaper; sourced → expose the functions for unit tests.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    reaper_main "$@"
fi
