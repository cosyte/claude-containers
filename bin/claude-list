#!/usr/bin/env bash
# claude-list — table of all claude-* containers.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_common.sh"
need_docker

# `{{.Status}}` carries both uptime and the healthcheck verdict, e.g.
# "Up 2 hours (healthy)" / "Up 5 minutes (unhealthy)" — (unhealthy) means the
# Claude session or its Remote Control link is down (see docs/troubleshooting.md).
fmt='{{.Names}}\t{{.State}}\t{{.Label "claude.ssh_port"}}\t{{.Label "claude.repo"}}\t{{.Status}}'
rows="$(docker ps -a --filter 'label=claude.managed=1' --format "$fmt" 2>/dev/null || true)"

if [[ -z "$rows" ]]; then
    info "No claude-* containers. Create one with: claude-launch <name> --repo <url>"
    exit 0
fi

table="$(printf 'NAME\tSTATE\tSSH PORT\tREPO\tSTATUS\n%s\n' "$rows")"
# `column` is in util-linux/bsdmainutils and not always present; fall back to
# an awk pass that measures each column so it always renders aligned (kept
# mawk-compatible: single-dim arrays + split, no gawk-only features).
if command -v column >/dev/null 2>&1; then
    echo "$table" | column -t -s $'\t'
else
    echo "$table" | awk -F'\t' '
        { line[NR]=$0
          for (i=1;i<=NF;i++) if (length($i)>w[i]) w[i]=length($i)
          if (NF>nf) nf=NF }
        END {
          for (r=1;r<=NR;r++) {
            split(line[r], c, "\t"); out=""
            for (i=1;i<=nf;i++) out=out sprintf("%-*s", (i<nf?w[i]+2:0), c[i])
            print out
          }
        }'
fi
