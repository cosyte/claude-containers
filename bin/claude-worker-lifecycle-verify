#!/usr/bin/env bash
# claude-worker-lifecycle-verify — prove the ephemeral worker lifecycle on a real
# controller (CC-4): claude-worker-run's one-shot-then-vanish contract and
# bin/claude-reaper's orphan-removal + spool-prune duties.
#
# Complements bin/claude-broker-verify (CC-2, the broker's launch/lease contract) and
# bin/claude-sizing-verify (CC-3, resource isolation) with CC-4's lifecycle proof
# (roadmap operations/roadmaps/claude-containers.md §8 CC-4):
#
#   1. a broker-launched worker, driven by a trivial stub in place of the real
#      claude-worker-run (via CLAUDE_BROKER_WORKER_CMD — the same seam the broker
#      documents), runs once and then the container is GONE (--rm; no residue);
#   2. a worker killed with SIGKILL (simulating an unclean crash) is left behind as an
#      exited container — the reaper removes it and frees the container name for a
#      re-request of the same item;
#   3. the reaper is idempotent: a second reap over the same (now-clean) state is a
#      no-op;
#   4. spool hygiene: an aged responses/ file is pruned, a fresh one is kept, and .lock
#      is never touched.
#
# Needs Sysbox + the broker proven first (run bin/claude-sysbox-verify and
# bin/claude-broker-verify before this). The docker-free logic tests (arg validation,
# reaper selection over a fake spool) live in test/worker-run-unit.sh and
# test/reaper-unit.sh (CI); this is the on-host gate for the parts that only a real
# inner daemon can prove — a real broker-launched worker actually vanishing, a real
# kill -9 actually leaving exited-container residue for the reaper to find.
#
#   bin/claude-worker-lifecycle-verify --check   arg validation + reaper selection
#                                                 over a FAKE spool (safe anywhere,
#                                                 no docker/sysbox needed)
#   bin/claude-worker-lifecycle-verify           full on-host proof (needs Sysbox)
#   bin/claude-worker-lifecycle-verify --keep    leave the controller running
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_common.sh"

# This script PROVES the gate — no ambient/leftover seam may neutralize it.
unset CLAUDE_SYSBOX_FAKE_VERSION CLAUDE_SYSBOX_SKIP_DOCKER \
      CLAUDE_BROKER_FAKE_UID_MAP CLAUDE_BROKER_SKIP_ROOT CLAUDE_BROKER_DRYRUN \
      CLAUDE_BROKER_FAKE_CGROUP_DIR CLAUDE_REAPER_DRYRUN CLAUDE_WORKER_RUN_DRYRUN

CHECK_ONLY=0
KEEP=0
for a in "$@"; do
    case "$a" in
        --check) CHECK_ONLY=1 ;;
        --keep)  KEEP=1 ;;
        *) die "unknown flag '$a' (usage: claude-worker-lifecycle-verify [--check] [--keep])" ;;
    esac
done

PASS=0 FAIL=0
okp()  { echo "  PASS  $*"; PASS=$((PASS+1)); }
badp() { echo "  FAIL  $*"; FAIL=$((FAIL+1)); }

# --- phase 0: --check — safe anywhere, no docker/sysbox --------------------------------
info "phase 0 — arg validation + reaper selection over a fake spool (--check-safe)"

TMPD="$(mktemp -d)"
trap '[[ -n "${CTR:-}" ]] && { (( KEEP )) || docker rm -f "$CTR" >/dev/null 2>&1 || true; }; rm -rf "$TMPD"' EXIT

# 0a. claude-worker-run argv validation (the same charset the broker enforces).
if ( CLAUDE_WORKER_RUN_DRYRUN=1 bash "$CLAUDE_DOCKER_ROOT/bin/claude-worker-run" hl7 CC-4-CHECK >/dev/null 2>&1 ); then
    okp "claude-worker-run accepts a well-formed <repo> <item> under DRYRUN"
else
    badp "claude-worker-run must accept a well-formed <repo> <item> under DRYRUN"
fi
if ( CLAUDE_WORKER_RUN_DRYRUN=1 bash "$CLAUDE_DOCKER_ROOT/bin/claude-worker-run" 'hl7 --privileged' CC-4 >/dev/null 2>&1 ); then
    badp "claude-worker-run must refuse a flag-smuggling repo argument"
else
    okp "claude-worker-run refuses a flag-smuggling repo argument"
fi
onejob="$(CLAUDE_WORKER_RUN_DRYRUN=1 bash "$CLAUDE_DOCKER_ROOT/bin/claude-worker-run" hl7 CC-4-CHECK 2>/dev/null)"
if [[ "$(grep -c '/work-on' <<<"$onejob")" == 1 ]]; then
    okp "claude-worker-run's DRYRUN plan names /work-on EXACTLY ONCE"
else
    badp "claude-worker-run's DRYRUN plan must name /work-on exactly once (got $(grep -c '/work-on' <<<"$onejob"))"
fi

# 0b. reaper selection logic over a FAKE spool — no docker needed for this half.
# Sourced in a FRESH subshell (bash -c), not into this process: this script has
# already sourced _common.sh once, and claude-reaper sources it again — bash treats
# a repeated `readonly VAR=` (the SYSBOX_CVE_FLOOR guard in _common.sh) as a fatal
# error under `set -e` even inside the `if !` meant to catch it, so the two sources
# must land in separate shells, never the same one.
FAKED="$TMPD/spool"
mkdir -p "$FAKED/requests" "$FAKED/responses" "$FAKED/staging"
got="$(bash -c '
    source "'"$CLAUDE_DOCKER_ROOT"'/bin/claude-reaper"
    reaper_docker() {
        case "$*" in
            *"status=exited"*) echo "exited123" ;;
            *"status=dead"*)   echo "" ;;
            *"status=created"*) echo "" ;;
            *) return 1 ;;
        esac
    }
    reaper_exited_workers')"
if [[ "$got" == "exited123" ]]; then
    okp "reaper_exited_workers selects an exited container id from a stubbed docker ps"
else
    badp "reaper_exited_workers must select 'exited123' (got '$got')"
fi

: > "$FAKED/responses/old-resp"; touch -d '2 hours ago' "$FAKED/responses/old-resp"
: > "$FAKED/responses/new-resp"
: > "$FAKED/.lock"
stale="$(bash -c '
    source "'"$CLAUDE_DOCKER_ROOT"'/bin/claude-reaper"
    reaper_stale_spool_files "'"$FAKED"'" 3600')"
if grep -q "old-resp" <<<"$stale" && ! grep -q "new-resp" <<<"$stale" && ! grep -q '\.lock$' <<<"$stale"; then
    okp "reaper_stale_spool_files selects the aged file, keeps the fresh file and .lock"
else
    badp "reaper_stale_spool_files selection wrong (got: $stale)"
fi

if (( CHECK_ONLY )); then
    echo
    echo "== $PASS passed, $FAIL failed =="
    (( FAIL == 0 )) || { err "lifecycle --check NOT proven"; exit 1; }
    ok "lifecycle --check passed — run without --check for the full on-host proof (needs Sysbox + the broker)"
    exit 0
fi

# --- phase 1: stand up a controller + broker (mirrors claude-broker-verify) -------------
info "phase 1 — Sysbox controller + broker, worker cmd = a trivial /work-on stub"
need_docker
preflight_sysbox
okp "Sysbox $SYSBOX_VERSION installed, registered, and at/above the CVE floor"

CTR="claude-worker-lifecycle-verify"
IMAGE="${CLAUDE_SYSBOX_VERIFY_IMAGE:-docker:28-dind}"
WORKER_IMG="alpine:3.20"
AGENT=agent
docker rm -f "$CTR" >/dev/null 2>&1 || true
mapfile -t CTR_FLAGS < <("$CLAUDE_DOCKER_ROOT/bin/claude-controller-size" --k 2 --flags)
(( ${#CTR_FLAGS[@]} )) || die "claude-controller-size refused or failed — no controller flags"
docker run -d --name "$CTR" \
    "${CTR_FLAGS[@]}" \
    --label claude.worker-lifecycle-verify=1 \
    -e DOCKER_TLS_CERTDIR="" \
    "$IMAGE" >/dev/null

as_root()  { docker exec "$CTR" "$@"; }
as_agent() { docker exec -u "$AGENT_UID:$AGENT_GID" "$CTR" "$@"; }

inner_ready=0
for _ in $(seq 1 60); do
    if as_root docker info >/dev/null 2>&1; then inner_ready=1; break; fi
    sleep 1
done
(( inner_ready )) || { docker logs --tail 15 "$CTR" >&2 || true; die "inner dockerd did not come up within 60s"; }
okp "inner dockerd is up inside the Sysbox controller"

as_root apk add --no-cache bash procps coreutils >/dev/null 2>&1 || die "could not install bash+procps+coreutils in the controller"
as_root adduser -D "$AGENT" >/dev/null 2>&1 || true
AGENT_UID="$(as_root id -u "$AGENT")" && [[ "$AGENT_UID" =~ ^[0-9]+$ ]] \
    || die "unprivileged user '$AGENT' was not created in the controller"
AGENT_GID="$(as_root id -g "$AGENT")"
install_file() { docker exec -i "$CTR" sh -c "cat > '$2' && chmod 755 '$2'" < "$1"; }
install_file "$CLAUDE_DOCKER_ROOT/bin/_common.sh"            /usr/local/bin/_common.sh
install_file "$CLAUDE_DOCKER_ROOT/bin/claude-worker-broker"  /usr/local/bin/claude-worker-broker
install_file "$CLAUDE_DOCKER_ROOT/bin/claude-worker-request" /usr/local/bin/claude-worker-request
install_file "$CLAUDE_DOCKER_ROOT/bin/claude-reaper"         /usr/local/bin/claude-reaper
as_root docker pull "$WORKER_IMG" >/dev/null 2>&1 || die "inner daemon could not pull $WORKER_IMG"

# The stub stands in for the real claude-worker-run: it is honest about what this
# script can prove without a real `claude` CLI + credentials — the ONE-SHOT-THEN-EXIT
# contract and the broker/reaper's handling of it, not /work-on's own behavior (that is
# claude-worker-run's own unit tests + the real fleet).
docker exec -d \
    -e CLAUDE_SYSBOX_ATTESTED_VERSION="$SYSBOX_VERSION" \
    -e CLAUDE_BROKER_CLIENT_USER="$AGENT" \
    -e CLAUDE_BROKER_MAX_WORKERS=2 \
    -e CLAUDE_BROKER_POLL=0.2 \
    -e CLAUDE_WORKER_IMAGE="$WORKER_IMG" \
    -e CLAUDE_BROKER_WORKER_CMD="echo one-shot-stub-ran" \
    "$CTR" bash -c '/usr/local/bin/claude-worker-broker >/var/log/claude-worker-broker.log 2>&1'
broker_up=0
for _ in $(seq 1 30); do
    if as_root test -d /run/claude/broker/requests; then broker_up=1; break; fi
    sleep 0.5
done
(( broker_up )) || { as_root cat /var/log/claude-worker-broker.log >&2 || true; die "broker did not come up (no spool)"; }
okp "broker is serving with a trivial stub in place of claude-worker-run"

# --- phase 2: one-shot-then-vanish, no residue ------------------------------------------
info "phase 2 — broker-launched worker runs once, container vanishes (--rm; no residue)"

resp="$(as_agent claude-worker-request hl7 CC4-ONESHOT --timeout 30 || true)"
WNAME="claude-worker-cc4-oneshot"
if [[ "$resp" == "ok $WNAME" ]]; then
    okp "worker launched: $resp"
else
    as_root cat /var/log/claude-worker-broker.log >&2 || true
    badp "worker launch failed (got '$resp')"
fi

vanished=0
for _ in $(seq 1 30); do
    if ! as_root docker inspect "$WNAME" >/dev/null 2>&1; then vanished=1; break; fi
    sleep 1
done
if (( vanished )); then
    okp "the one-shot worker vanished on its own (--rm; no residue left by a clean exit)"
else
    st="$(as_root docker inspect -f '{{.State.Status}}' "$WNAME" 2>/dev/null || echo unknown)"
    badp "the one-shot worker did not vanish within 30s (state=$st) — --rm or the stub's exit is broken"
fi

# --- phase 3: an unclean (kill -9) exit is reaped -----------------------------------------
info "phase 3 — a kill -9'd worker is reaped: removed + name freed"

# A long-lived stub this time, so there is something alive to kill -9.
docker exec \
    -e CLAUDE_BROKER_DIR=/run/claude/broker \
    "$CTR" bash -c 'true' >/dev/null 2>&1 || true   # no-op keepalive of the shell above
resp="$(as_root docker run -d --label claude.worker=1 --label claude.item=CC4-KILL \
    --label claude.repo=hl7 --label claude.managed=1 --name claude-worker-cc4-kill \
    "$WORKER_IMG" sleep 300)"
as_root docker kill -s KILL claude-worker-cc4-kill >/dev/null 2>&1 || true
killed_state="$(as_root docker inspect -f '{{.State.Status}}' claude-worker-cc4-kill 2>/dev/null || echo missing)"
if [[ "$killed_state" == exited ]]; then
    okp "a SIGKILL'd worker is left behind as an exited container (the residue the reaper targets)"
else
    badp "expected the killed worker to be 'exited' (got '$killed_state')"
fi

as_root claude-reaper >/tmp/reap1.out 2>&1 || true
still_there=1
as_root docker inspect claude-worker-cc4-kill >/dev/null 2>&1 || still_there=0
if (( still_there == 0 )); then
    okp "the reaper removed the exited (kill -9'd) worker"
else
    badp "the reaper left the exited worker in place"
fi

# Name freed: relaunching the same item must succeed (no name-conflict error).
resp2="$(as_agent claude-worker-request hl7 CC4-KILL --timeout 30 || true)"
if [[ "$resp2" == "ok claude-worker-cc4-kill" ]]; then
    okp "the freed name is reusable — a re-request of the same item launches cleanly"
else
    badp "re-request after reaping should succeed with the same worker name (got '$resp2')"
fi
for _ in $(seq 1 30); do
    as_root docker inspect claude-worker-cc4-kill >/dev/null 2>&1 || break
    sleep 1
done

# --- phase 4: reaper is idempotent -------------------------------------------------------
info "phase 4 — a second reap over clean state is a no-op"

as_root claude-reaper >/tmp/reap2.out 2>&1 || true
if as_root claude-reaper >/tmp/reap3.out 2>&1; then
    okp "a second (and third) reap over already-clean state exits 0 (idempotent)"
else
    badp "a reap over clean state must still exit 0"
fi

# --- phase 5: spool hygiene: aged pruned, fresh + .lock kept -----------------------------
info "phase 5 — spool prune: aged responses/ pruned, fresh kept, .lock untouched"

as_root mkdir -p /run/claude/broker/responses /run/claude/broker/requests /run/claude/broker/staging
as_root sh -c ': > /run/claude/broker/responses/aged && touch -d "2 hours ago" /run/claude/broker/responses/aged'
as_root sh -c ': > /run/claude/broker/responses/fresh'
as_root sh -c ': > /run/claude/broker/.lock'
as_root env CLAUDE_REAPER_SPOOL_TTL=3600 claude-reaper >/tmp/reap4.out 2>&1 || true

aged_gone=1;  as_root test -f /run/claude/broker/responses/aged   && aged_gone=0
fresh_kept=1; as_root test -f /run/claude/broker/responses/fresh  || fresh_kept=0
lock_kept=1;  as_root test -f /run/claude/broker/.lock            || lock_kept=0
if (( aged_gone && fresh_kept && lock_kept )); then
    okp "aged responses/ file pruned; fresh file + .lock both kept"
else
    badp "spool prune wrong (aged_gone=$aged_gone fresh_kept=$fresh_kept lock_kept=$lock_kept)"
fi

# --- summary ------------------------------------------------------------------------------
echo
echo "== $PASS passed, $FAIL failed =="
(( KEEP )) && info "--keep: controller '$CTR' left running (docker rm -f $CTR to clean up)"
(( FAIL == 0 )) || { err "worker lifecycle NOT proven"; exit 1; }
ok "worker lifecycle proven: one-shot-then-vanish holds, unclean exits are reaped + names freed, spool hygiene holds"
