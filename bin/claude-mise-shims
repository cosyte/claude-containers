#!/usr/bin/env bash
# claude-mise-shims: rebuild this container's own view of the shared mise shims.
#
#   claude-mise-shims [-q]
#
# The shims dir (/cache/mise/shims) is shared by every container through /cache, so it holds a
# shim for every tool any container ever installed. A shim for a tool with no version set here
# still answers `command -v`, then fails with "No version is set for shim", so presence checks
# lie. PATH therefore holds a per-container dir instead, with a symlink to the shared shim of
# each tool that resolves in THIS container (the global config, plus every mise config under
# /workspace), and not the shared dir: a tool with no version reads "command not found". The shared dir is only read, never changed: other containers resolve other versions
# from it.
#
# A version a config pins but /cache does not hold yet is linked too, by the commands the
# tool's other installed versions provide: through the shared shim mise installs the pinned
# version on first use (not_found_auto_install, on that same rule), where without the link the
# command fell through to the image's own (node 24 for a pinned node 20) with no error. Nothing
# is downloaded here: the missing versions are read with MISE_OFFLINE=1. A tool none of whose
# versions is in /cache has no shared shim to link; the summary names it, for a `mise install`.
#
# The entrypoint (§9b) runs it at every start; run it again after a `mise use`.
#   -q   print nothing on success
# The view is $CLAUDE_STATE_DIR/mise-shims, else ~/.local/share/claude-mise-shims (both on the
# image's PATH). CLAUDE_MISE_WORKSPACE (a test seam) is the tree searched for configs (/workspace).
set -uo pipefail

QUIET=0
case "${1:-}" in
    -q) QUIET=1 ;;
    "") ;;
    -h|--help) sed -n '2,/^set /{/^set /d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
    *) echo "claude-mise-shims: unknown argument '$1' (try --help)" >&2; exit 2 ;;
esac

if [[ -n "${CLAUDE_STATE_DIR:-}" ]]; then
    VIEW="$CLAUDE_STATE_DIR/mise-shims"
else
    VIEW="$HOME/.local/share/claude-mise-shims"
fi
SHARED="${MISE_DATA_DIR:-/cache/mise}/shims"
WORKSPACE="${CLAUDE_MISE_WORKSPACE:-/workspace}"

mkdir -p "$VIEW" || { echo "claude-mise-shims: cannot create $VIEW" >&2; exit 1; }

# The files mise reads a config from. mise walks up from where it is asked, so the dir holding
# one (even .mise/ or .config/mise/) is a place to ask from.
CONFIG_MATCH=(-name mise.toml -o -name .mise.toml -o -name 'mise.*.toml' -o -name '.mise.*.toml'
              -o -name .tool-versions -o -path '*/.mise/config.toml' -o -path '*/mise/config.toml'
              -o -path '*/mise/conf.d/*.toml')

# The bin dirs of every tool with a version in this container: the global config (asked from
# $HOME), then each dir under the workspace that holds a mise config. One `mise bin-paths` per
# dir; a shim resolves here exactly when one of these dirs has its executable.
declare -A BINS=()
# The versions a config pins that are not installed: "<tool>@<version>" -> its install path
# (which does not exist yet; its parent holds the tool's other versions). `mise ls --missing`
# reads the configs only; MISE_OFFLINE keeps it from asking a registry anything.
declare -A MISSING=()
add_bins() {  # add_bins <dir>
    local p t
    while IFS= read -r p; do
        [[ -n "$p" ]] && BINS["$p"]=1
    done < <(cd "$1" 2>/dev/null && timeout 30 mise bin-paths 2>/dev/null)
    command -v jq >/dev/null 2>&1 || return 0
    while IFS=$'\t' read -r t p; do
        [[ -n "$t" && -n "$p" ]] && MISSING["$t"]="$p"
    done < <(cd "$1" 2>/dev/null && MISE_OFFLINE=1 timeout 30 mise ls --missing --json 2>/dev/null \
        | jq -r 'to_entries[] | .key as $t | .value[]
                 | select(.install_path) | "\($t)@\(.requested_version // .version)\t\(.install_path)"' 2>/dev/null)
}
if command -v mise >/dev/null 2>&1; then
    add_bins "$HOME"
    if [[ -d "$WORKSPACE" ]]; then
        declare -A DIRS=()
        while IFS= read -r -d "" f; do DIRS["${f%/*}"]=1; done < <(
            timeout 30 find "$WORKSPACE" -maxdepth 5 \
                \( -name .git -o -name node_modules -o -name .venv -o -name target \) -prune \
                -o -type f \( "${CONFIG_MATCH[@]}" \) -print0 2>/dev/null)
        for d in "${!DIRS[@]}"; do add_bins "$d"; done
    fi
fi

# The commands a missing version will provide, taken from the tool's installed versions next to
# it (their bin dirs: <ver>/bin, <ver>/*/bin, or <ver> itself), as mise's own install-on-first-use
# decides. Missing versions with no installed sibling have no shim anywhere: NO_SHIM names them.
declare -A PENDING=()
pending=() no_shim=()
for m in "${!MISSING[@]}"; do
    tooldir="${MISSING[$m]%/*}"
    found=0
    for v in "$tooldir"/*/; do
        [[ -d "$v" && ! -L "${v%/}" ]] || continue
        for f in "$v"bin/* "$v"*/bin/* "$v"*; do
            if [[ -f "$f" && -x "$f" ]]; then PENDING["${f##*/}"]=1; found=1; fi
        done
    done
    if (( found )); then pending+=("$m"); else no_shim+=("$m"); fi
done

# The wanted links: each shared shim whose tool one of those bin dirs provides, or that a pinned
# but missing version will provide.
declare -A WANT=()
total=0
if [[ -d "$SHARED" ]]; then
    for s in "$SHARED"/*; do
        [[ -e "$s" || -L "$s" ]] || continue
        total=$((total + 1))
        t="${s##*/}"
        if [[ -n "${PENDING[$t]:-}" ]]; then WANT["$t"]=1; continue; fi
        for b in "${!BINS[@]}"; do
            if [[ -x "$b/$t" && ! -d "$b/$t" ]]; then WANT["$t"]=1; break; fi
        done
    done
fi

# Update in place (never an empty dir on PATH mid-run): drop what no longer resolves, then link
# what does.
for e in "$VIEW"/* "$VIEW"/.[!.]*; do
    [[ -e "$e" || -L "$e" ]] || continue
    [[ -n "${WANT[${e##*/}]:-}" ]] || rm -f "$e"
done
for t in "${!WANT[@]}"; do
    [[ "$(readlink "$VIEW/$t" 2>/dev/null)" == "$SHARED/$t" ]] || ln -sfn "$SHARED/$t" "$VIEW/$t"
done

msg="${#WANT[@]} of $total shared shims linked into $VIEW"
(( ${#pending[@]} )) && msg+="; not installed yet, installs on first use: $(printf '%s\n' "${pending[@]}" | sort | paste -sd' ')"
(( ${#no_shim[@]} )) && msg+="; not installed and no version in /cache (run mise install): $(printf '%s\n' "${no_shim[@]}" | sort | paste -sd' ')"
(( QUIET )) || echo "claude-mise-shims: $msg"
