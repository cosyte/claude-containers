#!/usr/bin/env bash
# The command tmux runs in the 'claude' session pane.
# Launches Claude Code with Remote Control + skip-permissions, then drops to an
# interactive shell if Claude exits so the SSH/tmux session stays usable. Run
# `claude-session` (this script) again from that shell to relaunch.
#
# Usage: claude-session [--continue]
#   --continue   resume the most recent conversation. The RC watchdog passes
#                this when it restarts a session whose Remote Control link died,
#                so the conversation survives the restart.
set -uo pipefail

cd /workspace || cd "$HOME"

NAME="${CLAUDE_PROJECT_NAME:-claude}"
EXTRA="${CLAUDE_EXTRA_ARGS:-}"
PERM_MODE="${CLAUDE_PERMISSION_MODE:-bypassPermissions}"

# Remote Control debug log. Claude writes RC bridge events here so the
# healthcheck and the RC watchdog can tell when the Remote Control link drops
# (and whether it recovered). Opt out by launching with CLAUDE_RC_DEBUG_LOG="".
RC_DEBUG_LOG="${CLAUDE_RC_DEBUG_LOG-/tmp/claude-rc-debug.log}"
RC_DEBUG_FILTER="${CLAUDE_RC_DEBUG_FILTER:-bridge}"

# Permission posture from CLAUDE_PERMISSION_MODE. bypassPermissions keeps the
# historical --dangerously-skip-permissions (verified to combine with Remote
# Control on the pinned CLI); any other mode goes through --permission-mode so a
# hardened fleet can run acceptEdits/plan/etc. without editing this script.
case "$PERM_MODE" in
    bypassPermissions|bypass|"") ARGS=(--dangerously-skip-permissions) ;;
    *)                           ARGS=(--permission-mode "$PERM_MODE") ;;
esac
ARGS+=(--remote-control "$NAME")

if [[ "${1:-}" == "--continue" || "${1:-}" == "-c" ]]; then
    ARGS+=(--continue)
    echo "Resuming the most recent conversation (--continue)."
fi

if [[ -n "$RC_DEBUG_LOG" ]]; then
    # Truncate so detection only ever sees the current session's events.
    : > "$RC_DEBUG_LOG" 2>/dev/null || true
    ARGS+=(--debug "$RC_DEBUG_FILTER" --debug-file "$RC_DEBUG_LOG")
fi

echo "Starting Claude Code  (Remote Control name: ${NAME})"
echo "  workspace: $(pwd)"
echo "  flags    : ${ARGS[*]} ${EXTRA}"
echo

# shellcheck disable=SC2086  # EXTRA is intentionally word-split
claude "${ARGS[@]}" $EXTRA

code=$?
echo
echo "Claude Code exited (status ${code}). Dropping to a shell."
echo "Relaunch with:  claude-session            (fresh conversation)"
echo "            or: claude-session --continue  (resume this one)"
exec bash -l
