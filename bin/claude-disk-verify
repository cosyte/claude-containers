#!/usr/bin/env bash
# claude-disk-verify: prove disk-safety hygiene: docker-free, no root, no daemon needed.
#
# The substrate strip removed the on-host proof this script used to run against a real Sysbox
# nested-worker controller (the broker's per-launch disk-floor refusal, N sequential
# worker cycles, worker-image reuse), that whole substrate is retired; see
# docs/legacy-sysbox-broker.md. What's left is the surviving, non-broker disk-hygiene
# surface, all of it docker-free:
#
#   1. disk_free_mib parses a real `df` correctly, and CLAUDE_DISK_FREE_MIB_OVERRIDE
#      forces the value loudly;
#   2. claude-disk-gc's plan is exactly `system prune -f` + `builder prune -f`, never
#      `-a`, never `--volumes`;
#   3. the shared-cache trim is safe: cache_gc_plan reclaims only re-fetchable
#      download/registry caches (never an installs/shims/bin dir or bare /cache), and the
#      idle guard gates on the cache VOLUME (covers every cache-mounting container, not
#      just a subset).
#
# The same logic is covered in CI by test/disk-unit.sh; this script re-runs it as a
# one-command sanity pass, runnable anywhere (no Sysbox, no docker daemon needed).
#
#   bin/claude-disk-verify    run all checks (docker-free, safe anywhere)
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_common.sh"

for a in "$@"; do
    die "unknown flag '$a' (usage: claude-disk-verify, no flags; everything here is docker-free)"
done

PASS=0 FAIL=0
okp()  { echo "  PASS  $*"; PASS=$((PASS+1)); }
badp() { echo "  FAIL  $*"; FAIL=$((FAIL+1)); }

TMPD="$(mktemp -d)"
trap 'rm -rf "$TMPD"' EXIT

# --- phase 0: disk_free_mib parsing + override seam -------------------------------------
info "phase 0: disk_free_mib: real df parsing + the override seam"

got="$(disk_free_mib "$TMPD" 2>/dev/null || echo FAILED)"
if [[ "$got" =~ ^[0-9]+$ ]]; then
    okp "disk_free_mib parses a real 'df -P -B1M' on this host (got ${got} MiB free on $TMPD)"
else
    badp "disk_free_mib must parse a real df on an existing path (got: $got)"
fi

if got2="$(CLAUDE_DISK_FREE_MIB_OVERRIDE=12345 disk_free_mib "$TMPD" 2>/dev/null)" && [[ "$got2" == 12345 ]]; then
    okp "CLAUDE_DISK_FREE_MIB_OVERRIDE forces the returned value"
else
    badp "the override seam must force disk_free_mib's return (got: ${got2:-nothing})"
fi

if disk_free_mib "/no/such/path/disk-verify" >/dev/null 2>&1; then
    badp "disk_free_mib must fail (not silently succeed) on a nonexistent path"
else
    okp "disk_free_mib fails closed on a nonexistent path"
fi

# --- phase 1: disk_gc_plan is exactly the two safe prunes -------------------------------
info "phase 1: disk_gc_plan: exactly system+builder prune -f, never -a/--volumes"

plan="$(bash -c 'source "'"$CLAUDE_DOCKER_ROOT"'/bin/claude-disk-gc" 2>/dev/null; disk_gc_plan')"
if grep -q "system prune -f" <<<"$plan" && grep -q "builder prune -f" <<<"$plan"; then
    okp "the gc plan runs both system prune -f and builder prune -f"
else
    badp "the gc plan is missing a required prune (got: $plan)"
fi
if grep -qE -- '-a\b|--all\b|--volumes' <<<"$plan"; then
    badp "the gc plan must NEVER include -a/--all/--volumes (would touch live data)"
else
    okp "the gc plan never includes -a/--all/--volumes"
fi

# --- phase 1b: the shared-cache trim is safe, re-fetchable-only, idle-gated -------
info "phase 1b: cache_gc_plan: re-fetchable caches only; the idle guard gates on the cache volume"

cplan="$(bash -c 'source "'"$CLAUDE_DOCKER_ROOT"'/bin/claude-disk-gc" 2>/dev/null; cache_gc_plan')"
if grep -q '/cache/mise/downloads' <<<"$cplan" && grep -q '/cache/npm/_cacache' <<<"$cplan"; then
    okp "the cache trim plan reclaims the re-fetchable download/registry caches"
else
    badp "the cache trim plan is missing an expected re-fetchable cache (got: $cplan)"
fi
# CRITICAL: the trim must NEVER remove an installed toolchain, a shims dir, a bin dir, or
# the whole /cache, that would un-provision tools or wipe the shared store.
if grep -qE '(^/cache$|/installs(/|$)|/shims(/|$)|/cargo/bin|/go/bin)' <<<"$cplan"; then
    badp "the cache trim plan includes an installs/shims/bin/bare-/cache path (would un-provision tools)"
else
    okp "the cache trim plan never touches installs/, shims/, cargo|go/bin, or bare /cache"
fi
# The idle guard must gate on the CACHE VOLUME (covers every cache-mounting container),
# not a narrower label some containers might lack.
if grep -Eq 'ps -q --filter volume=' "$CLAUDE_DOCKER_ROOT/bin/claude-disk-gc"; then
    okp "the cache trim defers on any container using the cache volume"
else
    badp "the cache trim idle guard does not gate on --filter volume=<vol>: a launch/compose mid-install could be trimmed"
fi

# --- summary ------------------------------------------------------------------------------
echo
echo "== $PASS passed, $FAIL failed =="
(( FAIL == 0 )) || { err "disk-safety NOT proven"; exit 1; }
ok "disk-safety proven: disk_free_mib parsing + override, disk_gc_plan safety, shared-cache-trim safety"
