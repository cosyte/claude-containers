#!/usr/bin/env bash
# git pre-commit hook: refuse to commit obvious secrets/credentials.
#
# Installed fleet-wide by the entrypoint via a global core.hooksPath, so it
# guards EVERY repo in the container without touching the repo's own files.
# This is the "gate every auto-commit against a sensitive-path deny-list"
# control (cf. ccswarm): important here because the agent commits and pushes
# autonomously with a mounted git key and shares one credential volume.
#
# Two checks, both conservative to avoid false positives:
#   1. staged FILENAMES matching the deny-list (.env, *.pem, *.key, id_rsa, …)
#   2. staged CONTENT containing an unambiguous private-key header
#
# Disable entirely:        CLAUDE_SECRET_GUARD=0   (handled in the entrypoint)
# Bypass a single commit:  git commit --no-verify
# Extra deny patterns:     CLAUDE_SECRET_GUARD_EXTRA="pattern1 pattern2"  (glob, matched on basename)
#
# After passing, chains to the repo's own .git/hooks/pre-commit if present, so
# overriding core.hooksPath doesn't silently drop a project's existing hook.
set -uo pipefail

# Filename globs (matched case-insensitively against each staged file's basename).
DENY=(
    '.env' '.env.*' '*.pem' '*.key' '*.pfx' '*.p12'
    'id_rsa' 'id_dsa' 'id_ecdsa' 'id_ed25519'
    '.credentials.json' 'credentials' 'credentials.*'
    'secrets.yml' 'secrets.yaml' '.npmrc' '.pypirc'
    '.aws' 'aws_credentials' 'service-account*.json'
)
# shellcheck disable=SC2206  # intentional word-split of user-supplied extras
[[ -n "${CLAUDE_SECRET_GUARD_EXTRA:-}" ]] && DENY+=(${CLAUDE_SECRET_GUARD_EXTRA})

# Allow .env.example and friends: example/template/sample variants are not secrets.
is_allowlisted() {
    case "${1,,}" in
        *.example|*.example.*|*.sample|*.sample.*|*.template|*.template.*|*.dist) return 0 ;;
        *) return 1 ;;
    esac
}

matches_deny() {
    local base="${1,,}" pat
    for pat in "${DENY[@]}"; do
        # shellcheck disable=SC2053  # glob match is intentional
        [[ "$base" == ${pat,,} ]] && return 0
    done
    return 1
}

hits=()
# --diff-filter=ACM: only Added/Copied/Modified files have content to leak.
while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    base="$(basename -- "$f")"
    if matches_deny "$base" && ! is_allowlisted "$base"; then
        hits+=("$f  (filename matches secret deny-list)")
        continue
    fi
    # Content check: unambiguous PEM private-key header in the staged blob.
    if git show ":$f" 2>/dev/null | grep -qE -- '-----BEGIN ([A-Z ]+ )?PRIVATE KEY-----'; then
        hits+=("$f  (staged content contains a PRIVATE KEY block)")
    fi
done < <(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)

if (( ${#hits[@]} > 0 )); then
    {
        echo "✋ claude-secret-guard blocked this commit: possible secret(s) staged:"
        printf '   - %s\n' "${hits[@]}"
        echo
        echo "   If this is a deliberate, non-secret file, bypass once with:"
        echo "       git commit --no-verify"
        echo "   or unstage it:  git restore --staged <file>"
    } >&2
    exit 1
fi

# Chain to the repo's own pre-commit hook (core.hooksPath overrode it).
repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"
repo_hook="$repo_root/.git/hooks/pre-commit"
if [[ -n "$repo_root" && -x "$repo_hook" ]]; then
    exec "$repo_hook" "$@"
fi
exit 0
