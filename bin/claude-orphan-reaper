#!/usr/bin/env bash
# claude-orphan-reaper: end the agent's processes that nothing waits on any more.
#
# A Bash tool call that times out leaves its children behind, re-parented to the container's
# init (PID 1). On 2026-10-17 four `find /` walks had run 10-11 h that way, keeping the host's
# one disk 100% busy, and simulators from a deleted worktree had run 8 h. The entrypoint (§12h)
# starts this for the container's lifetime, as the agent user.
#
# Every CLAUDE_ORPHAN_INTERVAL seconds a process is sent SIGTERM, then SIGKILL 30 s later if it
# is still there and still matches, when ALL of these hold:
#   - it is owned by the agent user (this script's uid);
#   - its parent is PID 1;
#   - it is older than CLAUDE_ORPHAN_MAX_AGE (its own age, not how long it has been orphaned:
#     a 3 h `nohup` server is ended at the first pass after its parent exits);
#   - its name is not kept: the kept names (KEEP below, plus CLAUDE_ORPHAN_KEEP) are matched
#     against the basename of its command, or of its script when the command is an interpreter
#     (so `bash /usr/local/bin/claude-session` is claude-session), or against any word of a
#     java command line (a Gradle daemon by its main class). Arguments are never matched:
#     `find /home/claude` is not kept;
#   - it is not a VS Code server: a command, or an interpreter's script, installed under
#     ~/.vscode-server/ (or -insiders). Its server outlives the SSH login that started it, by
#     design, and its basenames (code-server, server-main.js, code-<commit>) are too generic
#     to keep by name. Only that path is looked at, never an argument: `node app.js
#     ~/.vscode-server/x` and other node or python orphans are ended as before;
#   - it is not in the session of the kit's start command (claude-kit start writes that
#     session's id to $CLAUDE_CONFIG_DIR/kit-start.pid): a supervisor a kit ships is meant
#     to outlive its parent.
# Each kill is logged with pid, age and command.
#
# Usage: claude-orphan-reaper            the loop (what the entrypoint runs)
#        claude-orphan-reaper --once     one pass, then exit
#        claude-orphan-reaper --list     print what a pass would end, end nothing
#
# Env:
#   CLAUDE_ORPHAN_MAX_AGE   minimum age: seconds, or a number with s, m, h or d (default 2h);
#                           0 turns the reaper off
#   CLAUDE_ORPHAN_KEEP      more kept names, an extended regex matched as above; it adds to the
#                           built-in list, never replaces it (a bad regex is warned and ignored)
# Test seams (unit tests only):
#   CLAUDE_ORPHAN_PS        the command that lists processes as `pid ppid uid sid etimes args`
#                           (default: ps)
#   CLAUDE_ORPHAN_KILL      the command that signals: <cmd> -TERM|-KILL <pid> (default: kill)
#   CLAUDE_ORPHAN_INTERVAL  seconds between passes (default 300)
#   CLAUDE_ORPHAN_GRACE     seconds between SIGTERM and SIGKILL (default 30)
#   CLAUDE_ORPHAN_UID       the owner whose orphans are ended (default: this script's uid)
set -uo pipefail

# The Gradle and Kotlin daemons stop themselves when idle, and ending one mid-build fails the build.
# claude.exe is the native Claude binary's own name (an npm install runs it, a `claude --bg`
# session lives on). aardvark-dns is the DNS server netavark starts for a podman network with
# DNS on (a --containers session's compose network), and it daemonizes to PID 1: ending it stops
# the nested containers resolving each other by name. netavark's `dhcp-proxy` is long-lived too.
KEEP='^(tmux|claude-session|claude|claude\.exe|ssh-agent|sshd|chrome_crashpad_handler|podman|conmon|catatonit|rootlessport|slirp4netns|pasta|aardvark-dns|netavark|org\.gradle\.launcher\.daemon\.bootstrap\.GradleDaemon|org\.jetbrains\.kotlin\.daemon\.KotlinCompileDaemon)(:.*)?$'
EXTRA_KEEP="${CLAUDE_ORPHAN_KEEP:-}"
INTERPRETERS='^(ba|da|z)?sh$|^(python|perl|ruby|node)[0-9.]*$'
INTERVAL="${CLAUDE_ORPHAN_INTERVAL:-300}"
GRACE="${CLAUDE_ORPHAN_GRACE:-30}"
OWNER="${CLAUDE_ORPHAN_UID:-$(id -u)}"
KIT_PIDFILE="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/kit-start.pid"

say() { echo "[orphan-reaper] $*"; }

# max_age_seconds <spec>: 7200 for 2h, 90 for 90; empty on a bad spec
max_age_seconds() {
    [[ "$1" =~ ^([0-9]+)([smhd]?)$ ]] || return 0
    local n=$((10#${BASH_REMATCH[1]}))
    case "${BASH_REMATCH[2]}" in
        m) n=$((n * 60)) ;; h) n=$((n * 3600)) ;; d) n=$((n * 86400)) ;;
    esac
    echo "$n"
}

# A bad regex makes [[ =~ ]] return 2, which would read as "not kept" for tmux and claude too.
# The probe's own error is dropped: some bash versions print one, and the warning says it.
if [[ -n "$EXTRA_KEEP" ]]; then
    rc=0; bash -c '[[ x =~ $1 ]]' _ "$EXTRA_KEEP" 2>/dev/null || rc=$?
    if (( rc == 2 )); then
        say "WARNING: CLAUDE_ORPHAN_KEEP='$EXTRA_KEEP' is not an extended regex: ignored"
        EXTRA_KEEP=""
    fi
fi

kept_name() { [[ "$1" =~ $KEEP ]] || { [[ -n "$EXTRA_KEEP" ]] && [[ "$1" =~ $EXTRA_KEEP ]]; }; }
# in_vscode_server <path>: a file of a VS Code server install (~/.vscode-server/...)
in_vscode_server() { [[ "$1" == */.vscode-server/* || "$1" == */.vscode-server-insiders/* ]]; }

# is_kept <args>: the command's name, its script's under an interpreter, or any java word;
# or a command or script of a VS Code server
is_kept() {
    local -a words; read -ra words <<<"$1"
    local cmd="${words[0]##*/}" w
    kept_name "$cmd" && return 0
    in_vscode_server "${words[0]}" && return 0
    if [[ "$cmd" =~ $INTERPRETERS ]]; then
        for w in "${words[@]:1}"; do
            [[ "$w" == -* ]] && continue
            in_vscode_server "$w" && return 0
            kept_name "${w##*/}"; return
        done
    elif [[ "$cmd" == java ]]; then
        for w in "${words[@]:1}"; do kept_name "$w" && return 0; done
    fi
    return 1
}

MAX_AGE="$(max_age_seconds "${CLAUDE_ORPHAN_MAX_AGE:-2h}")"
if [[ -z "$MAX_AGE" ]]; then
    say "WARNING: CLAUDE_ORPHAN_MAX_AGE='${CLAUDE_ORPHAN_MAX_AGE}' is not seconds or N[smhd]: using 2h"
    MAX_AGE=7200
fi

list_ps() {
    if [[ -n "${CLAUDE_ORPHAN_PS:-}" ]]; then $CLAUDE_ORPHAN_PS
    else ps -e -o pid=,ppid=,uid=,sid=,etimes=,args=; fi
}

signal() { ${CLAUDE_ORPHAN_KILL:-kill} "$1" "$2" 2>/dev/null; }

# select_orphans: one `pid age args` line per process to end
select_orphans() {
    local kit_sid="" listing
    [[ -r "$KIT_PIDFILE" ]] && kit_sid="$(tr -dc 0-9 < "$KIT_PIDFILE")"
    listing="$(list_ps)"
    # Without an init (a container run without --init), PID 1 is the entrypoint and every
    # watchdog it started is its child: nothing with PPID 1 is an orphan then.
    if awk '$1 == 1 && ($6 ~ /entrypoint/ || $7 ~ /entrypoint/) { f = 1 } END { exit !f }' <<<"$listing"; then
        say "skipped: PID 1 is the entrypoint, not an init (run the container with --init)" >&2
        return 0
    fi
    local pid ppid uid sid age args
    while read -r pid ppid uid sid age args; do
        [[ "$pid" =~ ^[0-9]+$ && "$age" =~ ^[0-9]+$ ]] || continue
        [[ "$uid" == "$OWNER" && "$ppid" == 1 && "$pid" != "$$" ]] || continue
        (( age > MAX_AGE )) || continue
        [[ -n "$kit_sid" && "$sid" == "$kit_sid" ]] && continue
        is_kept "$args" && continue
        echo "$pid $age $args"
    done <<<"$listing"
}

human_age() { printf '%dh%02dm' $(($1 / 3600)) $(($1 % 3600 / 60)); }

pass() {
    local found pid age args
    found="$(select_orphans)"
    [[ -n "$found" ]] || return 0
    while read -r pid age args; do
        signal -TERM "$pid" && say "SIGTERM pid $pid (orphaned, age $(human_age "$age")): $args"
    done <<<"$found"
    sleep "$GRACE" & SLEEP_PID=$!   # in the background, so a SIGTERM is not held up 30 s
    wait "$SLEEP_PID"
    # Only a pid that still matches: one that exited and was reused is no longer old.
    local again; again="$(select_orphans)"
    while read -r pid age args; do
        awk -v p="$pid" '$1 == p { f = 1 } END { exit !f }' <<<"$found" || continue
        signal -KILL "$pid" && say "SIGKILL pid $pid (survived SIGTERM, age $(human_age "$age")): $args"
    done <<<"$again"
}

case "${1:-}" in
    --list) [[ "$MAX_AGE" == 0 ]] || select_orphans; exit 0 ;;
    --once) [[ "$MAX_AGE" == 0 ]] || pass; exit 0 ;;
    "") ;;
    *) echo "usage: claude-orphan-reaper [--once | --list]" >&2; exit 2 ;;
esac
if [[ "$MAX_AGE" == 0 ]]; then say "off (CLAUDE_ORPHAN_MAX_AGE=0)"; exit 0; fi
trap 'kill "${SLEEP_PID:-}" 2>/dev/null; exit 0' TERM INT
while :; do
    pass
    sleep "$INTERVAL" & SLEEP_PID=$!
    wait "$SLEEP_PID"
done
