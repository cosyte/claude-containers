#!/usr/bin/env bash
# claude-compose-gen — generate a multi-service docker-compose.yml that runs
# one Claude Code session container per repo in a GitHub org.
#
#   claude-compose-gen --org <name> --out <file> [options]
#   claude-compose-gen --out <file> [options] repo[:branch] ...
#     --org <name>      GitHub org/owner to enumerate (required unless repos
#                       are passed as arguments)
#     --out <file>      output compose path (required; must be OUTSIDE this
#                       repo — e.g. a deploy dir like /srv/claude/compose.yml)
#     --port-base <n>   first SSH host port (default: SSH_PORT_RANGE_START)
#     --include <glob>  only repos whose name matches (repeatable)
#     --exclude <glob>  skip repos whose name matches (repeatable)
#     --active <repos>  repos to start by default (repeatable; comma/space
#                       lists ok). All OTHER repos are still defined but put
#                       behind a Compose profile so a plain `up -d` does not
#                       start them (zero resources until asked). Default: all.
#     --dormant-profile <name>  profile name for non-active repos (default:
#                       dormant)
#     --expose <map>    publish an extra container port for a repo, e.g. a dev
#                       server. Format REPO:HOSTPORT:CONTAINERPORT (repeatable).
#                       e.g. --expose bridgelink-website:4321:4321
#     --dev-cmd <map>   auto-start a dev server on container boot, in its own
#                       tmux 'dev' window. Format REPO=COMMAND (repeatable).
#                       Bind to 0.0.0.0 so the published port reaches it, e.g.
#                       --dev-cmd site='npm run dev -- --host 0.0.0.0 --port 4321'
#     --forks           include forks (default: source repos only)
#     --archived        include archived repos (default: skip)
#     --limit <n>       gh repo list limit (default: 500)
#
# SSH host ports are STABLE: if --out already exists, each repo keeps its
# previously assigned port; only new repos get the next free port in range.
# So adding a repo never reshuffles running containers.
#
# With explicit repo args, gh is not called (use NAME or NAME:BRANCH).
# Otherwise `gh repo list <org>` is used and must be authenticated.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_common.sh"

usage() { sed -n '2,36p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

ORG=""
OUT=""
PORT_BASE="$SSH_PORT_RANGE_START"
LIMIT=500
WANT_FORKS=0 WANT_ARCHIVED=0
DORMANT_PROFILE="dormant"
INCLUDE=() EXCLUDE=() REPO_ARGS=() ACTIVE_RAW=() EXPOSE_RAW=() DEVCMD_RAW=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --org)             ORG="$2"; shift 2 ;;
        --out)             OUT="$2"; shift 2 ;;
        --port-base)       PORT_BASE="$2"; shift 2 ;;
        --include)         INCLUDE+=("$2"); shift 2 ;;
        --exclude)         EXCLUDE+=("$2"); shift 2 ;;
        --active)          ACTIVE_RAW+=("$2"); shift 2 ;;
        --expose)          EXPOSE_RAW+=("$2"); shift 2 ;;
        --dev-cmd)         DEVCMD_RAW+=("$2"); shift 2 ;;
        --dormant-profile) DORMANT_PROFILE="$2"; shift 2 ;;
        --forks)           WANT_FORKS=1; shift ;;
        --archived)        WANT_ARCHIVED=1; shift ;;
        --limit)           LIMIT="$2"; shift 2 ;;
        -h|--help)         usage 0 ;;
        -*)                die "unknown option: $1 (try --help)" ;;
        *)                 REPO_ARGS+=("$1"); shift ;;
    esac
done

# No host- or org-specific defaults: this is a shared tool. Caller must say
# where to write and (for gh enumeration) which org.
[[ -n "$OUT" ]] || die "--out <file> is required, and must be OUTSIDE this repo
       (a deploy location), e.g. --out /srv/claude/docker-compose.yml"
if [[ ${#REPO_ARGS[@]} -eq 0 && -z "$ORG" ]]; then
    die "give --org <name> to enumerate via gh, or pass repo names as args"
fi

# Active set: sanitized service names that start by default. Empty = all
# active (no profiles emitted — backward compatible).
declare -A ACTIVE=()
HAVE_ACTIVE=0
for tok in "${ACTIVE_RAW[@]:-}"; do
    [[ -n "$tok" ]] || continue
    for one in $(echo "$tok" | tr ',' ' '); do
        ACTIVE["$(sanitize "$one")"]=1; HAVE_ACTIVE=1
    done
done

# Extra published ports per service: svc -> newline-separated "HOST:CONTAINER".
declare -A EXPOSE=()
for tok in "${EXPOSE_RAW[@]:-}"; do
    [[ -n "$tok" ]] || continue
    IFS=: read -r er eh ec <<<"$tok"
    [[ -n "$er" && "$eh" =~ ^[0-9]+$ && "$ec" =~ ^[0-9]+$ ]] \
        || die "--expose must be REPO:HOSTPORT:CONTAINERPORT (got '$tok')"
    es="$(sanitize "$er")"
    EXPOSE[$es]="${EXPOSE[$es]:-}${EXPOSE[$es]:+$'\n'}${eh}:${ec}"
done

# Auto-start dev command per service: svc -> command string (boot tmux window).
declare -A DEVCMD=()
for tok in "${DEVCMD_RAW[@]:-}"; do
    [[ -n "$tok" ]] || continue
    [[ "$tok" == *=* ]] || die "--dev-cmd must be REPO=COMMAND (got '$tok')"
    DEVCMD["$(sanitize "${tok%%=*}")"]="${tok#*=}"
done

# The generated multi-repo compose is deployment config, not part of this
# project — refuse to write it anywhere inside the repo so it can't be
# committed here by accident. Resolve paths without requiring them to exist.
abspath() {
    if command -v realpath >/dev/null 2>&1; then realpath -m -- "$1"
    else case "$1" in /*) printf '%s\n' "$1";; *) printf '%s\n' "$PWD/$1";; esac
    fi
}
OUT_ABS="$(abspath "$OUT")"
REPO_ABS="$(abspath "$CLAUDE_DOCKER_ROOT")"
case "$OUT_ABS/" in
    "$REPO_ABS"/*)
        die "refusing to write inside the repo ($REPO_ABS).
       This is deployment config — point --out at a path outside the repo,
       e.g. --out /srv/claude/docker-compose.yml" ;;
esac

ABS_CONTEXT="$CLAUDE_DOCKER_ROOT"
# Compose has no ~ expansion — resolve host SSH paths to absolute now.
AK="${SSH_AUTHORIZED_KEYS/#\~/$HOME}"
GK="${GIT_SSH_KEY/#\~/$HOME}"
GH_NAME="$(git config --global user.name  2>/dev/null || true)"
GH_MAIL="$(git config --global user.email 2>/dev/null || true)"

# --- Collect repos as "name<TAB>branch" --------------------------------------
declare -a REPOS=()
if [[ ${#REPO_ARGS[@]} -gt 0 ]]; then
    for r in "${REPO_ARGS[@]}"; do
        REPOS+=("${r%%:*}	$( [[ "$r" == *:* ]] && echo "${r#*:}" || echo '' )")
    done
else
    command -v gh >/dev/null 2>&1 \
        || die "gh not found and no repo args given. Install/auth gh, or pass repo names."
    gh auth status >/dev/null 2>&1 \
        || die "gh is not authenticated. Run 'gh auth login' first."
    info "Enumerating ${ORG}/* via gh…"
    json="$(gh repo list "$ORG" --limit "$LIMIT" \
        --json name,defaultBranchRef,isFork,isArchived 2>/dev/null)" \
        || die "gh repo list $ORG failed"
    while IFS=$'\t' read -r name branch; do
        [[ -n "$name" ]] && REPOS+=("$name	$branch")
    done < <(echo "$json" | jq -r --argjson f "$WANT_FORKS" --argjson a "$WANT_ARCHIVED" '
        .[] | select(($f==1 or (.isFork|not)) and ($a==1 or (.isArchived|not)))
        | [.name, ""] | @tsv')
fi

# --- Apply include/exclude, sanitize, sort, dedupe ---------------------------
declare -A SEEN=()
declare -a FINAL=()
match_any() { local n="$1"; shift; for g in "$@"; do [[ "$n" == $g ]] && return 0; done; return 1; }
# sort by repo name so port assignment is stable across regenerations
while IFS=$'\t' read -r name branch; do
    [[ -n "$name" ]] || continue
    if [[ ${#INCLUDE[@]} -gt 0 ]]; then match_any "$name" "${INCLUDE[@]}" || continue; fi
    if [[ ${#EXCLUDE[@]} -gt 0 ]]; then match_any "$name" "${EXCLUDE[@]}" && continue; fi
    s="$(sanitize "$name")"
    [[ -n "${SEEN[$s]:-}" ]] && continue
    SEEN[$s]=1
    FINAL+=("$s	$name	$branch")
done < <(printf '%s\n' "${REPOS[@]}" | sort -f)

[[ ${#FINAL[@]} -gt 0 ]] || die "no repos selected (after filters)"

# --- Stable SSH port assignment ----------------------------------------------
# Reuse each repo's previously assigned port from an existing OUT file; only
# brand-new repos take the next free port. Adding a repo never reshuffles
# running containers.
declare -A SVCPORT=() USEDPORT=()
if [[ -f "$OUT" ]]; then
    while IFS=$'\t' read -r psvc pport; do
        [[ -n "$psvc" && -n "$pport" ]] || continue
        SVCPORT[$psvc]="$pport"; USEDPORT[$pport]=1
    done < <(awk '
        /^[[:space:]]*container_name:[[:space:]]*claude-/ {
            s=$0; sub(/^[[:space:]]*container_name:[[:space:]]*claude-/,"",s);
            sub(/[[:space:]]+$/,"",s) }
        /^[[:space:]]*claude\.ssh_port:/ {
            p=$0; gsub(/[^0-9]/,"",p); if(s!=""){print s"\t"p; s=""} }
    ' "$OUT")
fi
next_port() {
    local p
    for ((p=PORT_BASE; p<=SSH_PORT_RANGE_END; p++)); do
        [[ -n "${USEDPORT[$p]:-}" ]] && continue
        USEDPORT[$p]=1; echo "$p"; return 0
    done
    die "no free SSH port in ${PORT_BASE}-${SSH_PORT_RANGE_END} for new repos"
}
for row in "${FINAL[@]}"; do
    IFS=$'\t' read -r svc _ _ <<<"$row"
    [[ -n "${SVCPORT[$svc]:-}" ]] || SVCPORT[$svc]="$(next_port)"
done

# --- Emit compose ------------------------------------------------------------
mkdir -p "$(dirname "$OUT")"
TMP="$(mktemp)"
{
cat <<EOF
# GENERATED by bin/claude-compose-gen — do not hand-edit; regenerate instead.
# One Claude Code session container per ${ORG}/* repo. Each is reachable by SSH
# (its own host port) and in the Claude mobile app (Remote Control), and shows
# up in \`claude-list\` (shares the claude.managed labels).
#
# Prerequisites (once):
#   1. Build the image:        make build           # in ${ABS_CONTEXT}
#   2. One-time OAuth login:    make login           # writes the claude-auth volume
#   3. Authorized SSH pubkey:   ${AK}
#   4. Git deploy key w/ ${ORG} read:  ${GK}
#      (its .pub added to the ${ORG} org / each repo as a read/write deploy key)
#
# Resource model: only "active" repos start by default. Every other repo is
# still defined but behind the "${DORMANT_PROFILE}" Compose profile, so it
# consumes ZERO resources until you explicitly ask for it.
#
# Bring up / down:
#   docker compose -f ${OUT} up -d                  # active repos only
#   docker compose -f ${OUT} up -d <repo>           # one dormant repo, on demand
#   docker compose -f ${OUT} --profile ${DORMANT_PROFILE} up -d   # ALL repos
#   docker compose -f ${OUT} stop <repo>            # free its resources
#   docker compose -f ${OUT} down                   # stop all (add -v for volumes)
#
# Never set ANTHROPIC_API_KEY (the entrypoint hard-fails: OAuth only).

services:
EOF

for row in "${FINAL[@]}"; do
    IFS=$'\t' read -r svc name branch <<<"$row"
    url="git@github.com:${ORG}/${name}.git"
    port="${SVCPORT[$svc]}"
    cat <<EOF
  ${svc}:
    image: ${CLAUDE_IMAGE}
    build:
      context: ${ABS_CONTEXT}
      args:
        NODE_VERSION: "\${NODE_VERSION:-24}"
        CLAUDE_CODE_VERSION: "\${CLAUDE_CODE_VERSION:-2.1.144}"
        UV_VERSION: "\${UV_VERSION:-latest}"
        CLAUDE_UID: "\${CLAUDE_UID:-1000}"
        CLAUDE_GID: "\${CLAUDE_GID:-1000}"
        CLAUDE_USER: "\${CLAUDE_USER:-claude}"
    container_name: claude-${svc}
    hostname: ${svc}
    restart: unless-stopped
    init: true
    shm_size: ${CLAUDE_SHM_SIZE}
    cpus: ${CLAUDE_CPU_LIMIT}
    mem_limit: ${CLAUDE_MEM_LIMIT}
    stop_grace_period: ${CLAUDE_STOP_TIMEOUT}s
    tmpfs:
      - /tmp:rw,nosuid,nodev,exec,size=1g
    ports:
      - "${port}:22"
EOF
    if [[ -n "${EXPOSE[$svc]:-}" ]]; then
        while IFS= read -r m; do
            [[ -n "$m" ]] && echo "      - \"${m}\""
        done <<<"${EXPOSE[$svc]}"
    fi
    cat <<EOF
    environment:
      CLAUDE_PROJECT_NAME: "${svc}"
      CLAUDE_PERMISSION_MODE: "\${CLAUDE_PERMISSION_MODE:-bypassPermissions}"
      GIT_REPO_URL: "${url}"
EOF
    [[ -n "$branch" ]] && echo "      GIT_REPO_BRANCH: \"${branch}\""
    if [[ -n "${DEVCMD[$svc]:-}" ]]; then
        dc="${DEVCMD[$svc]}"
        dc="${dc//\\/\\\\}"; dc="${dc//\"/\\\"}"; dc="${dc//\$/\$\$}"
        echo "      CLAUDE_DEV_CMD: \"${dc}\""
    fi
    cat <<EOF
      GIT_AUTHOR_NAME: "${GH_NAME}"
      GIT_AUTHOR_EMAIL: "${GH_MAIL}"
      GIT_COMMITTER_NAME: "${GH_NAME}"
      GIT_COMMITTER_EMAIL: "${GH_MAIL}"
    volumes:
      - claude-auth:/auth
      - claude-sshkeys:/etc/ssh/host-keys
      - claude-config-${svc}:/home/claude/.claude
      - claude-ws-${svc}:/workspace
      - ${AK}:/etc/claude/authorized_keys:ro
      - ${GK}:/etc/claude/git-key:ro
    labels:
      claude.managed: "1"
      claude.project: "${svc}"
      claude.ssh_port: "${port}"
      claude.repo: "${url}"
EOF
    # Non-active repos: defined but behind a profile, so `up -d` skips them.
    if [[ $HAVE_ACTIVE -eq 1 && -z "${ACTIVE[$svc]:-}" ]]; then
        printf '    profiles:\n      - %s\n' "$DORMANT_PROFILE"
    fi
    port=$((port+1))
done

# top-level volumes
echo
echo "volumes:"
cat <<EOF
  claude-auth:
    name: ${AUTH_VOLUME}
    external: true
  claude-sshkeys:
    name: ${SSHKEYS_VOLUME}
EOF
for row in "${FINAL[@]}"; do
    IFS=$'\t' read -r svc _ _ <<<"$row"
    printf '  claude-config-%s:\n    name: claude-config-%s\n' "$svc" "$svc"
    printf '  claude-ws-%s:\n    name: claude-ws-%s\n' "$svc" "$svc"
done
} > "$TMP"

mv -f "$TMP" "$OUT"
if [[ $HAVE_ACTIVE -eq 1 ]]; then
    n_active=0
    for r in "${FINAL[@]}"; do
        IFS=$'\t' read -r s _ _ <<<"$r"
        [[ -n "${ACTIVE[$s]:-}" ]] && n_active=$((n_active+1))
    done
else
    n_active=${#FINAL[@]}
fi
ok "Wrote $OUT  (${#FINAL[@]} services, ${n_active} start by default)"
for r in "${FINAL[@]}"; do
    IFS=$'\t' read -r s nm _ <<<"$r"
    if [[ $HAVE_ACTIVE -eq 1 && -z "${ACTIVE[$s]:-}" ]]; then mark="dormant (${DORMANT_PROFILE})"; else mark="ACTIVE"; fi
    extra=""
    [[ -n "${EXPOSE[$s]:-}" ]] && extra=" +ports $(echo "${EXPOSE[$s]}" | tr '\n' ',' | sed 's/,$//')"
    [[ -n "${DEVCMD[$s]:-}" ]] && extra="$extra +dev"
    printf '   %-22s -> claude-%-20s ssh :%-5s %s%s\n' "$nm" "$s" "${SVCPORT[$s]}" "$mark" "$extra"
done

echo
[[ -f "$AK" ]] || warn "authorized_keys not found at $AK — create it (your SSH pubkey) before 'up'"
[[ -f "$GK" ]] || warn "git deploy key not found at $GK — create it and add the .pub to ${ORG} before 'up'"
docker image inspect "$CLAUDE_IMAGE" >/dev/null 2>&1 || warn "image $CLAUDE_IMAGE not built yet — run 'make build'"
docker volume inspect "$AUTH_VOLUME" >/dev/null 2>&1 || warn "auth volume '$AUTH_VOLUME' missing — run 'make login'"
info "Validate:  docker compose -f $OUT config >/dev/null && echo OK"
