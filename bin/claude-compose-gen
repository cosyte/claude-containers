#!/usr/bin/env bash
# claude-compose-gen: generate a multi-service docker-compose.yml that runs
# one Claude Code session container per repo in a GitHub org.
#
#   claude-compose-gen --org <name> --out <file> [options]
#   claude-compose-gen --out <file> [options] repo[:branch] ...
#     --org <name>      GitHub org/owner to enumerate (required unless repos
#                       are passed as arguments)
#     --out <file>      output compose path (required; must be OUTSIDE this
#                       repo: e.g. a deploy dir like /srv/claude/compose.yml)
#     --scenario <file> read generator flags from a scenario .conf: one
#                       "--flag value" per line, # comments and blank lines
#                       skipped; the value is the literal rest-of-line (no
#                       quoting, even for spaces/;/$). Its flags apply first;
#                       CLI flags after --scenario override/append. A bare name
#                       resolves under CLAUDE_SCENARIOS_DIR; otherwise pass a
#                       path. Keep .conf files with your compose (deployment
#                       config), outside this repo.
#     --env-file <file> source this env ON TOP of the repo .env at generation
#                       time (SSH_PORT_RANGE, image, resources...). Point it at
#                       the SAME .env that sits beside --out so docker compose
#                       auto-loads it at `up` too, that is how each stack gets
#                       its own GH_TOKEN. A CLI --env-file beats a .conf's.
#     --port-base <n>   first SSH host port (default: SSH_PORT_RANGE_START)
#     --include <glob>  only repos whose name matches (repeatable)
#     --exclude <glob>  skip repos whose name matches (repeatable)
#     --active <repos>  repos to start by default (repeatable; comma/space
#                       lists ok). All OTHER repos are still defined but put
#                       behind a Compose profile so a plain `up -d` does not
#                       start them (zero resources until asked). Default: all.
#     --all-dormant     put EVERY service behind the dormant profile (a plain
#                       `up -d` starts nothing; bring services up on demand).
#                       The opposite pole of the default; mutually exclusive
#                       with naming --active repos.
#     --dormant-profile <name>  profile name for non-active repos (default:
#                       dormant)
#     --network <name>  attach every service to a pre-existing EXTERNAL docker
#                       network instead of this project's own "<project>_default".
#                       Lets multiple stacks on one host share ONE network (so a
#                       stack split costs zero extra networks: matters when the
#                       daemon address pool is nearly full). Create it first:
#                       docker network create <name>.
#     --cache <volume>  shared tool cache volume mounted at /cache on every service
#                       (default: claude-cache). One volume shared stack-wide,
#                       so a mise/cargo/go/npm/uv install by one worker is a cache hit
#                       for the rest and survives restarts.
#     --no-cache        do not mount a shared cache (per-container installs).
#     --expose <map>    publish an extra container port for a repo, e.g. a dev
#                       server. Format REPO:HOSTPORT:CONTAINERPORT (repeatable).
#                       e.g. --expose bridgelink-website:4321:4321
#     --dev-cmd <map>   auto-start a dev server on container boot, in its own
#                       tmux 'dev' window. Format REPO=COMMAND (repeatable).
#                       Bind to 0.0.0.0 so the published port reaches it, e.g.
#                       --dev-cmd site='npm run dev -- --host 0.0.0.0 --port 4321'
#     --cpu <map>       per-repo CPU limit override. Format REPO=N (repeatable);
#                       repos without one keep the global CLAUDE_CPU_LIMIT.
#     --mem <map>       per-repo memory limit override. Format REPO=SIZE, e.g.
#                       bridgelink-website=4g (repeatable). Default: CLAUDE_MEM_LIMIT.
#     --model <map>     per-repo model override. Format REPO=MODEL (repeatable);
#                       MODEL is any Claude Code alias (opus, sonnet, haiku,
#                       opusplan, default) or a full id. Repos without one fall
#                       back to the CLAUDE_MODEL env var, else opus (best
#                       available). Set a fleet-wide default by exporting
#                       CLAUDE_MODEL (or putting it in .env) before `up`.
#     --browser <repos> enable the chrome-devtools MCP (frontend debugging) for
#                       these repos (repeatable; comma/space lists ok). Their
#                       service uses CLAUDE_IMAGE_BROWSER (default
#                       claude-code-box:browser; `make build-browser`).
#     --docker <repos>  give these repos their own Docker engine, so the session can
#                       build images and run containers/compose stacks (repeatable;
#                       comma/space lists ok). The service runs under the Sysbox
#                       runtime (runtime: sysbox-runc) so the inner daemon needs no
#                       --privileged and no host socket, keeps its image store in a
#                       claude-docker-<repo> volume, and uses CLAUDE_IMAGE_DOCKER
#                       (default claude-code-box:docker; `make build-docker`), or
#                       CLAUDE_IMAGE_DOCKER_BROWSER when combined with --browser.
#     --marketplace <map>  add a git plugin marketplace to a repo at runtime.
#                       Format REPO=NAME=URL (repeatable). The repo's service
#                       gets CLAUDE_EXTRA_MARKETPLACES with this entry appended,
#                       e.g. --marketplace site=claude-skills=git@github.com:org/repo.git
#     --plugin <map>    enable plugins on a repo at runtime. Format
#                       REPO=PLUGIN[,PLUGIN...] (repeatable). Each PLUGIN is
#                       NAME@MKT (the MKT must come from a --marketplace on the
#                       same repo). Sets CLAUDE_EXTRA_PLUGINS on the service.
#                       e.g. --plugin site=software-engineering@claude-skills,data@claude-skills
#     --mount <map>     mount an EXISTING named volume into a repo's service at an
#                       extra path. Format REPO=VOLUME:/PATH[:ro] (repeatable).
#                       Use it to give one session read access to another's
#                       checkout, e.g. --mount myrepo=claude-ws-shared:/shared:ro
#                       The volume is declared `external: true` (it belongs to
#                       another stack), so `up` fails fast if it doesn't exist and
#                       a `down -v` here can never delete it. Prefer :ro, two live
#                       Claude sessions writing one git tree race on the index.
#     --accounts <map>  let a repo's session rotate between named OAuth accounts
#                       when the active one hits its usage limit (auto-resumes the
#                       same conversation; bin/claude-usage-watchdog). Format
#                       REPO=name1,name2,... (repeatable, accumulates per repo).
#                       Each name must already exist: `claude-account-login <name>`
#                       (or `make accounts-login ARGS=<name>`) once. Works with any
#                       count >= 1. The claude-auth-<name> volumes are external and
#                       shared like claude-auth itself: several repos or stacks can
#                       name the same account.
#     --build-context <dir>  build.context for every service (default: the checkout
#                       this script runs from). Pin it in the scenario when the
#                       deployment builds from a DIFFERENT clone than the one you
#                       regenerate from: otherwise every service's build.context
#                       silently follows whichever checkout ran the generator.
#     --forks           include forks (default: source repos only)
#     --archived        include archived repos (default: skip)
#     --limit <n>       gh repo list limit (default: 500)
#
# SSH host ports are STABLE: if --out already exists, each repo keeps its
# previously assigned port; only new repos get the next free port in range.
# So adding a repo never reshuffles running containers.
#
# With explicit repo args, gh is not called (use NAME or NAME:BRANCH).
# Otherwise `gh repo list <org>` is used and must be authenticated.
set -euo pipefail

# --- Pre-scan for --scenario / --env-file (BEFORE sourcing _common.sh) --------
# _common.sh sources the base .env and (if CLAUDE_ENV_FILE is set) layers a
# scenario env on top, so we must resolve the scenario .conf and the effective
# env file HERE, before that source. die()/colours aren't defined yet, so any
# error fails inline. The real "$@" is only READ (never shifted); the scenario
# flags are prepended to it after _common.sh is loaded.
_prescan_fail() { printf 'claude-compose-gen: %s\n' "$1" >&2; exit 1; }
SCENARIO_ARGS=()
_scenario="" _cli_env_file="" _conf_env_file="" _want=""
for _a in "$@"; do
    case "$_want" in
        scenario) _scenario="$_a"; _want=""; continue ;;
        envfile)  _cli_env_file="$_a"; _want=""; continue ;;
    esac
    case "$_a" in
        --scenario) _want="scenario" ;;
        --env-file) _want="envfile"  ;;
    esac
done
[[ "$_want" == scenario ]] && _prescan_fail "--scenario requires a file (name or path)"
[[ "$_want" == envfile  ]] && _prescan_fail "--env-file requires a path"

if [[ -n "$_scenario" ]]; then
    # A path (has a /, ends in .conf, or exists as given) is used verbatim; a
    # bare name resolves under CLAUDE_SCENARIOS_DIR. No host path is baked into
    # this shared tool, so a bare name with no CLAUDE_SCENARIOS_DIR is an error.
    if [[ "$_scenario" == */* || "$_scenario" == *.conf || -f "$_scenario" ]]; then
        _conf="$_scenario"
    elif [[ -n "${CLAUDE_SCENARIOS_DIR:-}" ]]; then
        _conf="${CLAUDE_SCENARIOS_DIR%/}/${_scenario}.conf"
    else
        _prescan_fail "--scenario '$_scenario' is a bare name but CLAUDE_SCENARIOS_DIR is unset: pass a path to the .conf, or export CLAUDE_SCENARIOS_DIR"
    fi
    [[ -f "$_conf" ]] || _prescan_fail "scenario file not found: $_conf"
    # Expand the .conf into SCENARIO_ARGS: one "--flag [value]" per line. The
    # value is the LITERAL rest-of-line after the first whitespace token, so a
    # value with spaces / ; / $ / = needs no quoting. Full-line # comments and
    # blank lines are skipped; an inline # is NEVER stripped (URLs contain it).
    while IFS= read -r _line || [[ -n "$_line" ]]; do
        [[ "$_line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${_line//[[:space:]]/}" ]] && continue
        _flag="${_line%%[[:space:]]*}"
        _rest="${_line#"$_flag"}"
        _rest="${_rest#"${_rest%%[![:space:]]*}"}"   # left-trim spaces AND tabs
        SCENARIO_ARGS+=("$_flag")
        [[ -n "$_rest" ]] && SCENARIO_ARGS+=("$_rest")
    done < "$_conf"
    # An --env-file inside the .conf sets the scenario env (a CLI --env-file
    # overrides it, resolved below).
    if ((${#SCENARIO_ARGS[@]})); then
        _want=""
        for _a in "${SCENARIO_ARGS[@]}"; do
            case "$_want" in envfile) _conf_env_file="$_a"; _want=""; continue ;; esac
            [[ "$_a" == --env-file ]] && _want="envfile"
        done
    fi
fi

# Effective env file: a CLI --env-file wins over the .conf's. Export it so
# _common.sh layers it on top of the base .env.
_env_file="${_cli_env_file:-$_conf_env_file}"
if [[ -n "$_env_file" ]]; then
    [[ -f "$_env_file" ]] || _prescan_fail "--env-file '$_env_file' does not exist"
    export CLAUDE_ENV_FILE="$_env_file"
fi

source "$(dirname "${BASH_SOURCE[0]}")/_common.sh"

usage() { sed -n '2,87p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

ORG=""
OUT=""
PORT_BASE="$SSH_PORT_RANGE_START"
LIMIT=500
WANT_FORKS=0 WANT_ARCHIVED=0 ALL_DORMANT=0
NETWORK=""
# Shared tool cache: ONE volume shared by every service, mounted at /cache.
# Default = the CACHE_VOLUME name (claude-cache); --no-cache / --cache off disables it.
CACHE_VOL="$CACHE_VOLUME"
BUILD_CONTEXT=""
DORMANT_PROFILE="dormant"
INCLUDE=() EXCLUDE=() REPO_ARGS=() ACTIVE_RAW=() EXPOSE_RAW=() DEVCMD_RAW=() CPU_RAW=() MEM_RAW=() BROWSER_RAW=() DOCKER_RAW=() MKTS_RAW=() PLUGINS_RAW=() MODEL_RAW=() MOUNTS_RAW=() ACCOUNTS_RAW=()
# Scenario flags (from --scenario, expanded above) go FIRST; the real CLI args
# follow so they override scalars (--out/--org/--port-base) and append to
# repeatables (--active/--expose/…). --scenario/--env-file were consumed in the
# pre-scan but stay in the stream; the loop treats them as no-ops.
if ((${#SCENARIO_ARGS[@]})); then set -- "${SCENARIO_ARGS[@]}" "$@"; fi
while [[ $# -gt 0 ]]; do
    case "$1" in
        --org)             ORG="$2"; shift 2 ;;
        --out)             OUT="$2"; shift 2 ;;
        --port-base)       PORT_BASE="$2"; shift 2 ;;
        --include)         INCLUDE+=("$2"); shift 2 ;;
        --exclude)         EXCLUDE+=("$2"); shift 2 ;;
        --active)          ACTIVE_RAW+=("$2"); shift 2 ;;
        --expose)          EXPOSE_RAW+=("$2"); shift 2 ;;
        --dev-cmd)         DEVCMD_RAW+=("$2"); shift 2 ;;
        --cpu)             CPU_RAW+=("$2"); shift 2 ;;
        --mem)             MEM_RAW+=("$2"); shift 2 ;;
        --model)           MODEL_RAW+=("$2"); shift 2 ;;
        --browser)         BROWSER_RAW+=("$2"); shift 2 ;;
        --docker)          DOCKER_RAW+=("$2"); shift 2 ;;
        --broker|--worker-tarball)
            die "claude-compose-gen: $1 was removed (the legacy Sysbox worker-broker substrate is retired; see docs/legacy-sysbox-broker.md)" ;;
        --marketplace)     MKTS_RAW+=("$2"); shift 2 ;;
        --plugin)          PLUGINS_RAW+=("$2"); shift 2 ;;
        --mount)           MOUNTS_RAW+=("$2"); shift 2 ;;
        --accounts)        ACCOUNTS_RAW+=("$2"); shift 2 ;;
        --build-context)   BUILD_CONTEXT="$2"; shift 2 ;;
        --dormant-profile) DORMANT_PROFILE="$2"; shift 2 ;;
        --forks)           WANT_FORKS=1; shift ;;
        --archived)        WANT_ARCHIVED=1; shift ;;
        --all-dormant)     ALL_DORMANT=1; shift ;;
        --network)         NETWORK="$2"; shift 2 ;;
        --cache)           CACHE_VOL="$2"; shift 2 ;;
        --no-cache)        CACHE_VOL=""; shift ;;
        --limit)           LIMIT="$2"; shift 2 ;;
        --scenario)        shift 2 ;;   # consumed in the pre-scan above
        --env-file)        shift 2 ;;   # consumed in the pre-scan above
        -h|--help)         usage 0 ;;
        -*)                die "unknown option: $1 (try --help)" ;;
        *)                 REPO_ARGS+=("$1"); shift ;;
    esac
done

# Shared tool cache: normalize the requested volume to its effective name
# ("" / off / none disable it). One shared volume across all services = the
# cross-worker cache hit; disabled = per-container installs.
CACHE_NAME="$(cache_name "$CACHE_VOL")"

# No host- or org-specific defaults: this is a shared tool. Caller must say
# where to write and (for gh enumeration) which org.
[[ -n "$OUT" ]] || die "--out <file> is required, and must be OUTSIDE this repo
       (a deploy location), e.g. --out /srv/claude/docker-compose.yml"
if [[ ${#REPO_ARGS[@]} -eq 0 && -z "$ORG" ]]; then
    die "give --org <name> to enumerate via gh, or pass repo names as args"
fi

# Active set: sanitized service names that start by default. Empty = all
# active (no profiles emitted, backward compatible). --all-dormant forces
# the opposite pole: EVERY service behind the dormant profile (so a plain
# `up -d` starts nothing and you bring services up on demand): the faithful
# default for a stack whose services are all dormant today.
declare -A ACTIVE=()
HAVE_ACTIVE=0
[[ "$ALL_DORMANT" == 1 ]] && HAVE_ACTIVE=1
for tok in "${ACTIVE_RAW[@]:-}"; do
    [[ -n "$tok" ]] || continue
    for one in $(echo "$tok" | tr ',' ' '); do
        ACTIVE["$(sanitize "$one")"]=1; HAVE_ACTIVE=1
    done
done

# Extra published ports per service: svc -> newline-separated "HOST:CONTAINER".
declare -A EXPOSE=()
for tok in "${EXPOSE_RAW[@]:-}"; do
    [[ -n "$tok" ]] || continue
    IFS=: read -r er eh ec <<<"$tok"
    [[ -n "$er" && "$eh" =~ ^[0-9]+$ && "$ec" =~ ^[0-9]+$ ]] \
        || die "--expose must be REPO:HOSTPORT:CONTAINERPORT (got '$tok')"
    es="$(sanitize "$er")"
    EXPOSE[$es]="${EXPOSE[$es]:-}${EXPOSE[$es]:+$'\n'}${eh}:${ec}"
done

# Auto-start dev command per service: svc -> command string (boot tmux window).
declare -A DEVCMD=()
for tok in "${DEVCMD_RAW[@]:-}"; do
    [[ -n "$tok" ]] || continue
    [[ "$tok" == *=* ]] || die "--dev-cmd must be REPO=COMMAND (got '$tok')"
    DEVCMD["$(sanitize "${tok%%=*}")"]="${tok#*=}"
done

# Per-repo resource overrides: svc -> value. Repos with no entry fall back to
# the global CLAUDE_CPU_LIMIT / CLAUDE_MEM_LIMIT at emit time.
declare -A CPU=() MEM=()
for tok in "${CPU_RAW[@]:-}"; do
    [[ -n "$tok" ]] || continue
    [[ "$tok" == *=* ]] || die "--cpu must be REPO=N (got '$tok')"
    cpv="${tok#*=}"
    [[ "$cpv" =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "--cpu value must be a number (got '$cpv')"
    CPU["$(sanitize "${tok%%=*}")"]="$cpv"
done
for tok in "${MEM_RAW[@]:-}"; do
    [[ -n "$tok" ]] || continue
    [[ "$tok" == *=* ]] || die "--mem must be REPO=SIZE (got '$tok')"
    mmv="${tok#*=}"
    [[ "$mmv" =~ ^[0-9]+[bkmgBKMG]?$ ]] || die "--mem value must be a size like 4g (got '$mmv')"
    MEM["$(sanitize "${tok%%=*}")"]="$mmv"
done
# Per-repo model override: svc -> model alias/id. Repos with no entry inherit the
# CLAUDE_MODEL env var at run time, falling back to opus (the best available).
declare -A MODEL=()
for tok in "${MODEL_RAW[@]:-}"; do
    [[ -n "$tok" ]] || continue
    [[ "$tok" == *=* ]] || die "--model must be REPO=MODEL (got '$tok')"
    mdv="${tok#*=}"
    [[ -n "$mdv" ]] || die "--model '$tok' has no model after '='"
    MODEL["$(sanitize "${tok%%=*}")"]="$mdv"
done
# Frontend debugging: services with chrome-devtools MCP enabled (CLAUDE_BROWSER=1).
# Image must be built with WITH_BROWSER=1 (`make build-browser`).
declare -A BROWSER=()
for tok in "${BROWSER_RAW[@]:-}"; do
    [[ -n "$tok" ]] || continue
    for one in $(echo "$tok" | tr ',' ' '); do
        BROWSER["$(sanitize "$one")"]=1
    done
done

# Container workflows: services with their own Docker engine (CLAUDE_DOCKER=1), able to
# build images and run containers/compose stacks. Image must be built with WITH_DOCKER=1
# (`make build-docker`), and the service runs under the Sysbox runtime.
declare -A DOCKER=()
for tok in "${DOCKER_RAW[@]:-}"; do
    [[ -n "$tok" ]] || continue
    for one in $(echo "$tok" | tr ',' ' '); do
        DOCKER["$(sanitize "$one")"]=1
    done
done
# Fail here, not at `up`: without the runtime the inner daemon has no user namespace and
# the container dies on a 60s entrypoint timeout, which reads as a mysterious boot failure.
(( ${#DOCKER[@]} > 0 )) && preflight_sysbox

# Runtime plugin marketplaces per service: svc -> comma-separated "name=url" list.
# Each --marketplace value is REPO=NAME=URL: split on the FIRST = to peel off
# the repo, keep the rest verbatim (URLs commonly contain =, : and @).
declare -A MKTS=()
for tok in "${MKTS_RAW[@]:-}"; do
    [[ -n "$tok" ]] || continue
    [[ "$tok" == *=*=* ]] || die "--marketplace must be REPO=NAME=URL (got '$tok')"
    ms="$(sanitize "${tok%%=*}")"
    mv="${tok#*=}"
    MKTS[$ms]="${MKTS[$ms]:-}${MKTS[$ms]:+,}${mv}"
done

# Runtime plugins per service: svc -> comma-separated "name@mkt" list. Each
# --plugin value is REPO=PLUGIN[,PLUGIN...]; split on first = then accumulate.
declare -A PLUGINS=()
for tok in "${PLUGINS_RAW[@]:-}"; do
    [[ -n "$tok" ]] || continue
    [[ "$tok" == *=* ]] || die "--plugin must be REPO=PLUGIN[,PLUGIN...] (got '$tok')"
    ps="$(sanitize "${tok%%=*}")"
    pv="${tok#*=}"
    [[ -n "$pv" ]] || die "--plugin '$tok' has no plugins after '='"
    PLUGINS[$ps]="${PLUGINS[$ps]:-}${PLUGINS[$ps]:+,}${pv}"
done

# Extra named volumes per service: svc -> newline-separated "VOLUME:/PATH[:ro]".
# Each --mount value is REPO=VOLUME:/PATH[:ro]. The volume is FOREIGN by design
# (it belongs to another stack), so it is declared external below: `up` fails
# fast if it's missing, and a `down -v` here can never delete someone else's data.
declare -A MOUNTS=()
declare -A MOUNT_VOLS=()   # volume name -> 1, for the top-level external block
for tok in "${MOUNTS_RAW[@]:-}"; do
    [[ -n "$tok" ]] || continue
    [[ "$tok" == *=* ]] || die "--mount must be REPO=VOLUME:/PATH[:ro] (got '$tok')"
    us="$(sanitize "${tok%%=*}")"
    uv="${tok#*=}"
    IFS=: read -r mvol mpath mopt <<<"$uv"
    # A named volume only: a host path here would punch a hole out of the
    # container's filesystem, which is not what this flag is for.
    [[ "$mvol" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] \
        || die "--mount volume must be a named volume, not a path (got '$mvol' in '$tok')"
    [[ "$mpath" == /* ]] \
        || die "--mount path must be absolute (got '$mpath' in '$tok')"
    [[ -z "$mopt" || "$mopt" == "ro" || "$mopt" == "rw" ]] \
        || die "--mount option must be ro or rw (got '$mopt' in '$tok')"
    # Refuse to shadow a mount the service already owns: silently masking the
    # workspace or config volume would be near-impossible to debug from inside.
    case "$mpath" in
        /workspace|/home/claude/.claude|/auth|/cache|/etc/ssh/host-keys|/etc/claude/*)
            die "--mount path '$mpath' would shadow a mount the service already has (in '$tok')" ;;
    esac
    MOUNTS[$us]="${MOUNTS[$us]:-}${MOUNTS[$us]:+$'\n'}${mvol}:${mpath}${mopt:+:$mopt}"
    MOUNT_VOLS[$mvol]=1
done

# Named-account rotation per service: svc -> comma-separated account names.
# Each name's physical claude-auth-<name> volume (account_auth_volume, _common.sh)
# is SHARED/external like claude-auth itself, not owned by any one service: several
# repos (or stacks) can reference the same account, so ACCOUNT_VOLS just collects
# the distinct set for one external declaration each, not an ownership check like
# MOUNT_VOLS above.
declare -A ACCOUNTS=()
declare -A ACCOUNT_VOLS=()
for tok in "${ACCOUNTS_RAW[@]:-}"; do
    [[ -n "$tok" ]] || continue
    [[ "$tok" == *=* ]] || die "--accounts must be REPO=name1,name2,... (got '$tok')"
    as="$(sanitize "${tok%%=*}")"
    av="${tok#*=}"
    [[ -n "$av" ]] || die "--accounts '$tok' has no account names after '='"
    for one in $(echo "$av" | tr ',' ' '); do
        one="$(sanitize "$one")"
        ACCOUNTS[$as]="${ACCOUNTS[$as]:-}${ACCOUNTS[$as]:+,}${one}"
        ACCOUNT_VOLS["$(account_auth_volume "$one")"]=1
    done
done

# The generated multi-repo compose is deployment config, not part of this
# project: refuse to write it anywhere inside the repo so it can't be
# committed here by accident. Resolve paths without requiring them to exist.
abspath() {
    if command -v realpath >/dev/null 2>&1; then realpath -m -- "$1"
    else case "$1" in /*) printf '%s\n' "$1";; *) printf '%s\n' "$PWD/$1";; esac
    fi
}
OUT_ABS="$(abspath "$OUT")"
REPO_ABS="$(abspath "$CLAUDE_DOCKER_ROOT")"
case "$OUT_ABS/" in
    "$REPO_ABS"/*)
        die "refusing to write inside the repo ($REPO_ABS).
       This is deployment config: point --out at a path outside the repo,
       e.g. --out /srv/claude/docker-compose.yml" ;;
esac

# Build context defaults to the checkout the generator runs from, but a stack is
# often regenerated from a DIFFERENT clone of this repo than the one the deployment
# builds from, which silently rewrites build.context on every service. Pin it in
# the scenario (--build-context) so regen is reproducible from any checkout.
ABS_CONTEXT="${BUILD_CONTEXT:-$CLAUDE_DOCKER_ROOT}"
# Shared, host-wide, external volumes the operator must create once. claude-auth is
# listed separately in the header (it's `make login`'s job, not a bare create).
SHARED_VOL_LIST="${SSHKEYS_VOLUME}${CACHE_NAME:+ $CACHE_NAME}"
[[ -d "$ABS_CONTEXT" ]] || die "--build-context '$ABS_CONTEXT' is not a directory"
# Compose has no ~ expansion: resolve host SSH paths to absolute now.
AK="${SSH_AUTHORIZED_KEYS/#\~/$HOME}"
GK="${GIT_SSH_KEY/#\~/$HOME}"
# Optional: bind every SSH port to one host interface (CLAUDE_SSH_BIND).
BIND_PREFIX="${CLAUDE_SSH_BIND:+${CLAUDE_SSH_BIND}:}"
GH_NAME="$(git config --global user.name  2>/dev/null || true)"
GH_MAIL="$(git config --global user.email 2>/dev/null || true)"
# --browser services need an image with Chromium + chrome-devtools-mcp baked
# in; non-browser services keep the lean CLAUDE_IMAGE. Default to the standard
# `make build-browser` tag; override with CLAUDE_IMAGE_BROWSER.
BROWSER_IMAGE="${CLAUDE_IMAGE_BROWSER:-claude-code-box:browser}"
# --docker services need an engine baked in (`make build-docker`); a service that is BOTH
# needs the image with both (`make build-docker-browser`), since these are baked, not mounted.
DOCKER_IMAGE="${CLAUDE_IMAGE_DOCKER:-claude-code-box:docker}"
DOCKER_BROWSER_IMAGE="${CLAUDE_IMAGE_DOCKER_BROWSER:-claude-code-box:docker-browser}"
# Browser variants put /scratch (TMPDIR) on a bounded RAM tmpfs instead of the disk
# volume the build-repos use, and cap pids harder. This box is all-HDD: chromium/
# lighthouse/ffmpeg temp churn on the spinning rpool mirror starved I/O until hundreds
# of jobs wedged in uninterruptible D-state and the container went unkillable (super,
# 2026-07-24). Non-browser build-repos keep disk /scratch so big pip/uv installs don't
# ENOSPC (see the TMPDIR note below). Override sizes via the env vars.
BROWSER_SCRATCH_TMPFS="${CLAUDE_BROWSER_SCRATCH_TMPFS:-6g}"
BROWSER_PIDS_LIMIT="${CLAUDE_BROWSER_PIDS_LIMIT:-1024}"

# --- Collect repos as "owner<TAB>name<TAB>branch" -----------------------------
# Two independent sources, combined: (1) gh enumeration of --org (owner=ORG for
# every repo), and (2) explicit repo args. An explicit arg may carry its own
# owner as "owner/repo[:branch]" to pull a repo from outside --org; bare
# "repo[:branch]" defaults its owner to ORG. This lets one compose mix a whole
# org with a few one-off repos from elsewhere.
declare -a REPOS=()
if [[ -n "$ORG" ]]; then
    command -v gh >/dev/null 2>&1 \
        || die "gh not found and --org given. Install/auth gh, or drop --org and pass owner/repo args."
    gh auth status >/dev/null 2>&1 \
        || die "gh is not authenticated. Run 'gh auth login' first."
    info "Enumerating ${ORG}/* via gh…"
    json="$(gh repo list "$ORG" --limit "$LIMIT" \
        --json name,isFork,isArchived 2>/dev/null)" \
        || die "gh repo list $ORG failed"
    while IFS=$'\t' read -r name branch; do
        [[ -n "$name" ]] && REPOS+=("$ORG	$name	$branch")
    done < <(echo "$json" | jq -r --argjson f "$WANT_FORKS" --argjson a "$WANT_ARCHIVED" '
        .[] | select(($f==1 or (.isFork|not)) and ($a==1 or (.isArchived|not)))
        | [.name, ""] | @tsv')
fi
for r in "${REPO_ARGS[@]:-}"; do
    [[ -n "$r" ]] || continue
    spec="${r%%:*}"
    branch="$( [[ "$r" == *:* ]] && echo "${r#*:}" || echo '' )"
    if [[ "$spec" == */* ]]; then owner="${spec%%/*}"; name="${spec##*/}"
    else owner="$ORG"; name="$spec"; fi
    [[ -n "$owner" ]] || die "repo '$r' has no owner: pass owner/repo or set --org"
    [[ -n "$name"  ]] || die "repo '$r' has no name"
    REPOS+=("$owner	$name	$branch")
done
[[ ${#REPOS[@]} -gt 0 ]] || die "no repos to emit (pass repo args or --org)"

# --- Apply include/exclude, sanitize, sort, dedupe ---------------------------
declare -A SEEN=()
declare -a FINAL=()
match_any() { local n="$1"; shift; for g in "$@"; do [[ "$n" == $g ]] && return 0; done; return 1; }
# sort by repo name so port assignment is stable across regenerations
while IFS=$'\t' read -r owner name branch; do
    [[ -n "$name" ]] || continue
    if [[ ${#INCLUDE[@]} -gt 0 ]]; then match_any "$name" "${INCLUDE[@]}" || continue; fi
    if [[ ${#EXCLUDE[@]} -gt 0 ]]; then match_any "$name" "${EXCLUDE[@]}" && continue; fi
    s="$(sanitize "$name")"
    [[ -n "${SEEN[$s]:-}" ]] && continue
    SEEN[$s]=1
    FINAL+=("$s	$owner	$name	$branch")
done < <(printf '%s\n' "${REPOS[@]}" | sort -f)

[[ ${#FINAL[@]} -gt 0 ]] || die "no repos selected (after filters)"

# --- Stable SSH port assignment ----------------------------------------------
# Reuse each repo's previously assigned port from an existing OUT file; only
# brand-new repos take the next free port. Adding a repo never reshuffles
# running containers.
declare -A SVCPORT=() USEDPORT=()
if [[ -f "$OUT" ]]; then
    while IFS=$'\t' read -r psvc pport; do
        [[ -n "$psvc" && -n "$pport" ]] || continue
        SVCPORT[$psvc]="$pport"; USEDPORT[$pport]=1
    done < <(awk '
        /^[[:space:]]*container_name:[[:space:]]*claude-/ {
            s=$0; sub(/^[[:space:]]*container_name:[[:space:]]*claude-/,"",s);
            sub(/[[:space:]]+$/,"",s) }
        /^[[:space:]]*claude\.ssh_port:/ {
            p=$0; gsub(/[^0-9]/,"",p); if(s!=""){print s"\t"p; s=""} }
    ' "$OUT")
fi
# Also reserve ports already bound by ANY claude.managed container host-wide
# (other stacks + standalone launches like `super`), so a new repo in THIS
# stack never collides across stacks. Additive to the same-file readback above;
# SVCPORT (stable per-repo ports) is untouched. Fails safe if docker is
# unreachable: ports_used_by_claude ends in `|| true` and prints nothing.
while IFS= read -r pport; do
    [[ "$pport" =~ ^[0-9]+$ ]] && USEDPORT[$pport]=1
done < <(ports_used_by_claude)
# next_port marks USEDPORT and reports the chosen port in the global NEXT_PORT.
# It must NOT be called via $(...): a command-substitution subshell would
# discard the USEDPORT updates, so every new repo would get the same port.
NEXT_PORT=""
next_port() {
    local p
    for ((p=PORT_BASE; p<=SSH_PORT_RANGE_END; p++)); do
        [[ -n "${USEDPORT[$p]:-}" ]] && continue
        USEDPORT[$p]=1; NEXT_PORT="$p"; return 0
    done
    die "no free SSH port in ${PORT_BASE}-${SSH_PORT_RANGE_END} for new repos"
}
for row in "${FINAL[@]}"; do
    IFS=$'\t' read -r svc _ _ <<<"$row"
    [[ -n "${SVCPORT[$svc]:-}" ]] && continue
    next_port
    SVCPORT[$svc]="$NEXT_PORT"
done

# --- Emit compose ------------------------------------------------------------
mkdir -p "$(dirname "$OUT")"
TMP="$(mktemp)"
{
cat <<EOF
# GENERATED by bin/claude-compose-gen: do not hand-edit; regenerate instead.
# One Claude Code session container per ${ORG}/* repo. Each is reachable by SSH
# (its own host port) and in the Claude mobile app (Remote Control), and shows
# up in \`claude-list\` (shares the claude.managed labels).
#
# Prerequisites (once):
#   1. Build the image:        make build           # in ${ABS_CONTEXT}
#   2. One-time OAuth login:    make login           # writes the claude-auth volume
#   3. Shared host-wide volumes: create once (empty is fine, they self-seed):
#        for v in ${SHARED_VOL_LIST}; do docker volume create "\$v"; done
#      These are declared external because EVERY stack and standalone container
#      mounts the same ones: a 'down -v' on one stack would otherwise rotate the
#      whole fleet's SSH host keys and wipe the shared tool cache.
#   4. Authorized SSH pubkey:   ${AK}
#   5. Git deploy key w/ ${ORG} read:  ${GK}
#      (its .pub added to the ${ORG} org / each repo as a read/write deploy key)
#
# Resource model: only "active" repos start by default. Every other repo is
# still defined but behind the "${DORMANT_PROFILE}" Compose profile, so it
# consumes ZERO resources until you explicitly ask for it.
#
# Bring up / down:
#   docker compose -f ${OUT} up -d                  # active repos only
#   docker compose -f ${OUT} up -d <repo>           # one dormant repo, on demand
#   docker compose -f ${OUT} --profile ${DORMANT_PROFILE} up -d   # ALL repos
#   docker compose -f ${OUT} stop <repo>            # free its resources
#   docker compose -f ${OUT} down                   # stop all (add -v for volumes)
#
# Never set ANTHROPIC_API_KEY (the entrypoint hard-fails: OAuth only).

services:
EOF

for row in "${FINAL[@]}"; do
    IFS=$'\t' read -r svc owner name branch <<<"$row"
    url="git@github.com:${owner}/${name}.git"
    port="${SVCPORT[$svc]}"
    svc_cpu="${CPU[$svc]:-$CLAUDE_CPU_LIMIT}"
    svc_mem="${MEM[$svc]:-$CLAUDE_MEM_LIMIT}"
    # Soft memory floor rides the effective limit: the global reservation for the
    # global limit, a derived 75% for a per-repo --mem override, so an override
    # can never invert reservation > limit (the daemon rejects that).
    if [[ "$svc_mem" == "$CLAUDE_MEM_LIMIT" ]]; then svc_res="$CLAUDE_MEM_RESERVATION"
    else svc_res="$(mem_reservation_for "$svc_mem")" \
        || die "--mem '$svc_mem' for $svc is unparseable (want e.g. 4g)"; fi
    svc_pids="${CLAUDE_PIDS_LIMIT}"
    # Browser variants: cap pids harder (a chromium/ffmpeg leak fails fast instead of
    # piling up) and put /scratch on a RAM tmpfs (svc_scratch_tmpfs, appended to the
    # tmpfs list) with NO disk volume mount/declaration (svc_scratch_vol left empty).
    # Non-browser build-repos keep the disk-backed scratch volume. See BROWSER_* above.
    if [[ -n "${BROWSER[$svc]:-}" ]]; then
        svc_pids="${BROWSER_PIDS_LIMIT}"
        svc_scratch_tmpfs=$'\n      - /scratch:rw,nosuid,nodev,exec,size='"${BROWSER_SCRATCH_TMPFS}"
        svc_scratch_vol=""
    else
        svc_scratch_tmpfs=""
        svc_scratch_vol=$'\n      - claude-scratch-'"${svc}"':/scratch'
    fi
    # Auth mount: either the single shared claude-auth volume (default), or one
    # read-write mount per named account (--accounts) at /auth-accounts/<name>:
    # mutually exclusive per service, mirroring claude-launch --accounts. Read-write:
    # the credential reconcile loop writes refreshed tokens back into whichever
    # account volume is active.
    if [[ -n "${ACCOUNTS[$svc]:-}" ]]; then
        svc_auth_lines=""
        for one in $(echo "${ACCOUNTS[$svc]}" | tr ',' ' '); do
            svc_auth_lines+=$'\n      - '"$(account_auth_volume "$one")"':/auth-accounts/'"${one}"
        done
    else
        svc_auth_lines=$'\n      - claude-auth:/auth'
    fi
    # Per-repo --model override emits a literal; otherwise emit a compose
    # interpolation so a fleet-wide CLAUDE_MODEL (env/.env) wins, defaulting to
    # opus, the best available model, when nothing is set.
    if [[ -n "${MODEL[$svc]:-}" ]]; then svc_model="${MODEL[$svc]}"
    else svc_model='${CLAUDE_MODEL:-opus}'; fi
    # Image selection. --browser and --docker are orthogonal capabilities but they are
    # baked, not mounted, so a service needing both needs the image that has both.
    svc_image="${CLAUDE_IMAGE}"
    if   [[ -n "${BROWSER[$svc]:-}" && -n "${DOCKER[$svc]:-}" ]]; then svc_image="$DOCKER_BROWSER_IMAGE"
    elif [[ -n "${BROWSER[$svc]:-}" ]];                          then svc_image="$BROWSER_IMAGE"
    elif [[ -n "${DOCKER[$svc]:-}" ]];                           then svc_image="$DOCKER_IMAGE"
    fi
    cat <<EOF
  ${svc}:
    image: ${svc_image}
    build:
      context: ${ABS_CONTEXT}
      args:
        NODE_VERSION: "\${NODE_VERSION:-24}"
        CLAUDE_CODE_VERSION: "\${CLAUDE_CODE_VERSION:-2.1.258}"
        UV_VERSION: "\${UV_VERSION:-latest}"
        PNPM_VERSION: "\${PNPM_VERSION:-latest}"
        CLAUDE_UID: "\${CLAUDE_UID:-1000}"
        CLAUDE_GID: "\${CLAUDE_GID:-1000}"
        CLAUDE_USER: "\${CLAUDE_USER:-claude}"
        # The variant build args MUST ride along, because \`image:\` and \`build:\` are both
        # set: compose builds from this context whenever the tagged image is MISSING (and on
        # \`build\` / \`up --build\`), then tags the result with that name. Omitting these
        # silently produced a LEAN image wearing the :browser/:docker tag, a --browser
        # service would come up with no chrome-devtools MCP, and a --docker service would
        # fail to boot outright ("dockerd is not in this image"), with the tag insisting
        # otherwise. Emit them per service so the built image matches the tag it is given.
        WITH_BROWSER: "${BROWSER[$svc]:-0}"
        WITH_DOCKER: "${DOCKER[$svc]:-0}"
    container_name: claude-${svc}
    hostname: ${svc}
    restart: unless-stopped
    init: true
    shm_size: ${CLAUDE_SHM_SIZE}
    cpus: ${svc_cpu}
    mem_limit: ${svc_mem}
    # memswap_limit == mem_limit disables container swap (cgroup memory.swap.max=0):
    # a runaway session OOM-kills inside its OWN cgroup instead of thrashing host
    # swap. Host swap lives on a ZFS zvol (rpool/swap) on an HDD mirror; letting a
    # container swap there deadlocked the whole box on 2026-07-09. Keep these equal.
    memswap_limit: ${svc_mem}
    mem_reservation: ${svc_res}
    pids_limit: ${svc_pids}
    stop_grace_period: ${CLAUDE_STOP_TIMEOUT}s
    tmpfs:
      - /tmp:rw,nosuid,nodev,exec,size=1g${svc_scratch_tmpfs}
    ports:
      - "${BIND_PREFIX}${port}:22"
EOF
    # Extra published ports (dev servers) belong to the ports: list, emit them
    # HERE, right after the SSH port. Emitting them after cap_add (as an earlier
    # version did) made YAML attach them to the cap_add list, so the mapping was
    # silently parsed as a bogus capability instead of a published port.
    if [[ -n "${EXPOSE[$svc]:-}" ]]; then
        while IFS= read -r m; do
            [[ -n "$m" ]] && echo "      - \"${m}\""
        done <<<"${EXPOSE[$svc]}"
    fi
    # --docker: run this service under Sysbox, which puts the inner dockerd in a user
    # namespace (container-root → an unprivileged host uid). That is what makes nested
    # Docker safe with no --privileged and no host-socket mount, both of which would give
    # the agent the host. Compose's `runtime:` is the v2 spec field for exactly this.
    [[ -n "${DOCKER[$svc]:-}" ]] && echo "    runtime: sysbox-runc"
    # Escape hardening (mirrors claude-launch via _common.sh): no-new-privileges
    # always; drop ALL caps + re-add the minimal set unless CLAUDE_HARDEN_CAPS=0;
    # add NET_ADMIN when the egress firewall is enabled.
    #
    # A --docker service SKIPS the cap-drop: an inner daemon cannot run under the minimal
    # set (it needs NET_ADMIN for its bridge/iptables and SYS_ADMIN to mount layers, and
    # neither is even in Docker's default set). Sysbox grants container-root the full set
    # anyway: measured CapEff 000001ffffffffff with uid_map 0→165536, but those caps are
    # powers over the container's own userns, not the host. Same trade as claude-launch's
    # harden_run_args, kept per-service so a lean sibling in the same stack stays hardened.
    echo "    security_opt:"
    echo "      - no-new-privileges:true"
    _caps=""
    if [[ -z "${DOCKER[$svc]:-}" ]] && [[ "$CLAUDE_HARDEN_CAPS" =~ ^(1|true|yes|on)$ ]]; then
        echo "    cap_drop:"
        echo "      - ALL"
        _caps="$CLAUDE_MIN_CAPS"
    fi
    # `strict` is the fail-CLOSED spelling of lockdown and needs the same capability:
    # a strict service denied NET_ADMIN could never apply its ruleset, and would
    # therefore refuse to start on every `up`.
    [[ "${CLAUDE_EGRESS_LOCKDOWN:-0}" =~ ^(1|true|yes|on|strict)$ ]] && _caps="$_caps NET_ADMIN"
    if [[ -n "${_caps// }" ]]; then
        echo "    cap_add:"
        for c in $_caps; do echo "      - $c"; done
    fi
    cat <<EOF
    environment:
      CLAUDE_PROJECT_NAME: "${svc}"
      CLAUDE_MODEL: "${svc_model}"
      CLAUDE_PERMISSION_MODE: "\${CLAUDE_PERMISSION_MODE:-bypassPermissions}"
      # Managed policy is the DEFAULT (entrypoint.sh §7a), so the compose default
      # has to be 1: a stack whose operator never set this must get the policy
      # delivered root-owned, not left only in the agent-writable settings.json.
      CLAUDE_MANAGED_POLICY: "\${CLAUDE_MANAGED_POLICY:-1}"
      CLAUDE_SECRET_GUARD: "\${CLAUDE_SECRET_GUARD:-1}"
      # Brokering is the DEFAULT (entrypoint.sh §5): the compose default has to be
      # 1, not 0, or a stack whose operator never set this would receive an
      # explicit opt-out and get the agent-readable key file the default exists to
      # avoid. Set CLAUDE_BROKER_GIT_KEY=0 in the environment to opt out.
      CLAUDE_BROKER_GIT_KEY: "\${CLAUDE_BROKER_GIT_KEY:-1}"
      CLAUDE_EGRESS_LOCKDOWN: "\${CLAUDE_EGRESS_LOCKDOWN:-0}"
      CLAUDE_EGRESS_EXTRA_HOSTS: "\${CLAUDE_EGRESS_EXTRA_HOSTS:-}"
      # Empty by default = no periodic re-resolve, which is byte-identical to a build
      # without the feature. Set it to a number of seconds in .env to keep a long-lived
      # stack's pinned allowlist current (see .env.example).
      CLAUDE_EGRESS_REFRESH_INTERVAL: "\${CLAUDE_EGRESS_REFRESH_INTERVAL:-}"
      CLAUDE_OTEL_ENABLED: "\${CLAUDE_OTEL_ENABLED:-0}"
      CLAUDE_OTEL_TRACES: "\${CLAUDE_OTEL_TRACES:-0}"
      OTEL_EXPORTER_OTLP_ENDPOINT: "\${OTEL_EXPORTER_OTLP_ENDPOINT:-}"
      OTEL_EXPORTER_OTLP_PROTOCOL: "\${OTEL_EXPORTER_OTLP_PROTOCOL:-}"
      OTEL_EXPORTER_OTLP_HEADERS: "\${OTEL_EXPORTER_OTLP_HEADERS:-}"
      OTEL_RESOURCE_ATTRIBUTES: "\${OTEL_RESOURCE_ATTRIBUTES:-}"
      # Native Claude Code CLI tuning (real upstream env vars, not a wrapper,
      # see .env.example). Unset by default = upstream's own defaults.
      CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION: "\${CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION:-}"
      BASH_DEFAULT_TIMEOUT_MS: "\${BASH_DEFAULT_TIMEOUT_MS:-}"
      BASH_MAX_TIMEOUT_MS: "\${BASH_MAX_TIMEOUT_MS:-}"
      API_TIMEOUT_MS: "\${API_TIMEOUT_MS:-}"
      GIT_REPO_URL: "${url}"
EOF
    [[ -n "$branch" ]] && echo "      GIT_REPO_BRANCH: \"${branch}\""
    if [[ -n "${DEVCMD[$svc]:-}" ]]; then
        dc="${DEVCMD[$svc]}"
        dc="${dc//\\/\\\\}"; dc="${dc//\"/\\\"}"; dc="${dc//\$/\$\$}"
        echo "      CLAUDE_DEV_CMD: \"${dc}\""
    fi
    [[ -n "${BROWSER[$svc]:-}" ]] && echo '      CLAUDE_BROWSER: "1"'
    [[ -n "${DOCKER[$svc]:-}" ]]  && echo '      CLAUDE_DOCKER: "1"'
    # Account names come only from sanitize() (charset [a-z0-9._-]), so no
    # quoting hazard, unlike CLAUDE_DEV_CMD/MKTS/PLUGINS: no escaping needed.
    [[ -n "${ACCOUNTS[$svc]:-}" ]] && echo "      CLAUDE_ACCOUNTS: \"${ACCOUNTS[$svc]}\""
    # Disk-backed TMPDIR. Without it everything temp (pip/uv wheel builds, docker
    # save|load tarballs, the inner containerd's mount dirs) defaults to /tmp: a 1g
    # tmpfs in RAM, and a big install dies with ENOSPC while the pool sits mostly empty.
    echo '      TMPDIR: "/scratch"'
    # Marketplace/plugin lists: quote and escape \, ", and $ the same way as
    # CLAUDE_DEV_CMD so compose doesn't interpolate URL fragments like $foo.
    if [[ -n "${MKTS[$svc]:-}" ]]; then
        mv="${MKTS[$svc]}"
        mv="${mv//\\/\\\\}"; mv="${mv//\"/\\\"}"; mv="${mv//\$/\$\$}"
        echo "      CLAUDE_EXTRA_MARKETPLACES: \"${mv}\""
    fi
    if [[ -n "${PLUGINS[$svc]:-}" ]]; then
        pv="${PLUGINS[$svc]}"
        pv="${pv//\\/\\\\}"; pv="${pv//\"/\\\"}"; pv="${pv//\$/\$\$}"
        echo "      CLAUDE_EXTRA_PLUGINS: \"${pv}\""
    fi
    cat <<EOF
      GIT_AUTHOR_NAME: "${GH_NAME}"
      GIT_AUTHOR_EMAIL: "${GH_MAIL}"
      GIT_COMMITTER_NAME: "${GH_NAME}"
      GIT_COMMITTER_EMAIL: "${GH_MAIL}"
      GH_TOKEN: "\${GH_TOKEN:-}"
    volumes:${svc_auth_lines}
      - claude-sshkeys:/etc/ssh/host-keys
      - claude-config-${svc}:/home/claude/.claude
      - claude-ws-${svc}:/workspace${svc_scratch_vol}${CACHE_NAME:+
      - claude-cache:/cache}
EOF
    # Extra foreign volumes (--mount): another stack's workspace, usually :ro.
    # Emitted INSIDE the volumes list, before the key binds.
    if [[ -n "${MOUNTS[$svc]:-}" ]]; then
        while IFS= read -r m; do
            [[ -n "$m" ]] || continue
            printf '      - %s\n' "$m"
        done <<< "${MOUNTS[$svc]}"
    fi
    cat <<EOF
      - ${AK}:/etc/claude/authorized_keys:ro
      - ${GK}:/etc/claude/git-key:ro
EOF
    # Inner Docker image store. Sysbox gives the container its own /var/lib/docker, but it
    # dies WITH the container, so without this volume every recreate re-pulls every base
    # image and rebuilds every layer cold. Per-service, never shared: two daemons must not
    # write one image store.
    [[ -n "${DOCKER[$svc]:-}" ]] && echo "      - claude-docker-${svc}:/var/lib/docker"
    cat <<EOF
    labels:
      claude.managed: "1"
      claude.project: "${svc}"
      claude.ssh_port: "${port}"
      claude.repo: "${url}"
      claude.docker: "${DOCKER[$svc]:-0}"
EOF
    # Non-active repos: defined but behind a profile, so `up -d` skips them.
    if [[ $HAVE_ACTIVE -eq 1 && -z "${ACTIVE[$svc]:-}" ]]; then
        printf '    profiles:\n      - %s\n' "$DORMANT_PROFILE"
    fi
done

# top-level volumes.
# claude-auth and claude-sshkeys are SHARED HOST-WIDE: every stack and every
# standalone container mounts the same two. They are external so a `docker compose
# down -v` on ONE stack cannot delete them out from under the others: losing
# claude-auth means re-running `make login`, and losing claude-sshkeys rotates the
# SSH host keys of the whole fleet (every client then gets a MITM warning until
# `ssh-keygen -R` per port). External also means `up` fails fast if they're missing,
# rather than silently creating an empty one.
echo
echo "volumes:"
cat <<EOF
  claude-auth:
    name: ${AUTH_VOLUME}
    external: true
  claude-sshkeys:
    name: ${SSHKEYS_VOLUME}
    external: true
EOF
# Named accounts (--accounts / multi-account OAuth rotation): each
# claude-auth-<name> volume is created once via `claude-account-login <name>`,
# outside this generator, then can be referenced by any number of repos or
# stacks, external for the same reason claude-auth is: a `down -v` on one
# stack must never delete a credential another stack rotates through.
for avol in "${!ACCOUNT_VOLS[@]}"; do
    printf '  %s:\n    name: %s\n    external: true\n' "$avol" "$avol"
done
# Shared tool cache: every service mounts it at /cache, so a mise/cargo/go/
# npm/uv install by one is a hit for the rest. It defaults to ONE name (claude-cache)
# per host, so stacks share it: that's deliberate (a wider cache = more hits), and it
# is why it must be external: otherwise a `down -v` on one stack wipes the cache out
# from under every other stack. Docker still seeds an empty external volume from the
# image's /cache on first mount, so `docker volume create` + `up` behaves as before.
if [[ -n "$CACHE_NAME" ]]; then
    printf '  claude-cache:\n    name: %s\n    external: true\n' "$CACHE_NAME"
fi
declare -A OWNED_VOLS=([${AUTH_VOLUME}]=1 [${SSHKEYS_VOLUME}]=1)
[[ -n "$CACHE_NAME" ]] && OWNED_VOLS[$CACHE_NAME]=1
for row in "${FINAL[@]}"; do
    IFS=$'\t' read -r svc _ _ <<<"$row"
    printf '  claude-config-%s:\n    name: claude-config-%s\n' "$svc" "$svc"
    printf '  claude-ws-%s:\n    name: claude-ws-%s\n' "$svc" "$svc"
    OWNED_VOLS["claude-config-$svc"]=1
    OWNED_VOLS["claude-ws-$svc"]=1
    # Browser variants use a RAM tmpfs for /scratch (see BROWSER_SCRATCH_TMPFS), so there
    # is no disk scratch volume to declare/own. Non-browser build-repos keep the volume.
    if [[ -z "${BROWSER[$svc]:-}" ]]; then
        printf '  claude-scratch-%s:\n    name: claude-scratch-%s\n' "$svc" "$svc"
        OWNED_VOLS["claude-scratch-$svc"]=1
    fi
    # Only --docker services get an image store; declaring it for every service would
    # create empty volumes for sessions that will never run a daemon. It is OWNED by this
    # stack like the config/ws volumes, so register it too: otherwise a --mount naming it
    # would slip past the guard below and get declared a SECOND time as external (a
    # duplicate YAML key), and a `down -v` here would delete an image store another stack
    # believed it had mounted read-only.
    if [[ -n "${DOCKER[$svc]:-}" ]]; then
        printf '  claude-docker-%s:\n    name: claude-docker-%s\n' "$svc" "$svc"
        OWNED_VOLS["claude-docker-$svc"]=1
    fi
done

# --mount volumes belong to ANOTHER stack: declare them external so `up` fails
# fast when one is missing and `down -v` here can never delete them.
for mvol in "${!MOUNT_VOLS[@]}"; do
    [[ -z "${OWNED_VOLS[$mvol]:-}" ]] \
        || die "--mount volume '$mvol' is already managed by this stack: mount a volume from a DIFFERENT stack"
    printf '  %s:\n    name: %s\n    external: true\n' "$mvol" "$mvol"
done

# Shared external network: point this stack's default network at a pre-existing
# external network instead of a per-project "<project>_default". Lets several
# stacks on one host share ONE Docker network, so splitting a stack in two costs
# ZERO extra networks: critical where the daemon's address pool is nearly full.
# Create it once (docker network create ${NETWORK}) before `up`.
if [[ -n "$NETWORK" ]]; then
    cat <<EOF

networks:
  default:
    name: ${NETWORK}
    external: true
EOF
fi
} > "$TMP"

mv -f "$TMP" "$OUT"
if [[ $HAVE_ACTIVE -eq 1 ]]; then
    n_active=0
    for r in "${FINAL[@]}"; do
        IFS=$'\t' read -r s _ _ <<<"$r"
        [[ -n "${ACTIVE[$s]:-}" ]] && n_active=$((n_active+1))
    done
else
    n_active=${#FINAL[@]}
fi
ok "Wrote $OUT  (${#FINAL[@]} services, ${n_active} start by default)"
[[ -n "${CLAUDE_ENV_FILE:-}" ]] && info "env layered from: $CLAUDE_ENV_FILE (on top of the base .env)"
for r in "${FINAL[@]}"; do
    IFS=$'\t' read -r s nm _ <<<"$r"
    if [[ $HAVE_ACTIVE -eq 1 && -z "${ACTIVE[$s]:-}" ]]; then mark="dormant (${DORMANT_PROFILE})"; else mark="ACTIVE"; fi
    extra=""
    [[ -n "${EXPOSE[$s]:-}" ]] && extra=" +ports $(echo "${EXPOSE[$s]}" | tr '\n' ',' | sed 's/,$//')"
    [[ -n "${DEVCMD[$s]:-}" ]] && extra="$extra +dev"
    [[ -n "${CPU[$s]:-}" || -n "${MEM[$s]:-}" ]] && extra="$extra +res(${CPU[$s]:-$CLAUDE_CPU_LIMIT}cpu/${MEM[$s]:-$CLAUDE_MEM_LIMIT})"
    [[ -n "${BROWSER[$s]:-}" ]] && extra="$extra +browser"
    [[ -n "${DOCKER[$s]:-}" ]] && extra="$extra +docker(sysbox)"
    [[ -n "${MODEL[$s]:-}" ]] && extra="$extra +model(${MODEL[$s]})"
    if [[ -n "${MKTS[$s]:-}" ]]; then
        n_mkts="$(awk -F, '{print NF}' <<<"${MKTS[$s]}")"
        extra="$extra +mkts($n_mkts)"
    fi
    if [[ -n "${PLUGINS[$s]:-}" ]]; then
        n_plugs="$(awk -F, '{print NF}' <<<"${PLUGINS[$s]}")"
        extra="$extra +plugins($n_plugs)"
    fi
    if [[ -n "${ACCOUNTS[$s]:-}" ]]; then
        n_accts="$(awk -F, '{print NF}' <<<"${ACCOUNTS[$s]}")"
        extra="$extra +accounts($n_accts)"
    fi
    printf '   %-22s -> claude-%-20s ssh :%-5s %s%s\n' "$nm" "$s" "${SVCPORT[$s]}" "$mark" "$extra"
done

echo
[[ -f "$AK" ]] || warn "authorized_keys not found at $AK: create it (your SSH pubkey) before 'up'"
[[ -f "$GK" ]] || warn "git deploy key not found at $GK: create it and add the .pub to ${ORG} before 'up'"
docker image inspect "$CLAUDE_IMAGE" >/dev/null 2>&1 || warn "image $CLAUDE_IMAGE not built yet: run 'make build'"
# Warn if --browser was used but the browser image isn't built/labeled.
if (( ${#BROWSER[@]} > 0 )); then
    img_browser="$(docker image inspect -f '{{ index .Config.Labels "claude.browser" }}' "$BROWSER_IMAGE" 2>/dev/null || true)"
    [[ "$img_browser" == "1" ]] || warn "image $BROWSER_IMAGE was not built with WITH_BROWSER=1: run 'make build-browser' before 'up' (--browser services won't get the chrome-devtools MCP otherwise)"
fi
# Same for --docker. Check the image each docker service will actually use: a service that
# is both --docker and --browser gets the combined image, and a missing engine there is a
# boot failure (the entrypoint dies on 'dockerd not in this image'), not a silent downgrade.
if (( ${#DOCKER[@]} > 0 )); then
    _need_combined=0
    for s in "${!DOCKER[@]}"; do [[ -n "${BROWSER[$s]:-}" ]] && _need_combined=1; done
    for img in "$DOCKER_IMAGE" $( ((_need_combined)) && echo "$DOCKER_BROWSER_IMAGE" ); do
        img_docker="$(docker image inspect -f '{{ index .Config.Labels "claude.docker" }}' "$img" 2>/dev/null || true)"
        [[ "$img_docker" == "1" ]] && continue
        if [[ "$img" == "$DOCKER_BROWSER_IMAGE" ]]; then
            warn "image $img was not built with WITH_DOCKER=1: run 'make build-docker-browser' before 'up' (a service that is both --docker and --browser needs the combined image)"
        else
            warn "image $img was not built with WITH_DOCKER=1: run 'make build-docker' before 'up' (--docker services will fail to boot otherwise)"
        fi
    done
    warn "--docker services can reach root INSIDE their own container (Sysbox keeps that off the host)."
    warn "  CLAUDE_BROKER_GIT_KEY and CLAUDE_EGRESS_LOCKDOWN do not bind on them: see docs/architecture.md."
fi

docker volume inspect "$AUTH_VOLUME" >/dev/null 2>&1 || warn "auth volume '$AUTH_VOLUME' missing: run 'make login'"
for avol in "${!ACCOUNT_VOLS[@]}"; do
    docker volume inspect "$avol" >/dev/null 2>&1 \
        || warn "account volume '$avol' missing: run 'claude-account-login ${avol#claude-auth-}' before 'up'"
done
# The shared volumes are external now, so a missing one is a hard 'up' failure.
for v in $SHARED_VOL_LIST; do
    docker volume inspect "$v" >/dev/null 2>&1 \
        || warn "shared volume '$v' missing: run 'docker volume create $v' before 'up' (it's external; empty is fine, it self-seeds)"
done
info "Validate:  docker compose -f $OUT config >/dev/null && echo OK"
