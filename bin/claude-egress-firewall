#!/usr/bin/env bash
# Default-deny egress firewall for the container's network namespace.
#
# Run by the entrypoint AS ROOT (before it drops to the non-root claude user)
# when CLAUDE_EGRESS_LOCKDOWN=1. Because the agent runs unprivileged without
# NET_ADMIN, it cannot alter these rules — egress enforcement lives outside the
# agent's reach, which is the property the security research demanded (app-layer
# / SNI allowlists are bypassable; an IP-pinned netfilter allowlist is not).
# Modeled on Anthropic's own .devcontainer/init-firewall.sh.
#
# FAIL-OPEN: rules are applied in one atomic `iptables-restore`. Either the whole
# default-deny ruleset commits, or the filter table is left untouched (egress
# stays open). Any earlier failure calls fail_open(). A misconfigured firewall
# never bricks a homelab's connectivity; it logs loudly and stays open.
#
# Allowlist = a baked default set (Claude API + OAuth + Remote Control feature
# flags + npm + GitHub) plus CLAUDE_EGRESS_EXTRA_HOSTS (space/comma separated).
# Allowed: 443/80/22 to allowlisted IPs, 53 (DNS) anywhere, loopback, established.
set -uo pipefail
[[ "${CLAUDE_EGRESS_DEBUG:-0}" == 1 ]] && set -x

log() { echo "[egress] $*" >&2; }   # diagnostics on stderr (like fail_open) — keeps stdout a clean data channel (e.g. the CLAUDE_EGRESS_PRINT_HOSTS host list)
fail_open() {
    log "ERROR: $* — failing OPEN (egress UNRESTRICTED). Fix and restart the container." >&2
    iptables -P OUTPUT ACCEPT 2>/dev/null || true
    exit 1
}

# NOTE: the `iptables`/`iptables-restore` availability check is deferred until AFTER the
# CLAUDE_EGRESS_PRINT_HOSTS dry-run seam below — the dry run is a pure host dump that needs neither
# binary, so it stays runnable on an iptables-less CI host (the enforcement path still refuses without
# them, see below).

# Default allowlist. Wildcards can't be IP-resolved, so we list the concrete
# hosts the CLI actually dials (the artifact viewer's *.claudeusercontent.com is
# browser-only and intentionally omitted). See the egress-allowlist memo.
DEFAULT_HOSTS="
api.anthropic.com claude.ai platform.claude.com downloads.claude.ai
bridge.claudeusercontent.com raw.githubusercontent.com objects.githubusercontent.com
storage.googleapis.com
statsig.anthropic.com statsig.com api.growthbook.io cdn.growthbook.io
us.sentry.io downloads.sentry-cdn.com
registry.npmjs.org
github.com api.github.com codeload.github.com
"
EXTRA="${CLAUDE_EGRESS_EXTRA_HOSTS:-}"; EXTRA="${EXTRA//,/ }"

# Opt-in package-registry profile (PKG-1). ADDITIVE to the default-deny base and IP-pinned exactly like
# every other host below — it only ever ADDS the curated registry hosts, never broadens egress by any
# other means, and does NOTHING unless CLAUDE_EGRESS_PACKAGES is explicitly on. This is a curated (not
# open) allowlist by design: the supply-chain exfil path this container refuses is *open* egress, so a
# tool whose registry isn't listed simply won't install until its host is added. Debian/apt mirrors are
# deliberately NOT here — those need the rootful Sysbox-worker apt tier (PKG-4), not a leaf container.
# See docs/package-provisioning-security.md for the threat model + containment rules.
PACKAGES_HOSTS=""
if [[ "${CLAUDE_EGRESS_PACKAGES:-0}" =~ ^(1|true|yes|on)$ ]]; then
    PACKAGES_HOSTS="
    pypi.org files.pythonhosted.org
    crates.io index.crates.io static.crates.io
    proxy.golang.org sum.golang.org
    mise.run
    ghcr.io
    "
    log "package-registry egress profile ON (PyPI, crates, Go proxy, mise, ghcr; curated + IP-pinned)"
fi

# Opt-in Debian-mirror profile (PKG-4). ADDITIVE + IP-pinned exactly like the package profile, but
# scoped to the rootful Sysbox-worker apt tier: `claude-apt-provision` sets CLAUDE_EGRESS_APT=1 and
# re-applies this firewall to OPEN the install window, then re-applies it WITHOUT the flag to RE-LOCK
# (install-then-relock). Deliberately NOT in the default or package profile — a leaf container never
# reaches the Debian mirrors; only the brokered, curated worker apt path opens them, and only for the
# window. Nothing broadens unless CLAUDE_EGRESS_APT is explicitly on. See
# docs/package-provisioning-security.md §4.
APT_HOSTS=""
if [[ "${CLAUDE_EGRESS_APT:-0}" =~ ^(1|true|yes|on)$ ]]; then
    APT_HOSTS="
    deb.debian.org security.debian.org
    "
    log "Debian-mirror egress profile ON (deb.debian.org, security.debian.org; apt install window, IP-pinned)"
fi

# Cache-proxy egress profile (PKG-6). When CLAUDE_CACHE_PROXY_HOST (or _URL) is set, this worker is in
# SINGLE-CHOKE-POINT mode: package egress goes through the controller-side pull-through cache
# (bin/claude-cache-proxy) and NOWHERE else. So the composed allowlist becomes the base infra hosts
# (Claude API/OAuth/GitHub/telemetry) MINUS the public npm registry, PLUS the proxy host — and the
# curated CLAUDE_EGRESS_PACKAGES / CLAUDE_EGRESS_APT public registries are DELIBERATELY NOT added
# (the proxy fronts them; adding them would defeat the "sole external fetcher" property).
#
# The proxy host is IP-pinned exactly like every other allowlist host, AND — critically — opened on the
# proxy's OWN port (default 8081, Nexus), not just 22/80/443: a pull-through cache on 8081 the firewall
# didn't punch through would be unreachable under lockdown, silently breaking the whole feature. The
# pinned host+port are derived from the SAME source `claude-cache-proxy` dials: CLAUDE_CACHE_PROXY_URL
# wins (host + port parsed from it — so a custom-URL proxy is pinned to the host it actually reaches, not
# the container-name default), else CLAUDE_CACHE_PROXY_HOST + CLAUDE_CACHE_PROXY_PORT. Direct-from-GitHub
# fetches (git clone, `github:`/`aqua:` mise, non-proxied `go get`) still use the GitHub allowlist — a
# documented, pinned, audited host, not the proxy (a known boundary of the choke point, not open egress).
# See docs/caching-proxy.md and docs/package-provisioning-security.md §3.8. Nothing here changes
# behaviour unless a proxy host/URL is explicitly set — the OFF path is byte-identical to before.
CACHE_PROXY_PIN_HOSTS=""   # the host(s) whose proxy PORT gets punched through (build_rules reads this)
CACHE_PROXY_PIN_PORT=""
if [[ -n "${CLAUDE_CACHE_PROXY_HOST:-}" || -n "${CLAUDE_CACHE_PROXY_URL:-}" ]]; then
    if [[ -n "${CLAUDE_CACHE_PROXY_URL:-}" ]]; then
        # Parse host + port from the URL (URL wins in claude-cache-proxy's cache_proxy_base_url too).
        _u="${CLAUDE_CACHE_PROXY_URL#*://}"; _hp="${_u%%/*}"
        CACHE_PROXY_PIN_HOSTS="${_hp%%:*}"
        if [[ "$_hp" == *:* ]]; then CACHE_PROXY_PIN_PORT="${_hp##*:}"
        elif [[ "$CLAUDE_CACHE_PROXY_URL" == https://* ]]; then CACHE_PROXY_PIN_PORT=443
        else CACHE_PROXY_PIN_PORT=80; fi
    else
        CACHE_PROXY_PIN_HOSTS="${CLAUDE_CACHE_PROXY_HOST//,/ }"
        CACHE_PROXY_PIN_PORT="${CLAUDE_CACHE_PROXY_PORT:-8081}"
    fi
    # Drop the public npm registry from the base set — the proxy is npm's egress now.
    BASE_NO_NPM=""
    for _h in $DEFAULT_HOSTS; do [[ "$_h" == "registry.npmjs.org" ]] && continue; BASE_NO_NPM="$BASE_NO_NPM $_h"; done
    HOSTS="$BASE_NO_NPM $EXTRA $CACHE_PROXY_PIN_HOSTS"
    if [[ -n "${PACKAGES_HOSTS// }" || -n "${APT_HOSTS// }" ]]; then
        log "cache-proxy egress profile ON — IGNORING CLAUDE_EGRESS_PACKAGES/CLAUDE_EGRESS_APT public registries; the proxy ($CACHE_PROXY_PIN_HOSTS:$CACHE_PROXY_PIN_PORT) is the SOLE registry egress (single choke point)"
    else
        log "cache-proxy egress profile ON — registries reachable ONLY via the proxy ($CACHE_PROXY_PIN_HOSTS:$CACHE_PROXY_PIN_PORT); public npm registry dropped (single choke point)"
    fi
else
    HOSTS="$DEFAULT_HOSTS $EXTRA $PACKAGES_HOSTS $APT_HOSTS"
fi

# Dry-run seam for CI/tests (CLAUDE_EGRESS_PRINT_HOSTS accepts the same 1|true|yes|on spellings as the
# package flag): print the composed allowlist hosts — one per line, IN THE ORDER the resolution loop
# below iterates them (a faithful witness of the enforcement input, not a sorted/deduped view) — and
# exit 0 BEFORE requiring iptables, so the host-SELECTION logic is verifiable with no NET_ADMIN and no
# iptables binary. Default off ⇒ behaviour byte-identical. (Unquoted $HOSTS word-splits, so blank/
# indented lines in the heredoc never become tokens — no filtering needed.)
if [[ "${CLAUDE_EGRESS_PRINT_HOSTS:-0}" =~ ^(1|true|yes|on)$ ]]; then
    printf '%s\n' $HOSTS
    exit 0
fi

# Parallel dry-run seam (PKG-6): print the resolved cache-proxy pin as `<host...> <port>` and exit
# BEFORE iptables, so the proxy-PORT punch-through logic (the bit that keeps a lockdown'd worker able
# to reach an 8081 proxy) is verifiable with no NET_ADMIN. Empty first line when proxy mode is off.
if [[ "${CLAUDE_EGRESS_PRINT_PROXY:-0}" =~ ^(1|true|yes|on)$ ]]; then
    printf '%s %s\n' "${CACHE_PROXY_PIN_HOSTS// /,}" "${CACHE_PROXY_PIN_PORT}"
    exit 0
fi

# Enforcement path only from here — now the iptables tooling is actually required.
command -v iptables         >/dev/null 2>&1 || fail_open "iptables not installed"
command -v iptables-restore >/dev/null 2>&1 || fail_open "iptables-restore not installed"

# Collect the allowed IPv4 nets (single IPs and CIDRs) while egress is still open.
declare -A SEEN=()
NETS=()
add_net() { [[ -n "$1" && -z "${SEEN[$1]:-}" ]] && { SEEN[$1]=1; NETS+=("$1"); }; }

# GitHub serves git/clone/raw from a large, published IP space — resolving a few
# hostnames misses codeload/objects mirrors. Pull the official ranges (best-
# effort; falls back to per-host resolution below).
if meta="$(curl -fsS --max-time 10 https://api.github.com/meta 2>/dev/null)"; then
    while IFS= read -r cidr; do add_net "$cidr"; done < <(
        echo "$meta" | jq -r '(.web // []) + (.api // []) + (.git // []) + (.packages // [])
                              | .[] | select(test(":")|not)' 2>/dev/null)
    log "added GitHub published IPv4 ranges from api.github.com/meta"
else
    log "WARNING: could not fetch api.github.com/meta — relying on per-host DNS for GitHub"
fi

# Resolve each allowlist host to its current IPv4s and pin them. Docker's
# embedded DNS can take ~5s per name on the AAAA path, so resolve all hosts in
# PARALLEL with a per-host timeout — total stays ~one lookup, not their sum, and
# no single slow/hung name blocks boot.
rdir="$(mktemp -d)"
for h in $HOSTS; do
    [[ -z "$h" ]] && continue
    ( timeout 6 getent ahostsv4 "$h" 2>/dev/null | awk '{print $1}' | sort -u > "$rdir/${h//\//_}" ) &
done
wait
for h in $HOSTS; do
    [[ -z "$h" ]] && continue
    ips="$(cat "$rdir/${h//\//_}" 2>/dev/null)"
    [[ -z "$ips" ]] && { log "WARNING: could not resolve $h (timeout/NXDOMAIN) — skipping"; continue; }
    for ip in $ips; do add_net "$ip"; done
done
rm -rf "$rdir"
(( ${#NETS[@]} > 0 )) || fail_open "allowlist resolved to zero IPs"
log "allowlist holds ${#NETS[@]} IPv4 nets from $(echo "$HOSTS" | wc -w) hosts"

# Cache-proxy port punch-through (PKG-6): the proxy listens on its OWN port (default 8081), not
# 22/80/443, so resolve the pinned proxy host(s) to IPs and open exactly that port to exactly those
# IPs. Without this a lockdown'd proxy-mode worker could not reach its own proxy — the feature would
# silently break at first fetch. Only when the port is NOT already in the base 22/80/443 punch (an
# https proxy on 443 needs no extra rule). Resolution is best-effort/fail-safe: an unresolvable proxy
# host warns and adds no rule (the worker then can't reach the proxy and its fail-closed client-apply
# refuses — never a silent open-egress fallback).
PROXY_NETS=()
if [[ -n "${CACHE_PROXY_PIN_PORT}" && ! ",22,80,443," == *",${CACHE_PROXY_PIN_PORT},"* ]]; then
    for h in $CACHE_PROXY_PIN_HOSTS; do
        [[ -z "$h" ]] && continue
        pips="$(timeout 6 getent ahostsv4 "$h" 2>/dev/null | awk '{print $1}' | sort -u)"
        [[ -z "$pips" ]] && { log "WARNING: could not resolve cache-proxy host $h — its port ${CACHE_PROXY_PIN_PORT} is NOT opened (worker will fail-closed on the proxy)"; continue; }
        for ip in $pips; do PROXY_NETS+=("$ip"); done
    done
    (( ${#PROXY_NETS[@]} > 0 )) && log "cache-proxy port punch-through: ${#PROXY_NETS[@]} IP(s) opened on tcp/${CACHE_PROXY_PIN_PORT}"
fi

# Build the filter-table ruleset and apply it atomically. INPUT stays ACCEPT
# (inbound SSH; replies ride conntrack), OUTPUT defaults to DROP with the
# allowlist punched through on 22/80/443 (+ the cache-proxy port for the proxy IPs).
# $1=1 includes a rate-limited LOG of drops (needs the LOG target; we retry without it if unavailable).
build_rules() {
    echo "*filter"
    echo ":INPUT ACCEPT [0:0]"
    echo ":FORWARD ACCEPT [0:0]"
    echo ":OUTPUT DROP [0:0]"
    echo "-A OUTPUT -o lo -j ACCEPT"
    echo "-A OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT"
    echo "-A OUTPUT -p udp --dport 53 -j ACCEPT"
    echo "-A OUTPUT -p tcp --dport 53 -j ACCEPT"
    local net
    for net in "${NETS[@]}"; do
        echo "-A OUTPUT -p tcp -d $net -m multiport --dports 22,80,443 -j ACCEPT"
    done
    # Cache-proxy port: open ONLY the proxy IPs on ONLY the proxy port (a narrow, specific hole).
    for net in "${PROXY_NETS[@]}"; do
        echo "-A OUTPUT -p tcp -d $net --dport ${CACHE_PROXY_PIN_PORT} -j ACCEPT"
    done
    [[ "${1:-0}" == 1 ]] && echo '-A OUTPUT -m limit --limit 5/min -j LOG --log-prefix "[egress-drop] "'
    echo "COMMIT"
}

if   build_rules 1 | iptables-restore 2>/dev/null; then :
elif build_rules 0 | iptables-restore 2>/dev/null; then log "applied without drop-logging (LOG target unavailable)"
else fail_open "iptables-restore failed to apply the ruleset"
fi

# Confirm the policy actually flipped (atomic restore should guarantee it).
[[ "$(iptables -S OUTPUT 2>/dev/null | head -1)" == "-P OUTPUT DROP" ]] \
    || fail_open "default-deny policy not in effect after restore"

log "default-deny egress active (allow: loopback, established, DNS, + ${#NETS[@]} pinned nets on 22/80/443)"
