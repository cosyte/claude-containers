# Copy to .env and edit. The launcher scripts auto-source .env, and
# `claude-launch` passes the whole file into each container with --env-file.
# Precedence (weakest first): ambient env < this base .env < a scenario env
# (CLAUDE_ENV_FILE) < CLI flags. (Because the scripts `set -a; source .env`, a
# bare VAR= here overrides the ambient environment — it is NOT the other way.)
#
# Do NOT quote values. This file is read two ways — bash `source` (strips
# quotes) and `docker --env-file` (keeps them literal) — so a quoted value
# like CLAUDE_DEV_CMD="npm run dev" would reach the container with the quotes
# still attached and break. Write values bare; embedded spaces are fine.
#
# ── Per-stack / scenario env (CLAUDE_ENV_FILE) ───────────────────────────────
# Running more than one compose STACK on a host (e.g. an org stack and a
# personal stack) usually means a different GH_TOKEN and a disjoint SSH port
# range per stack. Keep this base .env for the SHARED settings, and give each
# stack its own small override .env holding only what differs. `_common.sh`
# sources CLAUDE_ENV_FILE on top of this base; claude-compose-gen sets it from
# --scenario/--env-file, and `docker compose up` auto-loads the SAME file when
# it sits beside the compose. A set-but-missing CLAUDE_ENV_FILE fails closed.
# A per-stack override .env typically contains just:
#     GH_TOKEN=…                     # this stack's enumeration/HTTPS token
#     SSH_PORT_RANGE_START=2250      # disjoint from the other stack's range
#     SSH_PORT_RANGE_END=2299
#     # optional: CLAUDE_IMAGE / CLAUDE_MODEL / CLAUDE_MEM_LIMIT overrides

# ──────────────────────────────────────────────────────────────────────────
# Image / build
# ──────────────────────────────────────────────────────────────────────────
CLAUDE_IMAGE=claude-code-box:latest
# Controller image (CC-6): the WITH_DOCKER=1 variant baking the Docker engine, so it
# can run an inner dockerd and spawn nested workers under Sysbox. claude-launch
# auto-selects it for --broker. Build once: make build-controller.
CLAUDE_IMAGE_CONTROLLER=claude-code-box:controller
# Pinned Claude Code npm version. Minimum 2.1.52 for Remote Control;
# 2.1.145 is verified for --remote-control + bypassPermissions together.
CLAUDE_CODE_VERSION=2.1.145
NODE_VERSION=24
# Pin a real uv version (e.g. 0.8.4) for reproducible builds; latest = newest.
UV_VERSION=latest
# Pin a real pnpm version (e.g. 10.4.1) for reproducible builds; latest = newest.
PNPM_VERSION=latest
# Container user. Match these to the host owner of bind-mounted workspaces.
CLAUDE_UID=1000
CLAUDE_GID=1000
CLAUDE_USER=claude
# Build the frontend-debugging variant: 1 bakes headless Chromium + the
# official chrome-devtools-mcp server (adds ~200 MB to the image). Off by
# default. `make build-browser` flips this and tags claude-code-box:browser.
WITH_BROWSER=0
# Build the CONTROLLER variant: 1 bakes the Docker engine (dockerd + CLI +
# containerd, ~400 MB) so the image can run an inner dockerd and spawn nested
# workers under Sysbox (CC-6 / `claude-launch --broker`). Off by default.
# `make build-controller` flips this and tags claude-code-box:controller.
WITH_DOCKER=0

# ──────────────────────────────────────────────────────────────────────────
# Claude Code runtime
# ──────────────────────────────────────────────────────────────────────────
# Model the session runs. Defaults to the best available model: the `opus` alias
# always resolves to the latest Opus, so the fleet tracks the strongest model with
# no code change. Override with any Claude Code alias (opus, sonnet, haiku,
# opusplan, default) or a full id like claude-opus-4-8. `default` defers to Claude
# Code's own pick. Per-container via `claude-launch --model`; per-repo in the
# compose generator via `claude-compose-gen --model REPO=MODEL`. Honored by both
# the interactive session and autopilot.
CLAUDE_MODEL=opus
# default | acceptEdits | plan | bypassPermissions  (bypassPermissions = full
# autonomy, the historical default for unattended use). At fleet scale against
# real repos, acceptEdits (auto-approves in-project edits, still gates shell/
# network) is the safer posture; on a CLI build that supports it, `auto` uses the
# permission classifier. Honored by both the interactive session and autopilot.
CLAUDE_PERMISSION_MODE=bypassPermissions
# Secret guard: 1 (default) installs a fleet-wide git pre-commit hook that blocks
# committing obvious secrets (.env, *.pem, *.key, id_rsa, PRIVATE KEY blocks, …)
# — the agent commits/pushes autonomously with a mounted key. 0 disables it.
# Bypass a single commit with `git commit --no-verify`. Add globs via
# CLAUDE_SECRET_GUARD_EXTRA (space-separated, matched on the file basename).
CLAUDE_SECRET_GUARD=1
# CLAUDE_SECRET_GUARD_EXTRA="*.p8 my-secret.*"
# ── Fleet observability (OpenTelemetry) ───────────────────────────────────
# Opt-in: export Claude Code's per-call cost/token telemetry to any OTLP backend
# (Langfuse, an OTel collector, Grafana, …) so the fleet's spend is visible per
# container. Enabled by CLAUDE_OTEL_ENABLED=1 or simply by setting an endpoint.
# Each container is tagged service.instance.id=<project>,claude.project=<project>
# (Claude Code's service.name is fixed to "claude-code"); append your own with
# OTEL_RESOURCE_ATTRIBUTES. The auth header stays in process env, never on disk.
CLAUDE_OTEL_ENABLED=0
# CLAUDE_OTEL_TRACES=0                 # 1 also exports traces (Claude Code beta) — needed by trace backends like Langfuse
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
#   Langfuse: https://<host>/api/public/otel   (HTTP only — keep protocol http/protobuf)
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf     # or grpc / http/json
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(public:secret)>   # Langfuse keys
# OTEL_RESOURCE_ATTRIBUTES=team=platform,env=prod                          # extra tags
# Extra args appended to the `claude` invocation (also via --extra-args).
CLAUDE_EXTRA_ARGS=
# Comma-separated baked-in MCP servers to load (empty = all). Also --mcp.
CLAUDE_MCP_ENABLED=
# Runtime plugin injection — no image rebuild required. Also --marketplace/--plugin.
# CLAUDE_EXTRA_MARKETPLACES: comma-separated name=url pairs (git source, autoUpdate=true)
#   Example: CLAUDE_EXTRA_MARKETPLACES=claude-skills=git@github.com:cosyte/claude-marketplace.git
# CLAUDE_EXTRA_PLUGINS: comma-separated plugin@marketplace entries to enable
#   Example: CLAUDE_EXTRA_PLUGINS=software-engineering@claude-skills,data@claude-skills
CLAUDE_EXTRA_MARKETPLACES=
CLAUDE_EXTRA_PLUGINS=
# Optional: command auto-started on boot in a dedicated tmux 'dev' window
# (e.g. a dev server). Bind to 0.0.0.0 so a published port reaches it. The
# compose generator sets this per-repo via --dev-cmd REPO=COMMAND.
# Example: CLAUDE_DEV_CMD=npm run dev -- --host 0.0.0.0 --port 4321
CLAUDE_DEV_CMD=
# ── Unattended autopilot ──────────────────────────────────────────────────
# 1 switches this container from an interactive Remote Control session to a
# headless Claude loop in tmux window 'main' (no Remote Control; SSH still
# attaches to watch it). Default 0 = interactive. Both modes are options.
CLAUDE_AUTOPILOT=0
# What the loop runs each cycle. Default /next (cosyte cockpit: one unit of
# continuous build-out per run, state read from disk). Point the workspace at
# the repo whose command this is. Example: CLAUDE_AUTOPILOT_CMD=/next
CLAUDE_AUTOPILOT_CMD=/next
# Seconds between successful runs. Mind your Max plan's 5h/weekly windows —
# too tight a cadence exhausts the quota. Default 3600 (1h).
CLAUDE_AUTOPILOT_INTERVAL=3600
# Stop after N runs (0 = unlimited). On failure the loop backs off
# exponentially up to CLAUDE_AUTOPILOT_BACKOFF_MAX seconds (default 21600 = 6h).
CLAUDE_AUTOPILOT_MAX_RUNS=0
# On a rate/usage-limit failure the loop now parses the reset time (from the run
# output or a reset epoch in the JSON) and sleeps until then; backoff is the
# fallback when no reset time is found. Each run also logs its total_cost_usd so
# the shared subscription's spend is attributable per container.
# CLAUDE_AUTOPILOT_BACKOFF_MAX=21600
# Where per-run JSON logs are written (inside the per-container config volume).
# CLAUDE_AUTOPILOT_LOG_DIR=
# 1 = carry the exact conversation forward each cycle via --resume <session_id>
# (saved per container) instead of a fresh session. Default 0 keeps the original
# fresh-session model, which suits session-independent commands like /next that
# recover their state from disk. Use 1 for a stateful long-running task.
CLAUDE_AUTOPILOT_RESUME=0
# Durable task queue (opt-in): 1 makes the autopilot claim prompt files from a
# queue dir (oldest/highest-priority first), run each as a one-shot task, and
# file it under done/ or failed/. When the queue is empty it falls back to
# CLAUDE_AUTOPILOT_CMD (/next) on the interval. Enqueue with `claude-enqueue`
# (over SSH) or by dropping a file into <dir>/pending/. Queue beats a blind timer
# for fleet work; the dirs live on the config volume so they survive restarts.
CLAUDE_AUTOPILOT_QUEUE=0
# CLAUDE_AUTOPILOT_QUEUE_DIR=        # default ~/.claude/autopilot-queue
# CLAUDE_AUTOPILOT_QUEUE_DELAY=10    # seconds between queued tasks while draining
# SCM observer (opt-in, the event-driven half of the queue): 1 polls the
# workspace repo's open PRs via `gh` and routes CI failures, change requests, and
# merge conflicts into the queue above — so the container reacts to repo events,
# not just a clock. Pair with CLAUDE_AUTOPILOT=1 + CLAUDE_AUTOPILOT_QUEUE=1 to
# consume what it observes. Needs a GitHub remote and (for private repos) GH_TOKEN.
CLAUDE_SCM_OBSERVER=0
# CLAUDE_SCM_INTERVAL=300            # seconds between polls
# CLAUDE_SCM_EVENTS=ci,review,conflict   # which signals to route (csv subset)
# CLAUDE_SCM_PR_FILTER=             # extra `gh pr list` args, e.g. --author @me
# CLAUDE_SCM_PR_LIMIT=50            # max PRs scanned per poll
# CLAUDE_SCM_PRIORITY=40            # enqueue priority (lower runs sooner)
# Remote Control watchdog: 1 (default) auto-recovers a session whose Remote
# Control bridge has failed terminally — the link goes dark while the local
# process keeps running. (Transient network drops self-heal on their own and
# need no watchdog.) It detects the terminal give-up in the RC debug log and
# relaunches with --continue. 0 disables it. Tune with CLAUDE_RC_CHECK_INTERVAL
# / _IDLE_SECONDS / _COOLDOWN (seconds). See docs/troubleshooting.md.
CLAUDE_RC_WATCHDOG=1
# Frontend debugging: set to 1 to register the chrome-devtools MCP server in
# this container (Claude gets navigate / evaluate / screenshot / console /
# network / Lighthouse / perf-trace tools against any frontend the session
# runs). Requires an image built with WITH_BROWSER=1. The launcher also
# accepts --browser, and the compose generator accepts --browser REPO.
CLAUDE_BROWSER=0

# DO NOT SET THIS. The entrypoint hard-fails if ANTHROPIC_API_KEY is non-empty,
# to stop accidental per-token API billing overriding your subscription.
# ANTHROPIC_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Git
# ──────────────────────────────────────────────────────────────────────────
# Set per-launch with --repo/--branch/--workspace; these are fallbacks.
GIT_REPO_URL=
GIT_REPO_BRANCH=
GIT_REPO_DEPTH=
# Identity for commits. If unset, claude-launch copies the host's
# `git config --global user.name/email`.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=
# Host path to the SSH key used for git pushes (mounted read-only).
GIT_SSH_KEY=~/.ssh/claude-git-key
# GitHub PAT, exposed as GH_TOKEN in every container. When set, the `gh` CLI
# is pre-authenticated and the entrypoint wires gh in as git's credential
# helper, so HTTPS clone/push to github.com use the token. SSH remotes keep
# using GIT_SSH_KEY above — either transport works. Reaches all session
# containers, so use a fine-grained token scoped to only the repos and
# permissions you need.
# GH_TOKEN=

# ──────────────────────────────────────────────────────────────────────────
# SSH access
# ──────────────────────────────────────────────────────────────────────────
# Host file with the public keys allowed to SSH in (mounted read-only).
SSH_AUTHORIZED_KEYS=~/.ssh/authorized_keys
# Auto-assigned port range (per-container). Override one with --port.
SSH_PORT_RANGE_START=2200
SSH_PORT_RANGE_END=2299
# Hostname printed in the SSH connect line (defaults to this machine's name).
# CLAUDE_SSH_HOST=homelab.local
# Bind the published SSH port to one host interface instead of all of them.
# Empty = published on 0.0.0.0 (LAN-reachable). 127.0.0.1 = host-only.
CLAUDE_SSH_BIND=

# ──────────────────────────────────────────────────────────────────────────
# Resource limits / runtime
# ──────────────────────────────────────────────────────────────────────────
CLAUDE_CPU_LIMIT=2
CLAUDE_MEM_LIMIT=4g
CLAUDE_SHM_SIZE=2g
# Soft memory floor + fork-bomb guard on every session container (CC-3). On the
# script paths (claude-launch / claude-compose-gen) the reservation defaults to
# 75% of CLAUDE_MEM_LIMIT (4g → 3072m) so a limit override can never invert
# reservation > limit; the static docker-compose.yml can't derive, so there it
# is opt-in (default 0 = disabled — keep any explicit value below the limit).
# Note the pids limit counts THREADS too: a heavy session (browser image with
# headless Chrome + dev servers + parallel builds) may want it raised.
# CLAUDE_MEM_RESERVATION=3g
# CLAUDE_PIDS_LIMIT=2048
CLAUDE_STOP_TIMEOUT=20
# Escape hardening: each container runs with --security-opt no-new-privileges and
# (when CLAUDE_HARDEN_CAPS=1, the default) drops ALL Linux capabilities then re-
# adds only the minimal set needed for sshd + privilege-dropping — removing the
# Docker defaults NET_RAW, MKNOD, SETFCAP. Set 0 if a workload needs more caps,
# or override the list with CLAUDE_MIN_CAPS. NOTE: this shrinks blast radius but a
# container is NOT a security boundary against a fully weaponized agent — the
# single highest-leverage control is a patched host runtime: the launcher warns
# if the host runC is older than 1.2.8 / 1.3.3 (CVE-2025-31133/52565/52881).
CLAUDE_HARDEN_CAPS=1
# CLAUDE_MIN_CAPS="CHOWN DAC_OVERRIDE FOWNER FSETID KILL SETGID SETUID SETPCAP NET_BIND_SERVICE SYS_CHROOT AUDIT_WRITE"
# Egress lockdown (opt-in): 1 applies a default-deny network firewall (iptables,
# IP-pinned allowlist) inside the container at boot, BEFORE the agent starts and
# while it's still unprivileged — so a prompt-injected agent can't exfiltrate to
# arbitrary hosts and can't disable its own egress rules (app-layer/SNI
# allowlists are bypassable; this is enforced in netfilter). The allowlist covers
# the Claude API + OAuth + Remote Control feature flags + npm + GitHub; add your
# own (private registries, custom MCP) via CLAUDE_EGRESS_EXTRA_HOSTS. Adds ~10s
# to boot (DNS resolution) and the NET_ADMIN cap. FAIL-OPEN: if setup fails it
# leaves egress unrestricted and logs loudly rather than bricking connectivity.
CLAUDE_EGRESS_LOCKDOWN=0
# CLAUDE_EGRESS_EXTRA_HOSTS="registry.mycorp.com mcp.internal"   # space/comma separated
# Curated worker apt (PKG-4, opt-in): 1 makes a Sysbox WORKER install the curated,
# pinned manifest at claude-config/apt-manifest.txt as root before the agent starts
# — the system-library (.so) gap rootless `mise` can't fill. It self-gates on
# host-safe worker root (root → non-root host uid), so it's a logged no-op on a leaf
# container (which gets the documented "no root — use mise/static binaries" refusal);
# only packages in the manifest install (arbitrary agent-driven apt is refused); it
# opens deb.debian.org for the install window (needs CLAUDE_EGRESS_LOCKDOWN=1 for the
# scoped window) then RE-LOCKS. Default manifest is empty. See
# docs/package-provisioning-security.md §3.7.
CLAUDE_APT_PROVISION=0
# CLAUDE_APT_MANIFEST_FILE=/opt/claude-config/apt-manifest.txt   # override the manifest path (must resolve INSIDE the worker; not forwarded from a broker host)
# Git-key brokering (opt-in): 1 loads the mounted SSH deploy key into a ROOT-owned
# ssh-agent and exposes only a signing socket to the agent (via a root socat
# relay). git can push/pull with the key, but the unprivileged — and prompt-
# injectable — agent can never read the private key bytes (not from a file, the
# agent protocol, the socket, or root's memory), so it can't be exfiltrated.
# Default 0 keeps the historical readable key file at ~/.ssh/id_ed25519.
# The shared claude-auth credential MASTER is always locked to root regardless;
# the agent only ever reaches its own per-container session token (unavoidable —
# Claude Code authenticates with it; there is no API key to scope).
CLAUDE_BROKER_GIT_KEY=0

# ──────────────────────────────────────────────────────────────────────────
# Worker broker — controller mode (CC-2; parallel-worker tier, umbrella ADR 0011)
# ──────────────────────────────────────────────────────────────────────────
# CLAUDE_WORKER_BROKER=1 starts a ROOT-owned broker at boot: on a controller (a
# Sysbox container running an inner dockerd) it is the ONLY principal that may
# launch nested worker containers. The unprivileged agent never touches the inner
# Docker socket — it *requests* a launch via `claude-worker-request <repo> <item>`
# (a narrow spool channel; exactly two sanitized values, no flags, no template
# override) and the broker applies a FIXED hardened template: cap-drop ALL + the
# minimal cap set (NET_RAW/MKNOD/SETFCAP stay dropped), no-new-privileges,
# per-worker memory/reservation/cpus/pids/shm caps, secret-guard + egress
# inheritance. FAILS CLOSED unless userns containment is real (/proc/self/uid_map)
# AND the host attested a CVE-patched Sysbox in CLAUDE_SYSBOX_ATTESTED_VERSION
# (the host launch path runs preflight_sysbox and passes SYSBOX_VERSION in — a
# pre-v0.7.0 attestation is refused, CVE-2025-31133/52565/52881).
#
# On the CONTROLLER image (WITH_DOCKER=1), the entrypoint (§5a) starts the INNER
# dockerd before the broker whenever CLAUDE_WORKER_BROKER=1, and fails closed if the
# image has no dockerd. The easiest way to run a broker is `claude-launch --broker`
# (implies --sysbox, auto-selects the controller image, sizes for Σ(K workers)).
CLAUDE_WORKER_BROKER=0
# Seconds the entrypoint (§5a) waits for the inner dockerd to become ready before
# refusing to start (fail closed). Only relevant when CLAUDE_WORKER_BROKER=1.
# CLAUDE_INNER_DOCKERD_WAIT=60
# CLAUDE_SYSBOX_ATTESTED_VERSION=        # set by the host launch path, not by hand
# CLAUDE_BROKER_MAX_WORKERS=             # live-worker cap; defaults to K resolved from
#                                        # the umbrella operations/parallel.config.json
#                                        # (ONE source of truth — never fork K here; the
#                                        # host launch path passes it in when the config
#                                        # isn't visible from inside the controller)
# CLAUDE_PARALLEL_CONFIG=                # explicit path to that config (else auto-found
#                                        # at ../operations/ or /workspace/operations/)
# CLAUDE_WORKER_IMAGE=claude-code-box:latest
# Per-worker resource profile (roadmap §5 starting numbers, single-sourced in
# bin/_common.sh; the broker template, the controller envelope, and the verify
# scripts all read these). The controller envelope is Σ(K·profile) + overhead —
# `claude-controller-size` prints/checks it (K=2 → 5 CPUs / 10240m / 5120 pids),
# and the broker REFUSES to serve in a controller whose own cgroup budget can't
# carry its worker cap (never silently overcommit).
# CLAUDE_WORKER_MEM=4g
# CLAUDE_WORKER_MEM_RESERVATION=3g
# CLAUDE_WORKER_CPUS=2
# CLAUDE_WORKER_PIDS=2048
# CLAUDE_WORKER_SHM=2g
# Controller overhead on top of Σ(K workers) — inner dockerd + broker + slack:
# CLAUDE_CTRL_CPU_OVERHEAD=1
# CLAUDE_CTRL_MEM_OVERHEAD_MIB=2048
# CLAUDE_CTRL_PIDS_OVERHEAD=1024

# ──────────────────────────────────────────────────────────────────────────
# Controller mode (CC-6; wires the substrate above to the umbrella PAR-* lease/
# scheduler/bump-worker control plane)
# ──────────────────────────────────────────────────────────────────────────
# CLAUDE_CONTROLLER=1 runs bin/claude-controller as the main tmux pane instead of
# claude-session/claude-autopilot. It IMPLIES CLAUDE_WORKER_BROKER=1 (refuses at
# boot if that is explicitly set to 0) — the controller cannot dispatch anything
# without a live broker. Effective worker slots = min(K, CLAUDE_CONTROLLER_MAX_SLOTS);
# MAX_SLOTS defaults to 1 REGARDLESS of K, which collapses the controller to
# EXACTLY today's autopilot launch (byte-identical — see docs/substrate.md). Only
# raise it once the umbrella's PAR-4.1 (per-item bump-queue scoping) has landed —
# the ramp itself is the umbrella's PAR-7.1 founder gate, not a flip here.
CLAUDE_CONTROLLER=0
# CLAUDE_CONTROLLER_MAX_SLOTS=1          # ceiling on worker slots; NEVER auto-ramps with K
# CLAUDE_CONTROLLER_UMBRELLA=            # umbrella root override (default: /workspace if
#                                        # it has .gitmodules + scripts/reconcile.sh)
# CLAUDE_CONTROLLER_INTERVAL=60          # seconds between dispatch cycles (slots>1 loop)
# CLAUDE_BROKER_SOCKET_LOCKDOWN_WAIT=90  # seconds the entrypoint blocks whenever the broker
#                                        # is backgrounded (CLAUDE_WORKER_BROKER=1 — controller
#                                        # mode OR an interactive `claude-launch --broker`
#                                        # session) for the inner docker socket to be confirmed
#                                        # root:root 600 before the agent's tmux session starts
#                                        # (the CC-6 ordering fix). Legacy alias:
#                                        # CLAUDE_CONTROLLER_SOCKET_WAIT

# ──────────────────────────────────────────────────────────────────────────
# Shared volume names (rarely changed)
# ──────────────────────────────────────────────────────────────────────────
AUTH_VOLUME=claude-auth
SSHKEYS_VOLUME=claude-sshkeys

# ──────────────────────────────────────────────────────────────────────────
# Shared tool cache (PKG-3) — one /cache volume reused across restarts + workers
# ──────────────────────────────────────────────────────────────────────────
# mise's install store + the cargo/go/npm/uv/pip caches live on ONE shared docker
# volume mounted at /cache, so a toolchain/CLI provisioned once is a cache hit for
# the next launch and for parallel workers. claude-launch mounts it by default;
# --no-cache (or --cache off) opts out → per-container installs (fail-safe: a
# missing cache never errors a launch). See docs/shared-tool-cache.md.
# CLAUDE_CACHE_VOLUME=claude-cache   # shared cache volume name; ""/off disables it
# CLAUDE_CACHE_MAX_MIB=20480         # claude-disk-gc trims re-fetchable caches above this
#                                    # (installed toolchains kept; idle-only; fail-safe)

# ──────────────────────────────────────────────────────────────────────────
# Reproducible manifests + install-script hardening (PKG-5) — no env knobs
# ──────────────────────────────────────────────────────────────────────────
# Baked into the image, not tunable via env:
#   - Agent npm/pnpm installs run with ignore-scripts=true (claude user's ~/.npmrc).
#     A repo that needs install scripts opts back in with its own /workspace/.npmrc
#     (ignore-scripts=false) — a project .npmrc overrides the user one.
#   - mise lockfile=true (global mise config): a committed /workspace/mise.lock
#     reinstalls identical tool versions offline from the shared cache.
#   - claude-deps-check [--strict] [path]: advisory linter flagging latest/unpinned
#     specs in mise.toml / package.json (--strict refuses; default warns, exit 0).
# See docs/package-provisioning-security.md §3.2/§3.6 + docs/toolchain-provisioning.md.

# ──────────────────────────────────────────────────────────────────────────
# Runtime secrets for baked-in MCP servers (examples; uncomment as needed)
# ──────────────────────────────────────────────────────────────────────────
# ROVO_MCP_TOKEN=
# EXAMPLE_API_KEY=
