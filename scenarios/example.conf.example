# ── claude-compose-gen scenario file ─────────────────────────────────────────
# A scenario .conf is just the generator's own flags, PERSISTED — one
# "--flag [value]" per line — so a fleet's exact repo list + per-repo config
# lives in a file instead of a fragile one-off command line. Run it with:
#
#     claude-compose-gen --scenario /path/to/this.conf
#
# Flags from the file are applied FIRST; any CLI flags after --scenario override
# a scalar (--out/--org/--port-base/…) or append to a repeatable (--active/
# --expose/…). See `claude-compose-gen --help` for every flag.
#
# Format rules:
#   • one flag per line; the value is the LITERAL rest of the line after the
#     first whitespace — so values with spaces, ';', '$' or '=' need NO quoting
#     (see the --dev-cmd line below);
#   • lines whose first non-blank char is '#' are comments; blank lines skipped;
#   • an inline '#' is NOT a comment (URLs and dev-cmds may contain one);
#   • boolean flags (e.g. --forks) sit on a line by themselves.
#
# WHERE THESE LIVE: scenario files are DEPLOYMENT config, like the compose they
# produce — keep them OUTSIDE this repo, next to their stack's compose + .env
# (e.g. /opt/homelab/claude/<stack>/<stack>.conf). --scenario takes a path;
# a bare name only resolves when CLAUDE_SCENARIOS_DIR is exported.
#
# This example shows the "cosyte org" stack of a two-stack host (the personal
# stack is a second .conf with its own --out, --env-file and 2250-range ports).
# ─────────────────────────────────────────────────────────────────────────────

# Per-stack env: sourced ON TOP of the repo .env at generation time (port range,
# image, resources) AND — because it sits beside --out — auto-loaded by
# `docker compose up` (so GH_TOKEN differs per stack). Point both at one file.
--env-file /opt/homelab/claude/cosyte/.env
--out /opt/homelab/claude/cosyte/docker-compose.yml

# First SSH host port for NEW repos (existing repos keep their port; a disjoint
# range per stack keeps two stacks from colliding — personal uses 2250+).
--port-base 2200

# Which services start on a plain `up -d`; the rest sit behind the dormant
# profile (defined, zero resources). Omit to start all.
--active knowledgebase

# Frontend stack: browser image + a published dev port + an auto-started dev
# server. The --dev-cmd value is copied verbatim (note the spaces/;/$/--).
--browser website
--expose website:4322:4321
--cpu website=4
--dev-cmd website=if [ -f pnpm-lock.yaml ]; then PM=pnpm;SEP=; elif [ -f yarn.lock ]; then PM=yarn;SEP=; else PM=npm;SEP=--; fi; [ -d node_modules ] || $PM install; exec $PM run dev $SEP --host 0.0.0.0 --port 4321

# Runtime plugins on one repo (no rebuild). --marketplace REPO=NAME=URL then
# --plugin REPO=PLUGIN@NAME[,…].
--marketplace knowledgebase=crew=git@github.com:cosyte/crew.git
--plugin knowledgebase=software-engineering@crew,devops-platform@crew

# The repos. Owner-qualified (owner/repo[:branch]) so gh enumeration is not
# needed and only these exact repos are emitted. Bare names would need --org.
cosyte/website
cosyte/knowledgebase
cosyte/hl7
